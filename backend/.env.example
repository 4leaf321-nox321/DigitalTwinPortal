# Flask Configuration
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=your-secret-key-change-in-production

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# CORS Configuration (쉼표로 구분, 공백 없이)
# 오프라인 환경의 실제 IP로 변경하세요 (예: http://192.168.1.100:5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dxdigitaltwin

# Test Database
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dxdigitaltwin_test

# ── 디지털 트윈 V2(dt2_*) 쓰기 스위치 ───────────────────────────────────────
# 컷오버 전에는 반드시 비워두거나 false. V1(dashboard_data)이 정본이고,
# 저장할 때마다 dt2_* 가 V1 기준으로 동기화된다.
#
# true 로 바꾸고 재기동하면 컷오버 상태가 된다:
#   · V2 쓰기 API 가 열린다
#   · V1→V2 동기화가 자동으로 멈춘다 (둘은 상호배타 — 코드가 강제)
# 되돌리려면 이 값을 지우고 재기동하면 된다.
DT2_WRITE_ENABLED=false

# ── AI 에이전트 (Phase 5) ────────────────────────────────────────────────
#
# 비워 두면 **에이전트 기능만 꺼진다**(503). 나머지는 그대로 동작한다 —
# 엉뚱한 주소로 조용히 붙는 것보다 안 켜지는 게 낫다. 그래서 기본값을 두지 않는다.
#
# ⚠️ **`/v1` 까지 적는다.** 어댑터가 뒤에 `/chat/completions` 만 붙인다.
#
#   운영   GPU 서버의 GLM-5.2 주소       예: http://10.x.x.x:10000/v1
#   개발   스텁을 띄우고 그쪽을 가리킨다  python scripts\llm_stub.py
#                                        LLM_BASE_URL=http://localhost:9001/v1
#
# ⚠️ **압축 반입 때 이 값이 같이 간다.** 개발 스텁 주소가 그대로 운영에 들어가면
#    운영에서 AI 가 스텁을 부르게 된다(닿지도 않아 503). 반출 전에 반드시 확인할 것.
LLM_BASE_URL=
LLM_MODEL=GLM-5-2
# LLM_API_KEY=
# LLM_TIMEOUT=120
# GLM reasoning 옵션(서버 chat_template 으로 전달). 비우면 안 보낸다.
# LLM_REASONING_EFFORT=

# 에이전트가 도구를 실행할 때 부를 **자기 자신의** 주소. 백엔드 포트와 같아야 한다.
# (판단을 복제하지 않으려고 MCP 와 똑같이 REST 로 부른다)
LLM_AGENT_API_BASE=http://127.0.0.1:5174
