    strong {
      font-weight: 600;
      color: #1e293b;
    }
    
    small {
      font-size: 0.875rem;
      opacity: 0.8;
      margin-top: 0.5rem;
      display: block;
    }
  }
  
  .progress-bar {
    width: 200px;
    height: 4px;
    background: #e2e8f0;
