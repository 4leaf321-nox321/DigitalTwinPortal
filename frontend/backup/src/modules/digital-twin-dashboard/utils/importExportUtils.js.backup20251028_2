import React, { useState, useRef } from 'react';
import { X, Upload, AlertTriangle, CheckCircle, FileText, Info, Database, BarChart3 } from 'lucide-react';
import { 
  importProjectsFromJSON, 
  importProjectsFromCSV,
  validateFileSize, 
  validateFileType, 
  mergeProjects,
  mergePerformances,
  generateColumnMapping
} from '../../utils/importExportUtils';

const ImportDataModal = ({ 
  isOpen, 
  onClose, 
  onImport,
  existingProjects = [],
  existingPerformances = []
}) => {
  const [selectedFile, setSelectedFile] = useState(null);
  const [importMode, setImportMode] = useState('replace');
  const [previewData, setPreviewData] = useState(null);
  const [columnMapping, setColumnMapping] = useState(null);
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState('');
  const [step, setStep] = useState('select'); // 'select', 'preview', 'importing'
  const fileInputRef = useRef(null);

  const handleFileSelect = async (event) => {
    const file = event.target.files[0];
    if (!file) return;

    setError('');
    setSelectedFile(file);
    setColumnMapping(null);

    // 파일 크기 검증
    if (!validateFileSize(file, 10)) {
      setError('파일 크기가 10MB를 초과합니다.');
      return;
    }

    // 파일 형식 검증
    const isJSON = file.type === 'application/json' || file.name.endsWith('.json');
    const isCSV = file.type === 'text/csv' || file.name.endsWith('.csv');
    
    if (!isJSON && !isCSV) {
      setError('JSON 또는 CSV 파일만 업로드할 수 있습니다.');
      return;
    }

    // 파일 미리보기 및 분석
    try {
      setIsLoading(true);
      let data;
      
      if (isJSON) {
        data = await importProjectsFromJSON(file);
      } else if (isCSV) {
        // CSV 파일의 헤더 먼저 분석
        const text = await file.text();
        const mapping = generateColumnMapping(text);
        setColumnMapping(mapping);
        
        data = await importProjectsFromCSV(file);
      }
      
      setPreviewData(data);
      setStep('preview');
    } catch (err) {
      setError(err.message);
    } finally {
      setIsLoading(false);
    }
  };

  const handleImport = () => {
    if (!previewData) return;

    try {
      setIsLoading(true);
      setStep('importing');

      // 프로젝트 데이터 병합
      const mergedProjects = mergeProjects(existingProjects, previewData.projects, importMode);
      
      // 성과 데이터 병합
      const mergedPerformances = mergePerformances(existingPerformances, previewData.performances || [], importMode);
      
      // 부모 컴포넌트에 데이터 전달
      onImport({
        projects: mergedProjects,
        performances: mergedPerformances,
        metadata: previewData.metadata,
        importMode,
        columnMapping
      });

      // 성공 후 모달 닫기
      setTimeout(() => {
        handleClose();
      }, 1000);
    } catch (err) {
      setError(err.message);
      setStep('preview');
    } finally {
      setIsLoading(false);
    }
  };

  const handleClose = () => {
    setSelectedFile(null);
    setPreviewData(null);
    setColumnMapping(null);
    setError('');
    setStep('select');
    setImportMode('replace');
    if (fileInputRef.current) {
      fileInputRef.current.value = '';
    }
    onClose();
  };

  const getMergedCount = () => {
    if (!previewData || !previewData.projects) return { projects: 0, performances: 0 };
    
    const projectCount = (() => {
      switch (importMode) {
        case 'replace':
          return previewData.projects.length;
        case 'merge':
          const existingIds = new Set(existingProjects.map(p => p.id));
          return existingProjects.length + previewData.projects.filter(p => !existingIds.has(p.id)).length;
        case 'append':
          return existingProjects.length + previewData.projects.length;
        default:
          return 0;
      }
    })();

    const performanceCount = (() => {
      const importedPerfs = previewData.performances || [];
      switch (importMode) {
        case 'replace':
          return importedPerfs.length;
        case 'merge':
          const existingPerfIds = new Set(existingPerformances.map(p => p.id));
          return existingPerformances.length + importedPerfs.filter(p => !existingPerfIds.has(p.id)).length;
        case 'append':
          return existingPerformances.length + importedPerfs.length;
        default:
          return 0;
      }
    })();

    return { projects: projectCount, performances: performanceCount };
  };

  const getFileTypeIcon = () => {
    if (!selectedFile) return <FileText size={20} />;
    
    if (selectedFile.name.endsWith('.json')) {
      return <Database size={20} style={{ color: '#0066cc' }} />;
    } else if (selectedFile.name.endsWith('.csv')) {
      return <BarChart3 size={20} style={{ color: '#059669' }} />;
    }
    return <FileText size={20} />;
  };

  const getFileTypeLabel = () => {
    if (!selectedFile) return '';
    
    if (selectedFile.name.endsWith('.json')) {
      return 'JSON';
    } else if (selectedFile.name.endsWith('.csv')) {
      return 'CSV';
    }
    return '';
  };

  const getFileTypeBadgeClass = () => {
    if (!selectedFile) return '';
    
    if (selectedFile.name.endsWith('.json')) {
      return 'json';
    } else if (selectedFile.name.endsWith('.csv')) {
      return 'csv';
    }
    return '';
  };

  const renderColumnMappingInfo = () => {
    if (!columnMapping || !selectedFile?.name.endsWith('.csv')) return null;

    return (
      <div className="column-mapping-info">
        <h4>CSV 파일 분석 결과</h4>
        <div className="mapping-details">
          <div className="mapping-item">
            <span className="label">감지된 형식:</span>
            <span className={`mode-badge ${columnMapping.mode}`}>
              {columnMapping.mode === 'multi_table' && '🎯 4테이블 분리 (Excel 편집 최적화)'}
              {columnMapping.mode === 'legacy' && '📄 레거시 (기존 형식)'}
              {columnMapping.mode === 'unknown' && '❓ 알 수 없음'}
            </span>
          </div>
          
          {columnMapping.mode === 'multi_table' && (
            <div className="multi-table-features">
              <div className="feature-item">
                <span className="feature-yes">
                  ✅ 4개 테이블 분리 방식
                </span>
              </div>
              <div className="feature-item">
                <span className="feature-yes">
                  ✅ Excel 섹션별 편집 가능
                </span>
              </div>
              {columnMapping.sectionsFound && columnMapping.sectionsFound.length > 0 && (
                <div className="sections-found">
                  <strong>발견된 섹션:</strong> {columnMapping.sectionsFound.join(', ')}
                </div>
              )}
            </div>
          )}

          {columnMapping.missingColumns.length > 0 && (
            <div className="missing-columns">
              <span className="warning-text">⚠️ 누락된 필수 컬럼: {columnMapping.missingColumns.join(', ')}</span>
            </div>
          )}
        </div>
      </div>
    );
  };

  const renderDataPreview = () => {
    if (!previewData?.projects || previewData.projects.length === 0) return null;

    const sampleProject = previewData.projects[0];
    const performanceCount = sampleProject.성과목록?.length || 0;
    const actionItemCount = sampleProject.액션아이템목록?.length || 0;
    const globalPerformanceCount = previewData.performances?.length || 0;

    return (
      <div className="data-preview">
        <h4>데이터 미리보기</h4>
        <div className="preview-stats">
          <div className="stat-item">
            <span className="stat-label">총 프로젝트:</span>
            <span className="stat-value">{previewData.projects.length}개</span>
          </div>
          <div className="stat-item">
            <span className="stat-label">글로벌 성과:</span>
            <span className="stat-value">{globalPerformanceCount}개</span>
          </div>
          <div className="stat-item">
            <span className="stat-label">평균 액션아이템:</span>
            <span className="stat-value">{Math.round(previewData.projects.reduce((sum, p) => sum + (p.액션아이템목록?.length || 0), 0) / previewData.projects.length)}개</span>
          </div>
        </div>

        <div className="sample-project">
          <h5>샘플 프로젝트: {sampleProject.과제명}</h5>
          <div className="sample-details">
            <div><strong>사업부:</strong> {sampleProject.사업부}</div>
            <div><strong>프로세스:</strong> {sampleProject.프로세스}</div>
            <div><strong>진행상태:</strong> {sampleProject.진행상태}</div>
            {performanceCount > 0 && <div><strong>연결된 성과:</strong> {performanceCount}개</div>}
            {actionItemCount > 0 && <div><strong>액션아이템:</strong> {actionItemCount}개</div>}
          </div>
        </div>

        {globalPerformanceCount > 0 && (
          <div className="performance-info">
            <h5>글로벌 성과 항목</h5>
            <p>이 파일에는 {globalPerformanceCount}개의 성과 항목이 포함되어 있습니다. 이들은 프로젝트와 독립적으로 관리됩니다.</p>
          </div>
        )}
      </div>
    );
  };

  if (!isOpen) return null;

  return (
    <div className="modal-overlay">
      <div className="modal-container import-modal">
        <div className="modal-header">
          <h2>데이터 불러오기</h2>
          <button className="close-button" onClick={handleClose}>
            <X size={24} />
          </button>
        </div>

        <div className="modal-content">
          {step === 'select' && (
            <div className="file-select-section">
              <div className="upload-area" onClick={() => fileInputRef.current?.click()}>
                <Upload size={48} className="upload-icon" />
                <h3>JSON 또는 CSV 파일 선택</h3>
                <p>디지털 트윈 대시보드 데이터 파일을 선택하세요</p>
                <div className="file-type-info">
                  <div className="file-type-item">
                    <Database size={24} />
                    <span className="file-type-badge json">JSON</span>
                    <span>통합 구조 (프로젝트 + 성과)</span>
                  </div>
                  <div className="file-type-item">
                    <BarChart3 size={24} />
                    <span className="file-type-badge csv">CSV</span>
                    <span>Excel 호환 + 분석 최적화</span>
                  </div>
                </div>
                <button className="select-file-btn">파일 선택</button>
              </div>
              
              <input
                ref={fileInputRef}
                type="file"
                accept=".json,.csv,application/json,text/csv"
                onChange={handleFileSelect}
                style={{ display: 'none' }}
              />

              {selectedFile && (
                <div className="file-info">
                  {getFileTypeIcon()}
                  <span>{selectedFile.name}</span>
                  <span className={`file-type-label ${getFileTypeBadgeClass()}`}>{getFileTypeLabel()}</span>
                  <span className="file-size">({(selectedFile.size / 1024).toFixed(1)} KB)</span>
                </div>
              )}

              {error && (
                <div className="error-message">
                  <AlertTriangle size={20} />
                  <span>{error}</span>
                </div>
              )}

              {isLoading && (
                <div className="loading-message">
                  <div className="spinner"></div>
                  <span>파일을 분석하고 있습니다...</span>
                </div>
              )}
            </div>
          )}

          {step === 'preview' && previewData && (
            <div className="preview-section">
              <div className="preview-header">
                <h3>가져올 데이터 미리보기</h3>
                <div className="file-info">
                  {getFileTypeIcon()}
                  <span>{selectedFile?.name}</span>
                  <span className={`file-type-label ${getFileTypeBadgeClass()}`}>{getFileTypeLabel()}</span>
                </div>
              </div>

              {renderColumnMappingInfo()}
              {renderDataPreview()}

              <div className="data-summary">
                <div className="summary-item">
                  <span className="label">프로젝트 수:</span>
                  <span className="value">{previewData.projects.length}개</span>
                </div>
                <div className="summary-item">
                  <span className="label">성과 항목 수:</span>
                  <span className="value">{previewData.performances?.length || 0}개</span>
                </div>
                {previewData.metadata && (
                  <>
                    <div className="summary-item">
                      <span className="label">파일 형식:</span>
                      <span className="value">{getFileTypeLabel()}</span>
                    </div>
                    {previewData.metadata.exportDate && (
                      <div className="summary-item">
                        <span className="label">처리 날짜:</span>
                        <span className="value">{new Date(previewData.metadata.exportDate).toLocaleDateString()}</span>
                      </div>
                    )}
                    {previewData.metadata.version && (
                      <div className="summary-item">
                        <span className="label">버전:</span>
                        <span className="value">{previewData.metadata.version}</span>
                      </div>
                    )}
                  </>
                )}
              </div>

              <div className="import-mode-section">
                <label className="section-label">가져오기 방식</label>
                <div className="import-modes">
                  <label className="mode-option">
                    <input
                      type="radio"
                      name="importMode"
                      value="replace"
                      checked={importMode === 'replace'}
                      onChange={(e) => setImportMode(e.target.value)}
                    />
                    <div className="mode-content">
                      <span className="mode-title">🔄 전체 교체</span>
                      <span className="mode-desc">기존 데이터를 모두 삭제하고 새 데이터로 교체</span>
                    </div>
                  </label>
                  
                  <label className="mode-option">
                    <input
                      type="radio"
                      name="importMode"
                      value="merge"
                      checked={importMode === 'merge'}
                      onChange={(e) => setImportMode(e.target.value)}
                    />
                    <div className="mode-content">
                      <span className="mode-title">🔀 병합</span>
                      <span className="mode-desc">ID가 같으면 덮어쓰고, 새 ID는 추가</span>
                    </div>
                  </label>
                  
                  <label className="mode-option">
                    <input
                      type="radio"
                      name="importMode"
                      value="append"
                      checked={importMode === 'append'}
                      onChange={(e) => setImportMode(e.target.value)}
                    />
                    <div className="mode-content">
                      <span className="mode-title">➕ 추가</span>
                      <span className="mode-desc">기존 데이터를 유지하고 새 데이터를 추가</span>
                    </div>
                  </label>
                </div>
              </div>

              <div className="result-preview">
                <div className="preview-info">
                  <Info size={16} />
                  <span>
                    가져오기 후 총 {getMergedCount().projects}개 프로젝트, {getMergedCount().performances}개 성과 항목이 됩니다.
                    {importMode === 'replace' && ' (기존 데이터 삭제됨)'}
                  </span>
                </div>
              </div>

              {error && (
                <div className="error-message">
                  <AlertTriangle size={20} />
                  <span>{error}</span>
                </div>
              )}
            </div>
          )}

          {step === 'importing' && (
            <div className="importing-section">
              <div className="success-animation">
                <CheckCircle size={64} className="success-icon" />
                <h3>데이터 가져오기 완료</h3>
                <p>
                  {columnMapping?.mode === 'multi_table' && '4테이블 분리 방식으로 '}
                  데이터가 성공적으로 가져와졌습니다.
                </p>
                {previewData.performances && previewData.performances.length > 0 && (
                  <div className="import-details">
                    <small>🎯 프로젝트와 성과가 분리된 효율적인 구조로 처리되었습니다</small>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>

        <div className="modal-footer">
          {step === 'select' && (
            <button className="cancel-btn" onClick={handleClose}>
              취소
            </button>
          )}
          
          {step === 'preview' && (
            <>
              <button 
                className="back-btn" 
                onClick={() => setStep('select')}
              >
                뒤로
              </button>
              <button 
                className="import-btn" 
                onClick={handleImport}
                disabled={isLoading}
              >
                {isLoading ? '가져오는 중...' : '가져오기'}
              </button>
            </>
          )}
        </div>
      </div>

