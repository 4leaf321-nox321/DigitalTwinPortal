/**
 * 프로젝트 데이터를 JSON 파일로 내보내기
 * @param {Array} projects - 프로젝트 배열
 * @param {string} filename - 저장할 파일명 (확장자 제외)
 */
export const exportProjectsToJSON = (projects, filename = 'digital-twin-dashboard-data') => {
  try {
    const exportData = {
      metadata: {
        exportDate: new Date().toISOString(),
        version: '2.0',
        type: 'digital-twin-dashboard-multi-table',
        projectCount: projects.length,
        format: 'json'
      },
      projects
    };

    const dataStr = JSON.stringify(exportData, null, 2);
    const dataBlob = new Blob([dataStr], { type: 'application/json' });
    
    const link = document.createElement('a');
    link.href = URL.createObjectURL(dataBlob);
    link.download = `${filename}_${new Date().toISOString().split('T')[0]}.json`;
    
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
    URL.revokeObjectURL(link.href);
    
    return true;
  } catch (error) {
    console.error('JSON 내보내기 실패:', error);
    throw new Error(`데이터 내보내기 중 오류가 발생했습니다: ${error.message}`);
  }
};

/**
 * 4테이블 분리 방식으로 프로젝트 데이터를 CSV 파일로 내보내기
 * @param {Array} projects - 프로젝트 배열
 * @param {string} filename - 저장할 파일명 (확장자 제외)
 * @param {string} mode - 내보내기 모드 ('multi_table'|'legacy') 기본값: 'multi_table'
 */
export const exportProjectsToCSV = (projects, filename = 'digital-twin-dashboard-data', mode = 'multi_table') => {
  try {
    if (mode === 'legacy') {
      return exportProjectsToCSVLegacy(projects, filename);
    }

    // 4테이블 분리 방식으로 데이터 변환
    const tables = convertProjectsToTables(projects);
    
    // 각 테이블을 CSV 섹션으로 변환
    const sections = [];
    
    // 메타데이터 섹션
    sections.push(`[METADATA]`);
    sections.push(`export_date,version,type,project_count,format`);
    sections.push(`${new Date().toISOString()},2.0,digital-twin-dashboard-multi-table,${projects.length},csv`);
    sections.push('');

    // 프로젝트 기본 정보 섹션
    sections.push(`[PROJECTS]`);
    sections.push(convertTableToCSV(tables.projects, getProjectHeaders()));
    sections.push('');

    // 성과 정보 섹션
    sections.push(`[PERFORMANCES]`);
    sections.push(convertTableToCSV(tables.performances, getPerformanceHeaders()));
    sections.push('');

    // 액션아이템 섹션
    sections.push(`[ACTION_ITEMS]`);
    sections.push(convertTableToCSV(tables.actionItems, getActionItemHeaders()));
    sections.push('');

    // 팀멤버 섹션
    sections.push(`[TEAM_MEMBERS]`);
    sections.push(convertTableToCSV(tables.teamMembers, getTeamMemberHeaders()));

    // 전체 CSV 내용 생성
    const csvContent = sections.join('\n');

    // BOM을 추가하여 한글 인코딩 문제 해결
    const BOM = '\uFEFF';
    const csvBlob = new Blob([BOM + csvContent], { type: 'text/csv;charset=utf-8' });
    
    const link = document.createElement('a');
    link.href = URL.createObjectURL(csvBlob);
    link.download = `${filename}_multi_table_${new Date().toISOString().split('T')[0]}.csv`;
    
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
    URL.revokeObjectURL(link.href);
    
    return true;
  } catch (error) {
    console.error('CSV 내보내기 실패:', error);
    throw new Error(`CSV 내보내기 중 오류가 발생했습니다: ${error.message}`);
  }
};

/**
 * 프로젝트 배열을 4개 테이블로 변환
 * @param {Array} projects - 프로젝트 배열
 * @returns {Object} 4개 테이블이 포함된 객체
 */
const convertProjectsToTables = (projects) => {
  const tables = {
    projects: [],
    performances: [],
    actionItems: [],
    teamMembers: []
  };

  projects.forEach(project => {
    // 1. 프로젝트 기본 정보
    tables.projects.push({
      id: project.id,
      과제년도: project.과제년도,
      사업부: project.사업부,
      프로세스: project.프로세스,
      과제구분: project.과제구분,
      과제명: project.과제명,
      시작: project.시작,
      종료: project.종료,
      진행상태: project.진행상태,
      과제PL: project.과제PL,
      작성자: project.작성자,
      과제상세설명: project.과제상세설명,
      PoC과제여부: project.PoC과제여부,
      중점과제여부: project.중점과제여부
    });

    // 2. 성과 정보
    if (project.성과목록 && project.성과목록.length > 0) {
      project.성과목록.forEach((performance, index) => {
        tables.performances.push({
          project_id: project.id,
          순번: index + 1,
          대분류: performance.대분류 || '',
          소분류: performance.소분류 || '',
          성과항목: performance.성과항목 || '',
          과제기여도: performance.과제기여도 || '',
          현재수준: performance.현재수준 || '',
          목표수준: performance.목표수준 || '',
          실적수준: performance.실적수준 || '',
          단위: performance.단위 || ''
        });
      });
    }

    // 3. 액션아이템 정보
    if (project.액션아이템목록 && project.액션아이템목록.length > 0) {
      project.액션아이템목록.forEach((actionItem, index) => {
        tables.actionItems.push({
          project_id: project.id,
          순번: index + 1,
          제목: actionItem.제목 || '',
          완료여부: actionItem.완료여부 || false
        });
      });
    }

    // 4. 팀멤버 정보
    if (project.과제참여인력목록 && project.과제참여인력목록.length > 0) {
      project.과제참여인력목록.forEach((member, index) => {
        tables.teamMembers.push({
          project_id: project.id,
          순번: index + 1,
          이름: member.이름 || '',
          부서: member.부서 || ''
        });
      });
    }
  });

  return tables;
};

/**
 * 테이블 데이터를 CSV 문자열로 변환
 * @param {Array} data - 테이블 데이터
 * @param {Array} headers - 헤더 배열
 * @returns {string} CSV 문자열
 */
const convertTableToCSV = (data, headers) => {
  if (!data || data.length === 0) {
    return headers.join(',');
  }

  const csvRows = [headers.join(',')];
  
  data.forEach(row => {
    const values = headers.map(header => {
      const value = row[header];
      const str = String(value ?? '');
      
      // 필드에 쉼표, 줄바꿈, 따옴표가 있으면 따옴표로 감싸기
      if (str.includes(',') || str.includes('\n') || str.includes('"')) {
        return `"${str.replace(/"/g, '""')}"`;
      }
      return str;
    });
    csvRows.push(values.join(','));
  });

  return csvRows.join('\n');
};

