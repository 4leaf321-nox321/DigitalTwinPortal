import React, { useState, useEffect } from 'react';\nimport { AnimatePresence } from 'framer-motion';\n\n// 기본 설정 데이터 직접 import\nimport { settingsData } from '../../data/sampleData';\n\n// 컴포넌트들 import\nimport ModalLayout from './components/ModalLayout';\nimport BasicInfoSection from './components/BasicInfoSection';\nimport ResponsibleInfoSection from './components/ResponsibleInfoSection';\nimport PerformanceSection from './components/PerformanceSection';\nimport RemarksSection from './components/RemarksSection';\nimport ActionItemsSection from './components/ActionItemsSection';\n\n// 상수들 import\nimport { \n  UNIT_OPTIONS, \n  SUBCATEGORY_OPTIONS, \n  INITIAL_PERFORMANCE_INPUT,\n  INITIAL_PERSONNEL_INPUT \n} from './constants/formConstants';\n\n// 유틸리티 함수들 import\nimport { \n  validateForm, \n  processFormData,\n  validatePerformanceInput,\n  validateNumericInput\n} from './utils/formUtils';\n\nconst EditProjectModal = ({ isOpen, onClose, onSubmit, project, currentYear, settingsData }) => {\n  const [formData, setFormData] = useState({\n    사업부: '',\n    프로세스: '',\n    과제구분: '',\n    과제명: '',\n    성과목록: [],\n    시작: 1,\n    종료: 12,\n    진행상태: '미착수',\n    진행률: 0, // 새로 추가\n    과제참여인력목록: [],\n    담당부서목록: [],\n    과제PL: '',\n    작성자: '',\n    비고: '',\n    액션아이템목록: [], // 새로 추가\n    // 이전 버전과의 호환성\n    담당부서: '',\n    과제참여인력: ''\n  });\n  \n  const [performanceInput, setPerformanceInput] = useState(INITIAL_PERFORMANCE_INPUT);\n  const [personnelInput, setPersonnelInput] = useState(INITIAL_PERSONNEL_INPUT);\n  const [errors, setErrors] = useState({});\n\n  // 모달 열림/닫힘시 body 스크롤 제어\n  useEffect(() => {\n    if (isOpen) {\n      const originalStyle = window.getComputedStyle(document.body).overflow;\n      document.body.style.overflow = 'hidden';\n      \n      return () => {\n        document.body.style.overflow = originalStyle;\n      };\n    }\n  }, [isOpen]);\n\n  // 프로젝트 데이터로 폼 초기화\n  useEffect(() => {\n    if (project) {\n      // 새로운 인력 관리 방식 데이터 처리\n      let 과제참여인력목록 = [];\n      let 담당부서목록 = [];\n      \n      if (project.과제참여인력목록 && Array.isArray(project.과제참여인력목록)) {\n        // 새로운 형식\n        과제참여인력목록 = project.과제참여인력목록;\n        담당부서목록 = project.담당부서목록 || [];\n      } else {\n        // 이전 형식에서 변환\n        if (project.담당자 && Array.isArray(project.담당자)) {\n          const departments = project.담당부서 && Array.isArray(project.담당부서) \n            ? project.담당부서 \n            : (project.담당부서 ? project.담당부서.split(',').map(d => d.trim()) : []);\n          \n          과제참여인력목록 = project.담당자.map((name, index) => ({\n            이름: name.trim(),\n            부서: departments[Math.min(index, departments.length - 1)] || '미지정'\n          }));\n          \n          담당부서목록 = [...new Set(과제참여인력목록.map(p => p.부서))];\n        } else if (project.과제참여인력) {\n          // 콤마로 구분된 문자열 형식\n          const names = project.과제참여인력.split(',').map(n => n.trim());\n          const departments = project.담당부서 \n            ? (Array.isArray(project.담당부서) \n              ? project.담당부서 \n              : project.담당부서.split(',').map(d => d.trim()))\n            : [];\n          \n          과제참여인력목록 = names.map((name, index) => ({\n            이름: name,\n            부서: departments[Math.min(index, departments.length - 1)] || '미지정'\n          }));\n          \n          담당부서목록 = [...new Set(과제참여인력목록.map(p => p.부서))];\n        }\n      }\n\n      // 성과 목록 처리\n      let 성과목록 = [];\n      if (project.성과목록 && Array.isArray(project.성과목록) && project.성과목록.length > 0) {\n        성과목록 = project.성과목록;\n      }\n      \n      // 액션 아이템 목록 처리\n      let 액션아이템목록 = [];\n      if (project.액션아이템목록 && Array.isArray(project.액션아이템목록)) {\n        액션아이템목록 = project.액션아이템목록;\n      }\n      \n      setFormData({\n        사업부: project.사업부 || '',\n        프로세스: project.프로세스 || project.부문 || '', // \"부문\"에서 \"프로세스\"로 마이그레이션\n        과제구분: project.과제구분 || '',\n        과제명: project.과제명 || '',\n        성과목록: 성과목록,\n        시작: project.시작 || 1,\n        종료: project.종료 || 12,\n        진행상태: project.진행상태 || '미착수',\n        진행률: project.진행률 || 0, // 진행률 추가\n        과제참여인력목록: 과제참여인력목록,\n        담당부서목록: 담당부서목록,\n        과제PL: project.관리자 || project.과제PL || '',\n        작성자: project.작성자 || '',\n        비고: project.비고 || '',\n        액션아이템목록: 액션아이템목록,\n        PoC과제여부: project.PoC과제여부 || false,\n        중점과제여부: project.중점과제여부 || false,\n        // 이전 버전과의 호환성\n        담당부서: Array.isArray(project.담당부서) \n          ? project.담당부서.join(', ') \n          : project.담당부서 || '',\n        과제참여인력: Array.isArray(project.담당자) \n          ? project.담당자.join(', ') \n          : project.과제참여인력 || ''\n      });\n    }\n  }, [project]);\n\n  // 기본 설정 데이터에서 드롭다운 옵션 추출\n  const 사업부Options = (settingsData || settingsData).divisions.map(division => division.name);\n  const 프로세스Options = (settingsData || settingsData).processes.map(process => process.name);\n  const 과제구분Options = (settingsData || settingsData).taskCategories.map(taskCategory => taskCategory.name);\n  const 진행상태Options = (settingsData || settingsData).statuses.map(status => status.name);\n\n  const monthOptions = Array.from({ length: 12 }, (_, i) => ({\n    value: i + 1,\n    label: `${i + 1}월`\n  }));\n\n  const handleInputChange = (e) => {\n    const { name, value, type, checked } = e.target;\n    const newValue = type === 'checkbox' ? checked : value;\n    \n    setFormData(prev => ({\n      ...prev,\n      [name]: newValue\n    }));\n    \n    // 에러 클리어\n    if (errors[name]) {\n      setErrors(prev => ({\n        ...prev,\n        [name]: null\n      }));\n    }\n  };\n\n  // 성과 입력 필드 변경 처리\n  const handlePerformanceInputChange = (field, value) => {\n    setPerformanceInput(prev => ({\n      ...prev,\n      [field]: value\n    }));\n  };\n\n  // 설정 데이터에서 이름 찾기 헬퍼 함수들\n  const getCategoryName = (categoryId) => {\n    const category = (settingsData || {}).performanceCategories?.find(cat => cat.id === categoryId);\n    return category ? category.name : categoryId;\n  };\n  \n  const getSubcategoryName = (subcategoryId) => {\n    const subcategory = (settingsData || {}).performanceSubcategories?.find(sub => sub.id === subcategoryId);\n    return subcategory ? subcategory.name : subcategoryId;\n  };\n  \n  const getItemName = (itemId) => {\n    const item = (settingsData || {}).performanceItems?.find(item => item.id === itemId);\n    return item ? item.name : itemId;\n  };\n\n  // 성과 리스트에 추가\n  const addPerformanceToList = () => {\n    if (performanceInput.대분류ID && performanceInput.소분류ID && performanceInput.성과항목ID && \n        performanceInput.과제기여도 && performanceInput.현재수준 && performanceInput.목표수준 && performanceInput.단위) {\n      const newPerformance = {\n        대분류ID: performanceInput.대분류ID,\n        소분류ID: performanceInput.소분류ID,\n        성과항목ID: performanceInput.성과항목ID,\n        // 하위 호환성을 위해 기존 필드도 유지\n        대분류: getCategoryName(performanceInput.대분류ID),\n        소분류: getSubcategoryName(performanceInput.소분류ID),\n        성과항목: getItemName(performanceInput.성과항목ID),\n        과제기여도: performanceInput.과제기여도,\n        현재수준: performanceInput.현재수준,\n        목표수준: performanceInput.목표수준,\n        실적수준: performanceInput.실적수준 || '',\n        단위: performanceInput.단위\n      };\n      \n      setFormData(prev => ({\n        ...prev,\n        성과목록: [...prev.성과목록, newPerformance]\n      }));\n      \n      setPerformanceInput(INITIAL_PERFORMANCE_INPUT);\n    }\n  };\n\n  // 인력 입력 필드 변경 처리\n  const handlePersonnelInputChange = (field, value) => {\n    setPersonnelInput(prev => ({\n      ...prev,\n      [field]: value\n    }));\n  };\n\n  // 인력 리스트에 추가\n  const addPersonnelToList = () => {\n    if (personnelInput.이름 && personnelInput.부서) {\n      const newPersonnel = {\n        이름: personnelInput.이름.trim(),\n        부서: personnelInput.부서.trim()\n      };\n      \n      const isDuplicate = formData.과제참여인력목록.some(person => \n        person.이름 === newPersonnel.이름 && person.부서 === newPersonnel.부서\n      );\n      \n      if (isDuplicate) {\n        alert('이미 등록된 인력입니다.');\n        return;\n      }\n      \n      setFormData(prev => {\n        const newPersonnelList = [...prev.과제참여인력목록, newPersonnel];\n        const departmentSet = new Set(newPersonnelList.map(person => person.부서));\n        const newDepartmentList = Array.from(departmentSet);\n        \n        return {\n          ...prev,\n          과제참여인력목록: newPersonnelList,\n          담당부서목록: newDepartmentList\n        };\n      });\n      \n      setPersonnelInput(INITIAL_PERSONNEL_INPUT);\n    }\n  };\n\n  // 성과 리스트에서 제거\n  const removePerformanceFromList = (index) => {\n    setFormData(prev => ({\n      ...prev,\n      성과목록: prev.성과목록.filter((_, i) => i !== index)\n    }));\n  };\n\n  // 인력 리스트에서 제거\n  const removePersonnelFromList = (index) => {\n    setFormData(prev => {\n      const newPersonnelList = prev.과제참여인력목록.filter((_, i) => i !== index);\n      const departmentSet = new Set(newPersonnelList.map(person => person.부서));\n      const newDepartmentList = Array.from(departmentSet);\n      \n      return {\n        ...prev,\n        과제참여인력목록: newPersonnelList,\n        담당부서목록: newDepartmentList\n      };\n    });\n  };\n\n  // 부서 전체 삭제\n  const removeDepartmentFromList = (index) => {\n    const departmentToRemove = formData.담당부서목록[index];\n    \n    if (window.confirm(`${departmentToRemove} 부서와 소속 인력을 모두 삭제하시겠습니까?`)) {\n      setFormData(prev => {\n        const newPersonnelList = prev.과제참여인력목록.filter(person => person.부서 !== departmentToRemove);\n        const newDepartmentList = prev.담당부서목록.filter((_, i) => i !== index);\n        \n        return {\n          ...prev,\n          과제참여인력목록: newPersonnelList,\n          담당부서목록: newDepartmentList\n        };\n      });\n    }\n  };\n\n  const handleSubmit = (e) => {\n    e.preventDefault();\n    \n    const validationErrors = validateForm(formData);\n    if (Object.keys(validationErrors).length > 0) {\n      setErrors(validationErrors);\n      return;\n    }\n    \n    const processedData = processFormData(formData, currentYear || project.과제년도);\n    const updatedProject = {\n      ...project,\n      ...processedData,\n      id: project.id // 기존 ID 유지\n    };\n    \n    console.log('수정된 과제 데이터:', updatedProject);\n    onSubmit(updatedProject);\n    handleClose();\n  };\n\n  const handleClose = () => {\n    setErrors({});\n    setPerformanceInput(INITIAL_PERFORMANCE_INPUT);\n    setPersonnelInput(INITIAL_PERSONNEL_INPUT);\n    onClose();\n  };\n\n  if (!isOpen || !project) return null;\n\n  const modalProps = {\n    handleClose,\n    currentYear: currentYear || project.과제년도,\n    handleSubmit,\n    isEditMode: true\n  };\n\n  const basicInfoProps = {\n    formData,\n    handleInputChange,\n    errors,\n    사업부Options,\n    프로세스Options,\n    과제구분Options,\n    진행상태Options,\n    monthOptions\n  };\n\n  const responsibleInfoProps = {\n    formData,\n    handleInputChange,\n    errors,\n    personnelInput,\n    handlePersonnelInputChange,\n    addPersonnelToList,\n    removePersonnelFromList,\n    removeDepartmentFromList\n  };\n\n  const performanceProps = {\n    performanceInput,\n    handlePerformanceInputChange,\n    addPerformanceToList,\n    formData,\n    removePerformanceFromList,\n    errors,\n    UNIT_OPTIONS,\n    SUBCATEGORY_OPTIONS,\n    settingsData\n  };\n\n  const remarksProps = {\n    formData,\n    handleInputChange\n  };\n\n  const actionItemsProps = {\n    formData,\n    handleInputChange\n  };\n\n  return (\n    <AnimatePresence>\n      <ModalLayout {...modalProps}>\n        <BasicInfoSection {...basicInfoProps} />\n        <ResponsibleInfoSection {...responsibleInfoProps} />\n        <PerformanceSection {...performanceProps} />\n        <RemarksSection {...remarksProps} />\n        <ActionItemsSection {...actionItemsProps} />\n      </ModalLayout>\n    </AnimatePresence>\n  );\n};\n\nexport default EditProjectModal;"