const MONTHS = [
  '1월', '2월', '3월', '4월', '5월', '6월',
  '7월', '8월', '9월', '10월', '11월', '12월'
];

const GanttChart = ({ projects, statusColors, divisionColors, onYearChange, currentYear: propCurrentYear, onEditProject, onDeleteProject, settingsData }) => {
  const [currentYear, setCurrentYear] = useState(propCurrentYear || 2025);
  const [filters, setFilters] = useState({
    사업부: [],
    대분류: [],
    중분류: [],
    소분류: []
  });
  const [openDropdown, setOpenDropdown] = useState(null);
  
  // 설정 데이터에서 필터 옵션 추출 (기본값 사용)
  const 사업부Options = settingsData?.divisions?.map(division => division.name) || ['VD', 'MX', '의료기기', 'DA', 'NW'];
  const 대분류Options = settingsData?.categories?.map(category => category.name) || ['개발', '품질', '제조'];
  const 중분류Options = settingsData?.midcategories?.map(midcategory => midcategory.name) || ['시스템 개발', '품질 관리', '제조 최적화', '데이터 분석'];
  const 소분류Options = settingsData?.subcategories?.map(subcategory => subcategory.name) || ['시뮬레이션', '이상감지/조기개선', 'DB 플랫폼'];
  
  const filteredProjects = projects.filter(project => {
    const yearMatch = project.과제년도 === currentYear;
    const 사업부Match = filters.사업부.length === 0 || filters.사업부.includes(project.사업부);
    const 대분류Match = filters.대분류.length === 0 || filters.대분류.includes(project.대분류);
    const 중분류Match = filters.중분류.length === 0 || filters.중분류.includes(project.중분류);
    const 소분류Match = filters.소분류.length === 0 || filters.소분류.includes(project.소분류);
    
    return yearMatch && 사업부Match && 대분류Match && 중분류Match && 소분류Match;
  });
  
  const calculateBarPosition = (start, end) => {
    const startOffset = ((start - 1) / 12) * 100;
    const duration = end - start + 1;
    const width = (duration / 12) * 100;
    return { startOffset, width };
  };
  
  const handlePrevYear = () => {
    const newYear = currentYear - 1;
    setCurrentYear(newYear);
    if (onYearChange) {
      onYearChange(newYear);
    }
  };
  
  const handleNextYear = () => {
    const newYear = currentYear + 1;
    setCurrentYear(newYear);
    if (onYearChange) {
      onYearChange(newYear);
    }
  };
  
  const handleFilterChange = (filterType, value) => {
    setFilters(prev => {
      const currentValues = prev[filterType] || [];
      const newValues = currentValues.includes(value)
        ? currentValues.filter(v => v !== value)
        : [...currentValues, value];
      
      return {
        ...prev,
        [filterType]: newValues
      };
    });
  };
  
  const handleClearFilter = (filterType) => {
    setFilters(prev => ({
      ...prev,
      [filterType]: []
    }));
  };
  
  const handleClearAllFilters = () => {
    setFilters({
      사업부: [],
      대분류: [],
      중분류: [],
      소분류: []
    });
  };
  
  const toggleDropdown = (filterType) => {
    setOpenDropdown(openDropdown === filterType ? null : filterType);
  };
  
  const getFilterDisplayText = (filterType, options) => {
    const selected = filters[filterType] || [];
    if (selected.length === 0) return '전체';
    if (selected.length === 1) return selected[0];
    if (selected.length === options.length) return '전체 선택됨';
    return `${selected.length}개 선택됨`;
  };
  
  // 드롭다운 외부 클릭시 닫기
  React.useEffect(() => {
    const handleClickOutside = (event) => {
      if (!event.target.closest('.filter-group')) {
        setOpenDropdown(null);
      }
    };
    
    document.addEventListener('mousedown', handleClickOutside);
    return () => {
      document.removeEventListener('mousedown', handleClickOutside);
    };
  }, []);
  
  React.useEffect(() => {
    if (propCurrentYear && propCurrentYear !== currentYear) {
      setCurrentYear(propCurrentYear);
    }
  }, [propCurrentYear, currentYear]);
  
  return (
    <GanttContainer>
      <GanttHeader>
        <div className="title">
          <Calendar size={20} />
          디지털 트윈 과제 진행 현황
        </div>
        
        <div className="header-controls">
          <div className="filters-section">
            <div className={`filter-group ${openDropdown === '사업부' ? 'open' : ''}`}>
              <label className="filter-label">사업부</label>
              <div style={{ position: 'relative' }}>
                <button 
                  className={`filter-button ${openDropdown === '사업부' ? 'open' : ''}`}
                  onClick={() => toggleDropdown('사업부')}
                  type="button"
                >
                  {getFilterDisplayText('사업부', 사업부Options)}
                </button>
                {openDropdown === '사업부' && (
                  <div className="filter-dropdown">
                    {사업부Options.map(option => {
                      const isSelected = filters.사업부.includes(option);
                      return (
                        <div 
                          key={option}
                          className={`filter-option ${isSelected ? 'selected' : ''}`}
                          onClick={() => handleFilterChange('사업부', option)}
                        >
                          <div className={`filter-checkbox ${isSelected ? 'checked' : ''}`}>
                            {isSelected && '✓'}
                          </div>
                          {option}
                        </div>
                      );
                    })}
                  </div>
                )}
                {filters.사업부.length > 0 && (
                  <button 
                    className="filter-clear"
                    onClick={() => handleClearFilter('사업부')}
                    title="필터 지우기"
                    type="button"
                  >
                    <X size={14} />
                  </button>
                )}
              </div>
            </div>
            
            <div className={`filter-group ${openDropdown === '대분류' ? 'open' : ''}`}>
              <label className="filter-label">대분류</label>
              <div style={{ position: 'relative' }}>
                <button 
                  className={`filter-button ${openDropdown === '대분류' ? 'open' : ''}`}
                  onClick={() => toggleDropdown('대분류')}
                  type="button"
                >
                  {getFilterDisplayText('대분류', 대분류Options)}
                </button>
                {openDropdown === '대분류' && (
                  <div className="filter-dropdown">
                    {대분류Options.map(option => {
                      const isSelected = filters.대분류.includes(option);
                      return (
                        <div 
                          key={option}
                          className={`filter-option ${isSelected ? 'selected' : ''}`}
                          onClick={() => handleFilterChange('대분류', option)}
                        >
                          <div className={`filter-checkbox ${isSelected ? 'checked' : ''}`}>
                            {isSelected && '✓'}
                          </div>
                          {option}
                        </div>
                      );
                    })}
                  </div>
                )}
                {filters.대분류.length > 0 && (
                  <button 
                    className="filter-clear"
                    onClick={() => handleClearFilter('대분류')}
                    title="필터 지우기"
                    type="button"
                  >
                    <X size={14} />
                  </button>
                )}
              </div>
            </div>
            
            <div className={`filter-group ${openDropdown === '중분류' ? 'open' : ''}`}>
              <label className="filter-label">중분류</label>
              <div style={{ position: 'relative' }}>
                <button 
                  className={`filter-button ${openDropdown === '중분류' ? 'open' : ''}`}
                  onClick={() => toggleDropdown('중분류')}
                  type="button"
                >
                  {getFilterDisplayText('중분류', 중분류Options)}
                </button>
                {openDropdown === '중분류' && (
                  <div className="filter-dropdown">
                    {중분류Options.map(option => {
                      const isSelected = filters.중분류.includes(option);
                      return (
                        <div 
                          key={option}
                          className={`filter-option ${isSelected ? 'selected' : ''}`}
                          onClick={() => handleFilterChange('중분류', option)}
                        >
                          <div className={`filter-checkbox ${isSelected ? 'checked' : ''}`}>
                            {isSelected && '✓'}
                          </div>
                          {option}
                        </div>
                      );
                    })}
                  </div>
                )}
                {filters.중분류.length > 0 && (
                  <button 
                    className="filter-clear"
                    onClick={() => handleClearFilter('중분류')}
                    title="필터 지우기"
                    type="button"
                  >
                    <X size={14} />
                  </button>
                )}
              </div>
            </div>
            
            <div className={`filter-group ${openDropdown === '소분류' ? 'open' : ''}`}>
              <label className="filter-label">소분류</label>
              <div style={{ position: 'relative' }}>
                <button 
                  className={`filter-button ${openDropdown === '소분류' ? 'open' : ''}`}
                  onClick={() => toggleDropdown('소분류')}
                  type="button"
                >
                  {getFilterDisplayText('소분류', 소분류Options)}
                </button>
                {openDropdown === '소분류' && (
                  <div className="filter-dropdown">
                    {소분류Options.map(option => {
                      const isSelected = filters.소분류.includes(option);
                      return (
                        <div 
                          key={option}
                          className={`filter-option ${isSelected ? 'selected' : ''}`}
                          onClick={() => handleFilterChange('소분류', option)}
                        >
                          <div className={`filter-checkbox ${isSelected ? 'checked' : ''}`}>
                            {isSelected && '✓'}
                          </div>
                          {option}
                        </div>
                      );
                    })}
                  </div>
                )}
                {filters.소분류.length > 0 && (
                  <button 
                    className="filter-clear"
                    onClick={() => handleClearFilter('소분류')}
                    title="필터 지우기"
                    type="button"
                  >
                    <X size={14} />
                  </button>
                )}
              </div>
            </div>
            
            {(filters.사업부.length > 0 || filters.대분류.length > 0 || filters.중분류.length > 0 || filters.소분류.length > 0) && (
              <button
                onClick={handleClearAllFilters}
                style={{
                  background: 'rgba(239, 68, 68, 0.2)',
                  border: '1px solid rgba(239, 68, 68, 0.5)',
                  borderRadius: '0.375rem',
                  color: 'white',
                  padding: '0.375rem 0.75rem',
                  fontSize: '0.75rem',
                  fontWeight: '500',
                  cursor: 'pointer',
                  transition: 'all 0.2s ease',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '0.25rem'
                }}
                onMouseOver={(e) => {
                  e.target.style.background = 'rgba(239, 68, 68, 0.3)';
                }}
                onMouseOut={(e) => {
                  e.target.style.background = 'rgba(239, 68, 68, 0.2)';
                }}
                title="모든 필터 지우기"
              >
                <X size={12} />
                전체 해제
              </button>
            )}
          </div>
          
          <div className="year-selector">
            <button className="year-nav" onClick={handlePrevYear} title="이전 년도">
              ‹
            </button>
            <div className="current-year">{currentYear}</div>
            <button className="year-nav" onClick={handleNextYear} title="다음 년도">
              ›
            </button>
          </div>
        </div>
      </GanttHeader>
      
      <GanttContent>
        <TaskList>
          <TaskHeader>
            <div className="header-section">
              과제 정보
            </div>
            <div className="goal-header">
              성과 구분
            </div>
            <div className="performance-header">
              경영성과
            </div>
          </TaskHeader>
          {filteredProjects.map((project, index) => (
            <TaskItem
              key={project.id}
              divisionColor={divisionColors[project.사업부]}
              statusColor={statusColors[project.진행상태]}
              initial={{ opacity: 0, x: -20 }}
              animate={{ opacity: 1, x: 0 }}
              transition={{ duration: 0.3, delay: index * 0.05 }}
            >
              <div className="task-info">
                <div className="task-title">{project.과제명}</div>
                <div className="task-meta">
                  <span className="division-badge">{project.사업부}</span>
                  <span className="status-badge">{project.진행상태}</span>
                  
                  <div className="department-info">
                    <Building size={12} />
                    <div className="department-list">
                      {Array.isArray(project.담당부서) 
                        ? project.담당부서.map((dept, idx) => (
                            <span key={idx} className="department-tag" title={dept}>{dept}</span>
                          ))
                        : <span className="department-tag" title={project.담당부서}>{project.담당부서}</span>
                      }
                    </div>
                  </div>
                  
                  <div className="assignee-info">
                    <User size={12} />
                    <div className="assignee-list">
                      {Array.isArray(project.담당자) 
                        ? project.담당자.map((person, idx) => (
                            <span key={idx} className="assignee-tag" title={person}>{person}</span>
                          ))
                        : <span className="assignee-tag" title={project.담당자}>{project.담당자}</span>
                      }
                    </div>
                  </div>
                </div>
              </div>
              
              <div className="goal-section">
                <div className="goal-item">
                  <span className="goal-value">{project.과제목표}</span>
                </div>
              </div>
              
              <div className="performance-section">
                <div 
                  className={`performance-badge ${
                    project.경영성과.includes('PM') 
                      ? 'performance-pm' 
                      : 'performance-description'
                  }`}
                >
                  {project.경영성과}
                </div>
              </div>
              
              <div className="action-buttons">
                <button 
                  className="action-btn edit-btn" 
                  onClick={(e) => {
                    e.stopPropagation();
                    onEditProject && onEditProject(project);
                  }}
                  title="과제 편집"
                >
                  <Edit size={14} />
                </button>
                <button 
                  className="action-btn delete-btn" 
                  onClick={(e) => {
                    e.stopPropagation();
                    onDeleteProject && onDeleteProject(project);
                  }}
                  title="과제 삭제"
                >
                  <Trash2 size={14} />
                </button>
              </div>
            </TaskItem>
          ))}
        </TaskList>
        
        <ChartArea>
          <MonthHeader>
            {MONTHS.map((month, index) => (
              <MonthCell key={index}>{month}</MonthCell>
            ))}
          </MonthHeader>
          
          {filteredProjects.map((project, index) => {
            const { startOffset, width } = calculateBarPosition(project.시작, project.종료);
            return (
              <GanttRow key={project.id}>
                <GanttCell 
                  style={{ 
                    gridColumn: `1 / -1`,
                    position: 'relative',
                    minWidth: `${12 * 80}px`
                  }}
                >
                  <GanttBar
                    startOffset={startOffset}
                    width={width}
                    color={statusColors[project.진행상태] || '#6b7280'}
                    title={`${project.과제명} (${project.시작}월-${project.종료}월)`}
                  />
                </GanttCell>
              </GanttRow>
            );
          })}
        </ChartArea>
      </GanttContent>
    </GanttContainer>
  );
};

export default GanttChart;