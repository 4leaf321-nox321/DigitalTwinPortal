const MONTHS = [
  '1월', '2월', '3월', '4월', '5월', '6월',
  '7월', '8월', '9월', '10월', '11월', '12월'
];

const GanttChart = ({ projects, statusColors, divisionColors, onYearChange, currentYear: propCurrentYear, onEditProject, onDeleteProject, settingsData }) => {
  const [currentYear, setCurrentYear] = useState(propCurrentYear || 2025);
  const [filters, setFilters] = useState({
    사업부: [],
    부문: [],
    중분류: [],
    소분류: []
  });
  const [openDropdown, setOpenDropdown] = useState(null);
  
  // 설정 데이터에서 필터 옵션 추출 (기본값 사용)
  const filterOptions = {
    사업부: settingsData?.divisions?.map(division => division.name) || ['VD', 'MX', '의료기기', 'DA', 'NW'],
    부문: settingsData?.categories?.map(category => category.name) || ['개발', '제조', '품질', '연계'],
    중분류: settingsData?.midcategories?.map(midcategory => midcategory.name) || ['시스템 개발', '품질 관리', '제조 최적화', '데이터 분석'],
    소분류: settingsData?.subcategories?.map(subcategory => subcategory.name) || ['시뮬레이션', '이상감지/조기개선', 'DB 플랫폼']
  };
  
  const filteredProjects = projects.filter(project => {
    const yearMatch = project.과제년도 === currentYear;
    const 사업부Match = filters.사업부.length === 0 || filters.사업부.includes(project.사업부);
    const 부문Match = filters.부문.length === 0 || filters.부문.includes(project.부문 || project.대분류);
    const 중분류Match = filters.중분류.length === 0 || filters.중분류.includes(project.중분류);
    const 소분류Match = filters.소분류.length === 0 || filters.소분류.includes(project.소분류);
    
    return yearMatch && 사업부Match && 부문Match && 중분류Match && 소분류Match;
  });
  
  // 성과 목록 렌더링 함수
  const renderPerformanceList = (project) => {
    // 새로운 구조 (성과목록 배열) 우선 사용
    if (project.성과목록 && Array.isArray(project.성과목록) && project.성과목록.length > 0) {
      return project.성과목록.map((performance, index) => (
        <PerformanceItem key={index}>
          <div className="performance-category">
            {performance.성과구분 || '미지정'}
          </div>
          <div className={`performance-value ${
            performance.경영성과?.includes('PM') ? 'performance-pm' : ''
          }`}>
            {performance.경영성과 || '미지정'}
          </div>
        </PerformanceItem>
      ));
    }
    
    // 하위 호환성: 기존 구조 사용
    if (project.성과구분 || project.경영성과) {
      return (
        <PerformanceItem>
          <div className="performance-category">
            {project.성과구분 || '미지정'}
          </div>
          <div className={`performance-value ${
            project.경영성과?.includes('PM') ? 'performance-pm' : ''
          }`}>
            {project.경영성과 || '미지정'}
          </div>
        </PerformanceItem>
      );
    }
    
    return (
      <PerformanceItem>
        <div className="performance-category">미지정</div>
        <div className="performance-value">성과 없음</div>
      </PerformanceItem>
    );
  };
  
  const calculateBarPosition = (start, end) => {
    const startOffset = ((start - 1) / 12) * 100;
    const duration = end - start + 1;
    const width = (duration / 12) * 100;
    return { startOffset, width };
  };
  
  const handlePrevYear = () => {
    const newYear = currentYear - 1;
    setCurrentYear(newYear);
    if (onYearChange) {
      onYearChange(newYear);
    }
  };
  
  const handleNextYear = () => {
    const newYear = currentYear + 1;
    setCurrentYear(newYear);
    if (onYearChange) {
      onYearChange(newYear);
    }
  };
  
  const handleFilterChange = (filterType, value) => {
    setFilters(prev => {
      const currentValues = prev[filterType] || [];
      const newValues = currentValues.includes(value)
        ? currentValues.filter(v => v !== value)
        : [...currentValues, value];
      
      return {
        ...prev,
        [filterType]: newValues
      };
    });
  };
  
  const handleClearFilter = (filterType) => {
    setFilters(prev => ({
      ...prev,
      [filterType]: []
    }));
  };
  
  const handleClearAllFilters = () => {
    setFilters({
      사업부: [],
      부문: [],
      중분류: [],
      소분류: []
    });
  };
  
  const toggleDropdown = (filterType) => {
    setOpenDropdown(openDropdown === filterType ? null : filterType);
  };
  
  // 드롭다운 외부 클릭시 닫기
  React.useEffect(() => {
    const handleClickOutside = (event) => {
      if (!event.target.closest('.filter-group')) {
        setOpenDropdown(null);
      }
    };
    
    document.addEventListener('mousedown', handleClickOutside);
    return () => {
      document.removeEventListener('mousedown', handleClickOutside);
    };
  }, []);
  
  React.useEffect(() => {
    if (propCurrentYear && propCurrentYear !== currentYear) {
      setCurrentYear(propCurrentYear);
    }
  }, [propCurrentYear, currentYear]);
  
  return (
    <GanttContainer>
      <GanttHeader>
        <div className="title">
          <Calendar size={20} />
          디지털 트윈 과제 진행 현황
        </div>
        
        <div className="header-controls">
          <GanttFilters
            filters={filters}
            onFilterChange={handleFilterChange}
            onClearFilter={handleClearFilter}
            onClearAllFilters={handleClearAllFilters}
            openDropdown={openDropdown}
            onToggleDropdown={toggleDropdown}
            filterOptions={filterOptions}
          />
          
          <div className="year-selector">
            <button className="year-nav" onClick={handlePrevYear} title="이전 년도">
              ‹
            </button>
            <div className="current-year">{currentYear}</div>
            <button className="year-nav" onClick={handleNextYear} title="다음 년도">
              ›
            </button>
          </div>
        </div>
      </GanttHeader>
      
      <GanttContent>
        {/* 헤더 영역 */}
        <HeaderRow>
          <HeaderTaskSection>
            <div className="division-header">
              사업부
            </div>
            <div className="status-header">
              진행 상태
            </div>
            <div className="task-header">
              과제 정보
            </div>
            <div className="assignee-header">
              담당자
            </div>
            <div className="performance-header">
              성과
            </div>
          </HeaderTaskSection>
          <HeaderChartSection>
            {MONTHS.map((month, index) => (
              <div key={index} className="month-cell">{month}</div>
            ))}
          </HeaderChartSection>
        </HeaderRow>
        
        {/* 데이터 영역 */}
        {filteredProjects.map((project, index) => {
          const { startOffset, width } = calculateBarPosition(project.시작, project.종료);
          return (
            <DataRow key={project.id}>
              {/* 과제 정보 영역 */}
              <TaskSection>
                <TaskItem
                  divisionColor={divisionColors[project.사업부]}
                  statusColor={statusColors[project.진행상태]}
                  initial={{ opacity: 0, x: -20 }}
                  animate={{ opacity: 1, x: 0 }}
                  transition={{ duration: 0.3, delay: index * 0.05 }}
                >
                  <div className="division-section">
                    <span className="division-badge">{project.사업부}</span>
                  </div>
                  
                  <div className="status-section">
                    <span className="status-badge">{project.진행상태}</span>
                  </div>
                  
                  <div className="task-info">
                    <div className="task-title">{project.과제명}</div>
                  </div>
                  
                  <div className="assignee-section">
                    <div className="department-info">
                      <Building size={12} />
                      <div className="department-list">
                        {Array.isArray(project.담당부서) 
                          ? project.담당부서.map((dept, idx) => (
                              <span key={idx} className="department-tag" title={dept}>{dept}</span>
                            ))
                          : <span className="department-tag" title={project.담당부서}>{project.담당부서}</span>
                        }
                      </div>
                    </div>
                    <div className="assignee-info">
                      <User size={12} />
                      <div className="assignee-list">
                        {Array.isArray(project.담당자) 
                          ? project.담당자.map((person, idx) => (
                              <span key={idx} className="assignee-tag" title={person}>{person}</span>
                            ))
                          : <span className="assignee-tag" title={project.담당자}>{project.담당자}</span>
                        }
                      </div>
                    </div>
                  </div>
                  
                  <div className="performance-section">
                    {renderPerformanceList(project)}
                  </div>
                  
                  <div className="action-buttons">
                    <button 
                      className="action-btn edit-btn" 
                      onClick={(e) => {
                        e.stopPropagation();
                        onEditProject && onEditProject(project);
                      }}
                      title="과제 편집"
                    >
                      <Edit size={14} />
                    </button>
                    <button 
                      className="action-btn delete-btn" 
                      onClick={(e) => {
                        e.stopPropagation();
                        onDeleteProject && onDeleteProject(project);
                      }}
                      title="과제 삭제"
                    >
                      <Trash2 size={14} />
                    </button>
                  </div>
                </TaskItem>
              </TaskSection>
              
              {/* 차트 영역 */}
              <ChartSection>
                <div className="gantt-cell">
                  <GanttBar
                    startOffset={startOffset}
                    width={width}
                    color={statusColors[project.진행상태] || '#6b7280'}
                    title={`${project.과제명} (${project.시작}월-${project.종료}월)`}
                  />
                </div>
              </ChartSection>
            </DataRow>
          );
        })}
      </GanttContent>
    </GanttContainer>
  );
};

export default GanttChart;