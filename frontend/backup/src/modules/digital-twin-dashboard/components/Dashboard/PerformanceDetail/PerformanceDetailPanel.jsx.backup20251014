const PerformanceDetailPanel = ({ 
  selectedPerformance, 
  divisionColors, 
  statusColors,
  onClearSelection 
}) => {
  // 성과 기여도에 따른 레벨 계산
  const getContributionLevel = (contribution) => {
    if (!contribution) return 'low';
    const value = parseFloat(contribution.toString().replace('%', '').replace('높음', '80').replace('중간', '50').replace('낮음', '20'));
    if (value >= 70) return 'high';
    if (value >= 40) return 'medium';
    return 'low';
  };

  const getContributionText = (contribution) => {
    if (!contribution) return '미설정';
    return contribution;
  };

  // 성과들을 프로젝트별로 그룹화 및 정렬
  const groupedPerformances = useMemo(() => {
    if (!selectedPerformance?.performances) return [];
    
    const grouped = {};
    
    selectedPerformance.performances.forEach(perf => {
      const projectId = perf.projectId;
      if (!grouped[projectId]) {
        grouped[projectId] = {
          projectName: perf.projectName,
          division: perf.division,
          status: perf.status,
          performances: []
        };
      }
      grouped[projectId].performances.push(perf);
    });
    
    // 프로젝트명으로 정렬
    return Object.values(grouped).sort((a, b) => a.projectName.localeCompare(b.projectName));
  }, [selectedPerformance]);

  if (!selectedPerformance) {
    return (
      <Container
        initial={{ opacity: 0, x: 20 }}
        animate={{ opacity: 1, x: 0 }}
        transition={{ duration: 0.3 }}
      >
        <Title>성과 항목 상세</Title>
        <EmptyState>
          <div className="icon">🎯</div>
          <div className="title">성과 분류를 선택해보세요</div>
          <div className="message">
            트리맵에서 성과 분류를 클릭하면<br />
            관련된 성과 항목들이 여기에 표시됩니다.
          </div>
        </EmptyState>
      </Container>
    );
  }

  return (
    <Container
      initial={{ opacity: 0, x: 20 }}
      animate={{ opacity: 1, x: 0 }}
      transition={{ duration: 0.3 }}
    >
      <Title>성과 항목 상세</Title>
      
      <SelectedInfo>
        <CategoryInfo>
          <CategoryBadge color={selectedPerformance.categoryColor}>
            {selectedPerformance.category}
          </CategoryBadge>
          <div>
            <CategoryName>{selectedPerformance.name}</CategoryName>
            <SubcategoryName>소분류</SubcategoryName>
          </div>
        </CategoryInfo>
        <CountBadge>{selectedPerformance.value}개 성과</CountBadge>
      </SelectedInfo>
      
      <PerformanceList>
        <AnimatePresence>
          {groupedPerformances.map((projectGroup, index) => (
            <motion.div
              key={projectGroup.projectName}
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.3, delay: index * 0.1 }}
            >
              {projectGroup.performances.map((performance, perfIndex) => (
                <PerformanceItem
                  key={`${projectGroup.projectName}-${perfIndex}`}
                  whileHover={{ scale: 1.01 }}
                >
                  <PerformanceHeader>
                    <PerformanceTitle>
                      {performance.performanceItem || '성과 항목 미설정'}
                    </PerformanceTitle>
                    <ProjectBadge color={divisionColors[performance.division] || '#64748b'}>
                      {performance.division}
                    </ProjectBadge>
                  </PerformanceHeader>
                  
                  <ProjectName>{performance.projectName}</ProjectName>
                  
                  <MetricsGrid>
                    <MetricItem>
                      <MetricLabel>현재 수준</MetricLabel>
                      <MetricValue>
                        {performance.current || '-'} {performance.unit || ''}
                      </MetricValue>
                    </MetricItem>
                    <MetricItem>
                      <MetricLabel>목표 수준</MetricLabel>
                      <MetricValue>
                        {performance.target || '-'} {performance.unit || ''}
                      </MetricValue>
                    </MetricItem>
                    <MetricItem>
                      <MetricLabel>실적 수준</MetricLabel>
                      <MetricValue>
                        {performance.actual || '-'} {performance.unit || ''}
                      </MetricValue>
                    </MetricItem>
                  </MetricsGrid>
                  
                  <BottomInfo>
                    <ContributionBadge level={getContributionLevel(performance.contribution)}>
                      기여도: {getContributionText(performance.contribution)}
                    </ContributionBadge>
                    <StatusBadge color={statusColors[performance.status] || '#64748b'}>
                      {performance.status}
                    </StatusBadge>
                  </BottomInfo>
                </PerformanceItem>
              ))}
            </motion.div>
          ))}
        </AnimatePresence>
      </PerformanceList>
    </Container>
  );
};

export default PerformanceDetailPanel;