import React, { useState, useEffect } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport './SettingsModal.css';\n\nconst SettingsModal = ({ \n  isOpen, \n  onClose, \n  settingsData,\n  onUpdateSettings,\n  showSuccess,\n  showError \n}) => {\n  const [activeTab, setActiveTab] = useState('divisions');\n  const [localSettings, setLocalSettings] = useState({\n    divisions: [],\n    statuses: [],\n    performanceCategories: [],\n    performanceSubcategories: [],\n    performanceItems: []\n  });\n  const [hasChanges, setHasChanges] = useState(false);\n\n  useEffect(() => {\n    if (isOpen && settingsData) {\n      setLocalSettings({\n        divisions: settingsData.divisions ? [...settingsData.divisions] : [],\n        statuses: settingsData.statuses ? [...settingsData.statuses] : [],\n        performanceCategories: settingsData.performanceCategories ? [...settingsData.performanceCategories] : [],\n        performanceSubcategories: settingsData.performanceSubcategories ? [...settingsData.performanceSubcategories] : [],\n        performanceItems: settingsData.performanceItems ? [...settingsData.performanceItems] : []\n      });\n      setHasChanges(false);\n    }\n  }, [isOpen, settingsData]);\n\n  useEffect(() => {\n    if (!isOpen || !settingsData) return;\n\n    const hasChanged = (\n      JSON.stringify(localSettings.divisions) !== JSON.stringify(settingsData.divisions || []) ||\n      JSON.stringify(localSettings.statuses) !== JSON.stringify(settingsData.statuses || []) ||\n      JSON.stringify(localSettings.performanceCategories) !== JSON.stringify(settingsData.performanceCategories || []) ||\n      JSON.stringify(localSettings.performanceSubcategories) !== JSON.stringify(settingsData.performanceSubcategories || []) ||\n      JSON.stringify(localSettings.performanceItems) !== JSON.stringify(settingsData.performanceItems || [])\n    );\n    \n    setHasChanges(hasChanged);\n  }, [localSettings, settingsData, isOpen]);\n\n  const tabs = [\n    { id: 'divisions', label: 'Division', key: 'divisions' },\n    { id: 'statuses', label: 'Status', key: 'statuses' },\n    { id: 'performance', label: 'Performance Items', key: 'performanceItems' }\n  ];\n\n  const handleAddItem = (category) => {\n    const newItem = createNewItem(category);\n    setLocalSettings(prev => ({\n      ...prev,\n      [category]: [...prev[category], newItem]\n    }));\n  };\n\n  const createNewItem = (category) => {\n    const id = category + '_' + Date.now().toString();\n    const currentTab = tabs.find(t => t.key === category);\n    const tabLabel = currentTab ? currentTab.label : 'Item';\n    const baseItem = {\n      id: id,\n      name: 'New ' + tabLabel,\n      order: localSettings[category].length\n    };\n\n    if (category === 'divisions' || category === 'statuses') {\n      return {\n        ...baseItem,\n        color: '#64748B',\n        description: ''\n      };\n    }\n    \n    if (category === 'performanceItems') {\n      const firstSubcategory = localSettings.performanceSubcategories[0];\n      return {\n        ...baseItem,\n        name: 'New Performance Item',\n        subcategoryId: firstSubcategory ? firstSubcategory.id : '',\n        unit: '',\n        description: ''\n      };\n    }\n    \n    return baseItem;\n  };\n\n  const handleUpdateItem = (category, id, updates) => {\n    setLocalSettings(prev => ({\n      ...prev,\n      [category]: prev[category].map(item => \n        item.id === id ? Object.assign({}, item, updates) : item\n      )\n    }));\n  };\n\n  const handleDeleteItem = (category, id) => {\n    if (window.confirm('Are you sure you want to delete this item?')) {\n      setLocalSettings(prev => ({\n        ...prev,\n        [category]: prev[category].filter(item => item.id !== id)\n      }));\n    }\n  };\n\n  const handleMoveItem = (category, index, direction) => {\n    const items = localSettings[category].slice();\n    const newIndex = direction === 'up' ? index - 1 : index + 1;\n    \n    if (newIndex < 0 || newIndex >= items.length) return;\n\n    const temp = items[index];\n    items[index] = items[newIndex];\n    items[newIndex] = temp;\n    \n    items.forEach((item, idx) => {\n      item.order = idx;\n    });\n\n    setLocalSettings(prev => ({\n      ...prev,\n      [category]: items\n    }));\n  };\n\n  const handleSave = () => {\n    try {\n      onUpdateSettings(localSettings);\n      showSuccess('Settings saved successfully.');\n      setHasChanges(false);\n    } catch (error) {\n      showError('Error saving settings.');\n    }\n  };\n\n  const handleReset = () => {\n    if (window.confirm('Are you sure you want to reset all changes?')) {\n      setLocalSettings({\n        divisions: settingsData.divisions ? [...settingsData.divisions] : [],\n        statuses: settingsData.statuses ? [...settingsData.statuses] : [],\n        performanceCategories: settingsData.performanceCategories ? [...settingsData.performanceCategories] : [],\n        performanceSubcategories: settingsData.performanceSubcategories ? [...settingsData.performanceSubcategories] : [],\n        performanceItems: settingsData.performanceItems ? [...settingsData.performanceItems] : []\n      });\n      setHasChanges(false);\n    }\n  };\n\n  const handleClose = () => {\n    if (hasChanges) {\n      if (window.confirm('You have unsaved changes. Are you sure you want to close?')) {\n        onClose();\n      }\n    } else {\n      onClose();\n    }\n  };\n\n  const getSubcategoryName = (subcategoryId) => {\n    const subcategory = localSettings.performanceSubcategories.find(sub => sub.id === subcategoryId);\n    if (subcategory) {\n      const category = localSettings.performanceCategories.find(cat => cat.id === subcategory.categoryId);\n      const categoryName = category ? category.name : '';\n      return categoryName + ' > ' + subcategory.name;\n    }\n    return 'No Category';\n  };\n\n  const renderItemEditor = (item, category, index) => {\n    const isEditing = item.isEditing;\n    const isPerformance = category === 'performanceItems';\n\n    return React.createElement(\n      motion.div,\n      {\n        key: item.id,\n        initial: { opacity: 0, y: 10 },\n        animate: { opacity: 1, y: 0 },\n        exit: { opacity: 0, y: -10 },\n        className: 'settings-item' + (isPerformance ? ' performance-item' : '')\n      },\n      React.createElement(\n        'div',\n        { className: 'item-content' },\n        React.createElement(\n          'div',\n          { className: 'item-main' },\n          isEditing ? (\n            isPerformance ? (\n              React.createElement(\n                'div',\n                { className: 'performance-edit-form' },\n                React.createElement(\n                  'div',\n                  { className: 'form-row' },\n                  React.createElement('label', null, 'Performance Item Name:'),\n                  React.createElement('input', {\n                    type: 'text',\n                    value: item.name,\n                    onChange: (e) => handleUpdateItem(category, item.id, { name: e.target.value }),\n                    className: 'item-name-input',\n                    placeholder: 'Enter performance item name'\n                  })\n                ),\n                React.createElement(\n                  'div',\n                  { className: 'form-row' },\n                  React.createElement('label', null, 'Category:'),\n                  React.createElement(\n                    'select',\n                    {\n                      value: item.subcategoryId,\n                      onChange: (e) => handleUpdateItem(category, item.id, { subcategoryId: e.target.value }),\n                      className: 'subcategory-select'\n                    },\n                    React.createElement('option', { value: '' }, 'Select category'),\n                    localSettings.performanceSubcategories.map(sub => {\n                      const cat = localSettings.performanceCategories.find(c => c.id === sub.categoryId);\n                      const catName = cat ? cat.name : '';\n                      return React.createElement(\n                        'option',\n                        { key: sub.id, value: sub.id },\n                        catName + ' > ' + sub.name\n                      );\n                    })\n                  )\n                ),\n                React.createElement(\n                  'div',\n                  { className: 'form-row' },\n                  React.createElement('label', null, 'Unit:'),\n                  React.createElement('input', {\n                    type: 'text',\n                    value: item.unit,\n                    onChange: (e) => handleUpdateItem(category, item.id, { unit: e.target.value }),\n                    className: 'unit-input',\n                    placeholder: 'e.g., hours, %, million won, ppm'\n                  })\n                ),\n                React.createElement(\n                  'div',\n                  { className: 'form-row' },\n                  React.createElement('label', null, 'Description:'),\n                  React.createElement('textarea', {\n                    value: item.description,\n                    onChange: (e) => handleUpdateItem(category, item.id, { description: e.target.value }),\n                    className: 'description-textarea',\n                    placeholder: 'Enter description for this performance item',\n                    rows: '2'\n                  })\n                ),\n                React.createElement(\n                  'div',\n                  { className: 'form-actions' },\n                  React.createElement(\n                    'button',\n                    {\n                      onClick: () => handleUpdateItem(category, item.id, { isEditing: false }),\n                      className: 'save-edit-btn'\n                    },\n                    'Save'\n                  )\n                )\n              )\n            ) : (\n              React.createElement('input', {\n                type: 'text',\n                value: item.name,\n                onChange: (e) => handleUpdateItem(category, item.id, { name: e.target.value }),\n                onBlur: () => handleUpdateItem(category, item.id, { isEditing: false }),\n                onKeyDown: (e) => {\n                  if (e.key === 'Enter') {\n                    handleUpdateItem(category, item.id, { isEditing: false });\n                  }\n                },\n                className: 'item-name-input',\n                autoFocus: true\n              })\n            )\n          ) : (\n            isPerformance ? (\n              React.createElement(\n                'div',\n                { className: 'performance-display' },\n                React.createElement('div', { className: 'performance-name' }, item.name),\n                React.createElement(\n                  'div',\n                  { className: 'performance-details' },\n                  React.createElement(\n                    'span',\n                    { className: 'performance-category' },\n                    'Category: ' + getSubcategoryName(item.subcategoryId)\n                  ),\n                  item.unit && React.createElement(\n                    'span',\n                    { className: 'performance-unit' },\n                    'Unit: ' + item.unit\n                  )\n                ),\n                item.description && React.createElement(\n                  'div',\n                  { className: 'performance-description' },\n                  item.description\n                )\n              )\n            ) : (\n              React.createElement(\n                'span',\n                {\n                  className: 'item-name',\n                  onDoubleClick: () => handleUpdateItem(category, item.id, { isEditing: true })\n                },\n                item.name\n              )\n            )\n          ),\n          (category === 'divisions' || category === 'statuses') && React.createElement(\n            'div',\n            { className: 'item-color' },\n            React.createElement('input', {\n              type: 'color',\n              value: item.color || '#64748B',\n              onChange: (e) => handleUpdateItem(category, item.id, { color: e.target.value }),\n              className: 'color-picker',\n              title: 'Select Color'\n            })\n          )\n        )\n      ),\n      React.createElement(\n        'div',\n        { className: 'item-actions' },\n        React.createElement(\n          'button',\n          {\n            onClick: () => handleMoveItem(category, index, 'up'),\n            disabled: index === 0,\n            className: 'move-btn',\n            title: 'Move Up'\n          },\n          'Up'\n        ),\n        React.createElement(\n          'button',\n          {\n            onClick: () => handleMoveItem(category, index, 'down'),\n            disabled: index === localSettings[category].length - 1,\n            className: 'move-btn',\n            title: 'Move Down'\n          },\n          'Down'\n        ),\n        React.createElement(\n          'button',\n          {\n            onClick: () => handleUpdateItem(category, item.id, { isEditing: !isEditing }),\n            className: 'edit-btn',\n            title: 'Edit'\n          },\n          'Edit'\n        ),\n        React.createElement(\n          'button',\n          {\n            onClick: () => handleDeleteItem(category, item.id),\n            className: 'delete-btn',\n            title: 'Delete'\n          },\n          'Delete'\n        )\n      )\n    );\n  };\n\n  const renderTabContent = () => {\n    const currentTab = tabs.find(tab => tab.id === activeTab);\n    const items = localSettings[currentTab.key] || [];\n\n    return React.createElement(\n      'div',\n      { className: 'tab-content' },\n      React.createElement(\n        'div',\n        { className: 'tab-header' },\n        React.createElement('h3', null, currentTab.label + ' Management'),\n        React.createElement(\n          'button',\n          {\n            onClick: () => handleAddItem(currentTab.key),\n            className: 'add-item-btn'\n          },\n          'Add'\n        )\n      ),\n      React.createElement(\n        'div',\n        { className: 'items-list' },\n        React.createElement(\n          AnimatePresence,\n          null,\n          items.map((item, index) => renderItemEditor(item, currentTab.key, index))\n        ),\n        items.length === 0 && React.createElement(\n          'div',\n          { className: 'empty-state' },\n          React.createElement('p', null, 'No ' + currentTab.label + ' items found.'),\n          React.createElement(\n            'button',\n            {\n              onClick: () => handleAddItem(currentTab.key),\n              className: 'empty-add-btn'\n            },\n            'Add First ' + currentTab.label\n          )\n        )\n      )\n    );\n  };\n\n  if (!isOpen) return null;\n\n  return React.createElement(\n    AnimatePresence,\n    null,\n    React.createElement(\n      motion.div,\n      {\n        initial: { opacity: 0 },\n        animate: { opacity: 1 },\n        exit: { opacity: 0 },\n        className: 'settings-modal-overlay',\n        onClick: (e) => e.target === e.currentTarget && handleClose()\n      },\n      React.createElement(\n        motion.div,\n        {\n          initial: { opacity: 0, scale: 0.95, y: 20 },\n          animate: { opacity: 1, scale: 1, y: 0 },\n          exit: { opacity: 0, scale: 0.95, y: 20 },\n          transition: { type: 'spring', damping: 20 },\n          className: 'settings-modal'\n        },\n        React.createElement(\n          'div',\n          { className: 'modal-header' },\n          React.createElement('h2', null, 'System Settings'),\n          React.createElement(\n            'button',\n            {\n              onClick: handleClose,\n              className: 'close-btn'\n            },\n            'X'\n          )\n        ),\n        React.createElement(\n          'div',\n          { className: 'modal-content' },\n          React.createElement(\n            'div',\n            { className: 'tab-navigation' },\n            tabs.map(tab => React.createElement(\n              'button',\n              {\n                key: tab.id,\n                onClick: () => setActiveTab(tab.id),\n                className: 'tab-btn' + (activeTab === tab.id ? ' active' : '')\n              },\n              tab.label\n            ))\n          ),\n          React.createElement(\n            'div',\n            { className: 'tab-container' },\n            renderTabContent()\n          )\n        ),\n        React.createElement(\n          'div',\n          { className: 'modal-footer' },\n          React.createElement(\n            'div',\n            { className: 'changes-indicator' },\n            hasChanges && React.createElement('span', null, 'Unsaved changes detected')\n          ),\n          React.createElement(\n            'div',\n            { className: 'footer-actions' },\n            React.createElement(\n              'button',\n              {\n                onClick: handleReset,\n                disabled: !hasChanges,\n                className: 'reset-btn'\n              },\n              'Reset'\n            ),\n            React.createElement(\n              'button',\n              {\n                onClick: handleSave,\n                disabled: !hasChanges,\n                className: 'save-btn'\n              },\n              'Save'\n            )\n          )\n        )\n      )\n    )\n  );\n};\n\nexport default SettingsModal;"