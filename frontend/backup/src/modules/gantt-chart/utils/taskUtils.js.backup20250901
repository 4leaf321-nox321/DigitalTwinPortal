// 태스크 관련 유틸리티 함수들 (날짜 정확도 개선)

import { getDaysBetween, getDateRange } from './dateUtils';

/**
 * 태스크의 진행률에 따른 상태 반환
 */
export const getTaskStatus = (progress) => {
  if (progress === 0) return 'notStarted';
  if (progress === 100) return 'completed';
  return 'inProgress';
};

/**
 * 태스크가 지연되었는지 확인
 */
export const isTaskDelayed = (task) => {
  const today = new Date();
  const endDate = new Date(task.endDate);
  return today > endDate && task.progress < 100;
};

/**
 * 태스크의 기간 계산 (일)
 */
export const getTaskDuration = (task) => {
  return getDaysBetween(task.startDate, task.endDate) + 1;
};

/**
 * 태스크가 부모 태스크인지 동적으로 확인
 */
export const isParentTask = (taskId, allTasks) => {
  return allTasks.some(task => task.parentId === taskId);
};

/**
 * 특정 태스크의 직계 테스크 ID 목록 가져오기
 */
export const getChildrenIds = (taskId, allTasks) => {
  return allTasks.filter(task => task.parentId === taskId).map(task => task.id);
};

/**
 * 계층 구조를 고려한 태스크 정렬
 */
export const sortTasksHierarchically = (tasks) => {
  const result = [];
  
  // 최상위 태스크들 (level 0) 먼저 찾기
  const rootTasks = tasks.filter(t => t.level === 0);
  
  const addTasksRecursively = (taskId, currentLevel) => {
    const task = tasks.find(t => t.id === taskId);
    if (!task) return;
    
    result.push(task);
    
    // 하위 테스크들이 있고 collapsed되지 않았으면 추가
    if (isParentTask(taskId, tasks) && !task.collapsed) {
      const childrenIds = getChildrenIds(taskId, tasks);
      childrenIds.forEach(childId => {
        addTasksRecursively(childId, currentLevel + 1);
      });
    }
  };
  
  rootTasks.forEach(rootTask => {
    addTasksRecursively(rootTask.id, 0);
  });
  
  return result;
};

/**
 * 부모 태스크의 진행률을 하위 테스크들의 평균으로 계산
 */
export const calculateParentProgress = (parentTask, allTasks) => {
  const childrenIds = getChildrenIds(parentTask.id, allTasks);
  if (childrenIds.length === 0) {
    return parentTask.progress;
  }
  
  const childTasks = childrenIds
    .map(childId => allTasks.find(t => t.id === childId))
    .filter(Boolean);
  
  if (childTasks.length === 0) return parentTask.progress;
  
  const totalProgress = childTasks.reduce((sum, child) => {
    if (isParentTask(child.id, allTasks)) {
      return sum + calculateParentProgress(child, allTasks);
    }
    return sum + child.progress;
  }, 0);
  
  return Math.round(totalProgress / childTasks.length);
};

/**
 * 부모 태스크의 날짜를 하위 테스크들의 범위로 자동 계산
 */
export const calculateParentDates = (parentTask, allTasks) => {
  const childrenIds = getChildrenIds(parentTask.id, allTasks);
  if (childrenIds.length === 0) {
    return {
      startDate: parentTask.startDate,
      endDate: parentTask.endDate
    };
  }
  
  const childTasks = childrenIds
    .map(childId => allTasks.find(t => t.id === childId))
    .filter(Boolean);
  
  if (childTasks.length === 0) {
    return {
      startDate: parentTask.startDate,
      endDate: parentTask.endDate
    };
  }
  
  const childDates = childTasks.map(child => ({
    startDate: new Date(child.startDate),
    endDate: new Date(child.endDate)
  }));
  
  const earliestStart = new Date(Math.min(...childDates.map(d => d.startDate)));
  const latestEnd = new Date(Math.max(...childDates.map(d => d.endDate)));
  
  return {
    startDate: earliestStart.toISOString().split('T')[0],
    endDate: latestEnd.toISOString().split('T')[0]
  };
};

/**
 * 태스크 트리 구조에서 특정 태스크의 토글 상태 변경
 */
export const toggleTaskCollapse = (tasks, taskId) => {
  return tasks.map(task => {
    if (task.id === taskId && isParentTask(taskId, tasks)) {
      return { ...task, collapsed: !task.collapsed };
    }
    return task;
  });
};

/**
 * 의존성이 있는 태스크들의 순서 정렬 (위상 정렬)
 */
export const sortTasksByDependencies = (tasks) => {
  const sorted = [];
  const visited = new Set();
  const visiting = new Set();
  
  const visit = (taskId) => {
    if (visited.has(taskId)) return;
    if (visiting.has(taskId)) {
      console.warn('Circular dependency detected:', taskId);
      return;
    }
    
    visiting.add(taskId);
    
    const task = tasks.find(t => t.id === taskId);
    if (!task) return;
    
    // 의존하는 태스크들을 먼저 방문
    if (task.dependencies) {
      task.dependencies.forEach(depId => {
        visit(depId);
      });
    }
    
    visiting.delete(taskId);
    visited.add(taskId);
    
    if (!sorted.find(t => t.id === taskId)) {
      sorted.push(task);
    }
  };
  
  tasks.forEach(task => {
    visit(task.id);
  });
  
  return sorted;
};

/**
 * 정확한 날짜 기반 태스크 위치 계산 (로컬 시간 기준으로 통일)
 * @param {Object} task - 태스크 객체
 * @param {Date} projectStart - 프로젝트 시작 날짜
 * @param {number} dayWidth - 하루의 픽셀 너비
 * @param {string} viewMode - 뷰 모드 ('days', 'weeks', 'months', 'years')
 * @param {number} scale - 현재 스케일 값
 */
export const calculateTaskPosition = (task, projectStart, dayWidth, viewMode = 'weeks', scale = 1) => {
  const taskStart = new Date(task.startDate);
  const taskEnd = new Date(task.endDate);
  
  // 로컬 시간 기준으로 정확한 날짜 계산을 위해 시간 부분을 정규화
  const normalizeDate = (date) => {
    const normalized = new Date(date);
    normalized.setHours(0, 0, 0, 0);
    return normalized;
  };
  
  const normalizedProjectStart = normalizeDate(projectStart);
  const normalizedTaskStart = normalizeDate(taskStart);
  const normalizedTaskEnd = normalizeDate(taskEnd);
  
  console.log('=== 태스크 위치 계산 (' + viewMode + ') ===');
  console.log('태스크:', task.name);
  console.log('태스크 시작:', normalizedTaskStart.toLocaleDateString('ko-KR'));
  console.log('태스크 종료:', normalizedTaskEnd.toLocaleDateString('ko-KR'));
  console.log('프로젝트 시작:', normalizedProjectStart.toLocaleDateString('ko-KR'));
  
  // 정확한 일수 계산 (밀리초 단위로 계산)
  const msPerDay = 1000 * 60 * 60 * 24;
  const startOffsetDays = Math.round((normalizedTaskStart.getTime() - normalizedProjectStart.getTime()) / msPerDay);
  const durationDays = Math.round((normalizedTaskEnd.getTime() - normalizedTaskStart.getTime()) / msPerDay) + 1;
  
  console.log('시작 오프셋 (일):', startOffsetDays);
  console.log('기간 (일):', durationDays);
  
  let left, width;
  
  switch (viewMode) {
    case 'years':
      // 연 단위: 월별 정확한 계산
      left = calculateYearlyPosition(normalizedTaskStart, normalizedProjectStart, dayWidth);
      width = calculateYearlyWidth(normalizedTaskStart, normalizedTaskEnd, dayWidth);
      break;
      
    case 'months':
      // 월 단위: 주별 정확한 계산
      left = calculateMonthlyPosition(normalizedTaskStart, normalizedProjectStart, dayWidth);
      width = calculateMonthlyWidth(normalizedTaskStart, normalizedTaskEnd, dayWidth);
      break;
      
    case 'weeks':
    case 'days':
    default:
      // 주/일 단위: 일별 정확한 계산
      left = startOffsetDays * dayWidth;
      width = durationDays * dayWidth;
      break;
  }
  
  // 최소 너비 보장 및 위치 정규화
  const minWidth = Math.max(2, scale * 8);
  
  console.log('계산된 위치 - Left:', left, 'Width:', width);
  console.log('===============================================');
  
  return {
    left: Math.max(0, left),
    width: Math.max(minWidth, width),
    duration: durationDays
  };
};

/**
 * 연 단위 뷰에서 태스크 시작 위치 계산 (로컬 시간 기준)
 */
const calculateYearlyPosition = (taskStart, projectStart, monthWidth) => {
  // 로컬 시간 기준으로 정규화
  const normalizeLocalDate = (date) => {
    const d = new Date(date);
    return new Date(d.getFullYear(), d.getMonth(), d.getDate());
  };
  
  const normalizedTaskStart = normalizeLocalDate(taskStart);
  const normalizedProjectStart = normalizeLocalDate(projectStart);
  
  const startYear = normalizedProjectStart.getFullYear();
  const startMonth = normalizedProjectStart.getMonth();
  const taskYear = normalizedTaskStart.getFullYear();
  const taskMonth = normalizedTaskStart.getMonth();
  const taskDay = normalizedTaskStart.getDate();
  
  console.log('=== 연단위 태스크 위치 계산 ===');
  console.log('프로젝트 시작:', startYear, '년', startMonth + 1, '월');
  console.log('태스크 시작:', taskYear, '년', taskMonth + 1, '월', taskDay, '일');
  
  // 월별 오프셋 계산 (사용자 지정 범위 기준)
  const monthOffset = (taskYear - startYear) * 12 + (taskMonth - startMonth);
  
  // 월 내에서의 일별 비율 계산 (로컬 시간 기준)
  const daysInTaskMonth = new Date(taskYear, taskMonth + 1, 0).getDate();
  const dayRatio = (taskDay - 1) / daysInTaskMonth;
  
  console.log('월 오프셋:', monthOffset);
  console.log('월 내 일별 비율:', dayRatio, '=', (taskDay - 1), '/', daysInTaskMonth);
  
  const result = monthOffset * monthWidth + dayRatio * monthWidth;
  console.log('연단위 위치:', result);
  
  return result;
};

/**
 * 연 단위 뷰에서 태스크 너비 계산 (로컬 시간 기준)
 */
const calculateYearlyWidth = (taskStart, taskEnd, monthWidth) => {
  // 로컬 시간 기준으로 정규화
  const normalizeLocalDate = (date) => {
    const d = new Date(date);
    return new Date(d.getFullYear(), d.getMonth(), d.getDate());
  };
  
  const normalizedTaskStart = normalizeLocalDate(taskStart);
  const normalizedTaskEnd = normalizeLocalDate(taskEnd);
  
  const startYear = normalizedTaskStart.getFullYear();
  const startMonth = normalizedTaskStart.getMonth();
  const startDay = normalizedTaskStart.getDate();
  const endYear = normalizedTaskEnd.getFullYear();
  const endMonth = normalizedTaskEnd.getMonth();
  const endDay = normalizedTaskEnd.getDate();
  
  console.log('=== 연단위 태스크 너비 계산 ===');
  console.log('시작:', startYear, '년', startMonth + 1, '월', startDay, '일');
  console.log('종료:', endYear, '년', endMonth + 1, '월', endDay, '일');
  
  if (startYear === endYear && startMonth === endMonth) {
    // 같은 월 내의 태스크 (로컬 시간 기준)
    const daysInMonth = new Date(startYear, startMonth + 1, 0).getDate();
    const daySpan = endDay - startDay + 1;
    const result = (daySpan / daysInMonth) * monthWidth;
    console.log('같은 월 내 - 일 수:', daySpan, '/ 월 총 일수:', daysInMonth, '= 너비:', result);
    return result;
  } else {
    // 여러 월에 걸친 태스크 (로컬 시간 기준)
    const daysInStartMonth = new Date(startYear, startMonth + 1, 0).getDate();
    const daysInEndMonth = new Date(endYear, endMonth + 1, 0).getDate();
    
    const startMonthDays = daysInStartMonth - startDay + 1;
    const endMonthDays = endDay;
    const middleMonths = Math.max(0, (endYear - startYear) * 12 + (endMonth - startMonth) - 1);
    
    const result = (startMonthDays / daysInStartMonth * monthWidth) + 
           (middleMonths * monthWidth) + 
           (endMonthDays / daysInEndMonth * monthWidth);
    
    console.log('여러 월 - 시작 월 일수:', startMonthDays, '중간 월수:', middleMonths, '종료 월 일수:', endMonthDays, '= 너비:', result);
    return result;
  }
};

/**
 * 월 단위 뷰에서 태스크 시작 위치 계산 (로컬 시간 기준)
 */
const calculateMonthlyPosition = (taskStart, projectStart, weekWidth) => {
  // 로컬 시간 기준으로 정규화
  const normalizeLocalDate = (date) => {
    const d = new Date(date);
    return new Date(d.getFullYear(), d.getMonth(), d.getDate());
  };
  
  const getWeekStart = (date) => {
    const result = new Date(date);
    const day = result.getDay();
    const diff = result.getDate() - day + (day === 0 ? -6 : 1);
    result.setDate(diff);
    return result;
  };
  
  const normalizedTaskStart = normalizeLocalDate(taskStart);
  const normalizedProjectStart = normalizeLocalDate(projectStart);
  
  console.log('=== 월단위 태스크 위치 계산 ===');
  console.log('태스크 시작:', normalizedTaskStart.toLocaleDateString('ko-KR'));
  console.log('프로젝트 시작:', normalizedProjectStart.toLocaleDateString('ko-KR'));
  
  // 프로젝트 시작일의 주 시작점 (월요일) 계산
  const projectStartWeek = getWeekStart(normalizedProjectStart);
  const taskStartWeek = getWeekStart(normalizedTaskStart);
  
  console.log('프로젝트 시작 주:', projectStartWeek.toLocaleDateString('ko-KR'));
  console.log('태스크 시작 주:', taskStartWeek.toLocaleDateString('ko-KR'));
  
  // 주별 오프셋 계산 (사용자 지정 범위 기준)
  const msPerWeek = 1000 * 60 * 60 * 24 * 7;
  const weekOffset = Math.round((taskStartWeek.getTime() - projectStartWeek.getTime()) / msPerWeek);
  
  // 주 내에서의 일별 위치 계산
  const taskDayOfWeek = (normalizedTaskStart.getDay() + 6) % 7; // 월요일을 0으로 만들기
  const dayRatio = taskDayOfWeek / 7;
  
  console.log('주 오프셋:', weekOffset);
  console.log('주 내 요일 (0=월):', taskDayOfWeek);
  console.log('일 비율:', dayRatio);
  
  const result = weekOffset * weekWidth + dayRatio * weekWidth;
  console.log('월단위 위치:', result);
  
  return result;
};

/**
 * 월 단위 뷰에서 태스크 너비 계산 (로컬 시간 기준)
 */
const calculateMonthlyWidth = (taskStart, taskEnd, weekWidth) => {
  // 로컬 시간 기준으로 정규화
  const normalizeLocalDate = (date) => {
    const d = new Date(date);
    return new Date(d.getFullYear(), d.getMonth(), d.getDate());
  };
  
  const getWeekStart = (date) => {
    const result = new Date(date);
    const day = result.getDay();
    const diff = result.getDate() - day + (day === 0 ? -6 : 1);
    result.setDate(diff);
    return result;
  };
  
  const normalizedTaskStart = normalizeLocalDate(taskStart);
  const normalizedTaskEnd = normalizeLocalDate(taskEnd);
  
  console.log('=== 월단위 태스크 너비 계산 ===');
  console.log('시작:', normalizedTaskStart.toLocaleDateString('ko-KR'));
  console.log('종료:', normalizedTaskEnd.toLocaleDateString('ko-KR'));
  
  const startWeek = getWeekStart(normalizedTaskStart);
  const endWeek = getWeekStart(normalizedTaskEnd);
  
  const msPerWeek = 1000 * 60 * 60 * 24 * 7;
  const weekSpan = Math.round((endWeek.getTime() - startWeek.getTime()) / msPerWeek);
  
  console.log('시작 주:', startWeek.toLocaleDateString('ko-KR'));
  console.log('종료 주:', endWeek.toLocaleDateString('ko-KR'));
  console.log('주 차이:', weekSpan);
  
  if (weekSpan === 0) {
    // 같은 주 내의 태스크
    const startDayOfWeek = (normalizedTaskStart.getDay() + 6) % 7;
    const endDayOfWeek = (normalizedTaskEnd.getDay() + 6) % 7;
    const daySpan = endDayOfWeek - startDayOfWeek + 1;
    const result = (daySpan / 7) * weekWidth;
    console.log('같은 주 - 시작 요일:', startDayOfWeek, '종료 요일:', endDayOfWeek, '일 수:', daySpan, '너비:', result);
    return result;
  } else {
    // 여러 주에 걸친 태스크
    const startDayOfWeek = (normalizedTaskStart.getDay() + 6) % 7;
    const endDayOfWeek = (normalizedTaskEnd.getDay() + 6) % 7;
    
    const firstWeekDays = 7 - startDayOfWeek;
    const lastWeekDays = endDayOfWeek + 1;
    const middleWeeks = Math.max(0, weekSpan - 1);
    
    const result = (firstWeekDays / 7 * weekWidth) + 
           (middleWeeks * weekWidth) + 
           (lastWeekDays / 7 * weekWidth);
    
    console.log('여러 주 - 첫 주 일수:', firstWeekDays, '중간 주수:', middleWeeks, '마지막 주 일수:', lastWeekDays, '너비:', result);
    return result;
  }
};

/**
 * 주의 시작일 (월요일) 구하기
 */
const getWeekStart = (date) => {
  const result = new Date(date);
  const day = result.getDay();
  const diff = result.getDate() - day + (day === 0 ? -6 : 1); // 일요일이면 -6, 그외는 1을 더해 월요일로
  result.setDate(diff);
  result.setHours(0, 0, 0, 0);
  return result;
};

/**
 * 크리티컬 패스 계산
 */
export const calculateCriticalPath = (tasks) => {
  // 간단한 크리티컬 패스 계산 (실제로는 더 복잡한 알고리즘 필요)
  const taskMap = new Map(tasks.map(t => [t.id, t]));
  const criticalTasks = [];
  
  // 종료일이 늦은 순으로 정렬
  const sortedTasks = [...tasks].sort((a, b) => new Date(b.endDate) - new Date(a.endDate));
  
  for (const task of sortedTasks) {
    // 의존성이 많거나 기간이 긴 태스크를 크리티컬로 판단
    const hasDependents = tasks.some(t => t.dependencies?.includes(task.id));
    const isLongDuration = getTaskDuration(task) > 7; // 7일 이상
    
    if (hasDependents || isLongDuration) {
      criticalTasks.push(task.id);
    }
  }
  
  return criticalTasks;
};

/**
 * 태스크 검증 (개선된 버전)
 */
export const validateTask = (task) => {
  const errors = [];
  
  if (!task.name || task.name.trim() === '') {
    errors.push('태스크 이름을 입력해주세요.');
  }
  
  if (!task.startDate) {
    errors.push('시작 날짜를 선택해주세요.');
  }
  
  if (!task.endDate) {
    errors.push('종료 날짜를 선택해주세요.');
  }
  
  if (task.startDate && task.endDate && new Date(task.startDate) > new Date(task.endDate)) {
    errors.push('시작 날짜는 종료 날짜보다 이전이어야 합니다.');
  }
  
  if (task.progress < 0 || task.progress > 100) {
    errors.push('진행률은 0-100% 사이여야 합니다.');
  }
  
  // 레벨 검증
  if (task.level < 0 || task.level > 5) {
    errors.push('태스크 레벨은 0-5 사이여야 합니다.');
  }
  
  return errors;
};

