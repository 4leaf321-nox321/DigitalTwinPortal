  width: 100%;
  height: 100%;
  overflow: auto;
  background: #f9fafb;
  border-radius: 12px;
  border: 1px solid #e5e7eb;
`;

const ChartContent = styled.div`
  min-width: 800px;
  min-height: 600px;
  position: relative;
  padding: 20px;
`;

const GridHeader = styled.div`
  display: grid;
  grid-template-columns: ${props => `${props.stepWidth}px repeat(${props.orgCount}, ${props.colWidth}px)`};
  gap: 1px;
  margin-bottom: 1px;
  background-color: #e5e7eb;
  border-radius: 8px 8px 0 0;
`;

const GridBody = styled.div`
  display: grid;
  grid-template-columns: ${props => `${props.stepWidth}px repeat(${props.orgCount}, ${props.colWidth}px)`};
  gap: 1px;
  background-color: #e5e7eb;
  border-radius: 0 0 8px 8px;
`;

const HeaderCell = styled.div`
  background: #374151;
  color: white;
  padding: 16px 12px;
  text-align: center;
  font-weight: 600;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60px;
  position: relative;
  
  &:first-child {
    background: #1f2937;
    border-radius: 8px 0 0 0;
