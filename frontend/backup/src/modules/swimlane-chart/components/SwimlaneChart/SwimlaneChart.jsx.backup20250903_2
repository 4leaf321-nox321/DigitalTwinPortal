      width: 4px;
      background: rgba(59, 130, 246, 0.4);
      cursor: col-resize;
      z-index: 10;
      border-radius: 2px;
    }
    
    &:hover::after {
      background: rgba(59, 130, 246, 0.8);
    }
  }
  
  &:last-child {
    border-radius: 0 8px 0 0;
  }
  
  &:not(:first-child)::after {
    content: '';
