const SwimlaneChart = ({ 
  organizations = [], 
  steps = [], 
  cellData = {}, // { "stepId-orgId": { processes: [], connections: [] } }
  onAddOrganization,
  onEditOrganization,
  onDeleteOrganization,
  onAddStep,
  onEditStep,
  onDeleteStep,
  onUpdateCellData,
  globalConnecting = false,
  onToggleGlobalConnection
}) => {
  const [selectedCell, setSelectedCell] = useState(null);
  const [colWidths, setColWidths] = useState({});
  const [rowHeights, setRowHeights] = useState({});
  const [resizing, setResizing] = useState(null);
  const [stepColumnWidth, setStepColumnWidth] = useState(200);
  
  // 글로벌 연결 상태 관리 - 상단에서 받아옴
  // const [globalConnecting, setGlobalConnecting] = useState(false); // 제거
  const [connectingFrom, setConnectingFrom] = useState(null); // { cellId, processId }
  
  // cellRefs를 상태로 관리하여 동적으로 생성
  const [cellRefs, setCellRefs] = useState({});

  // 기본값 설정
  const defaultOrganizations = organizations.length > 0 ? organizations : [
    { id: 1, name: '마케팅팀' },
    { id: 2, name: '개발팀' },
    { id: 3, name: '품질팀' }
  ];

  const defaultSteps = steps.length > 0 ? steps : [
    { id: 1, name: '1단계' },
    { id: 2, name: '2단계' },
    { id: 3, name: '3단계' },
    { id: 4, name: '4단계' }
  ];

  // cellRefs 업데이트 - 새로운 조직/단계가 추가될 때마다 ref 생성
  useEffect(() => {
    const newCellRefs = { ...cellRefs };
    defaultSteps.forEach(step => {
      defaultOrganizations.forEach(org => {
        const cellId = `${step.id}-${org.id}`;
        if (!newCellRefs[cellId]) {
          newCellRefs[cellId] = React.createRef();
        }
      });
    });
    setCellRefs(newCellRefs);
  }, [defaultOrganizations, defaultSteps]);

  // cellRef 가져오기 함수
  const getCellRef = (cellId) => {
    if (!cellRefs[cellId]) {
      const newRefs = { ...cellRefs };
      newRefs[cellId] = React.createRef();
      setCellRefs(newRefs);
      return newRefs[cellId];
    }
    return cellRefs[cellId];
  };

  // 열 너비와 행 높이 계산
  const getColWidth = (orgId) => colWidths[orgId] || 150;
  const getRowHeight = (stepId) => rowHeights[stepId] || 120;

  // 격자 템플릿 열 계산
  const generateGridTemplateColumns = () => {
    const stepWidth = stepColumnWidth;
    const orgWidths = defaultOrganizations.map(org => getColWidth(org.id)).join('px ');
    return `${stepWidth}px ${orgWidths}px`;
  };

  // 리사이징 핸들러
  const handleMouseDown = (e, type, id) => {
    e.preventDefault();
    e.stopPropagation();
    setResizing({ type, id, startX: e.clientX, startY: e.clientY });
  };

  const handleMouseMove = (e) => {
    if (!resizing) return;

    if (resizing.type === 'column') {
      const deltaX = e.clientX - resizing.startX;
      const currentWidth = getColWidth(resizing.id);
      const newWidth = Math.max(100, currentWidth + deltaX); // 최소 너비 100px
      setColWidths(prev => ({ ...prev, [resizing.id]: newWidth }));
      // 시작 위치 업데이트
      setResizing(prev => ({ ...prev, startX: e.clientX }));
    } else if (resizing.type === 'row') {
      const deltaY = e.clientY - resizing.startY;
      const currentHeight = getRowHeight(resizing.id);
      const newHeight = Math.max(80, currentHeight + deltaY); // 최소 높이 80px
      setRowHeights(prev => ({ ...prev, [resizing.id]: newHeight }));
      // 시작 위치 업데이트
      setResizing(prev => ({ ...prev, startY: e.clientY }));
    } else if (resizing.type === 'stepColumn') {
      const deltaX = e.clientX - resizing.startX;
      const newWidth = Math.max(120, stepColumnWidth + deltaX); // 최소 너비 120px
      setStepColumnWidth(newWidth);
      // 시작 위치 업데이트
      setResizing(prev => ({ ...prev, startX: e.clientX }));
    }
  };

  const handleMouseUp = () => {
    setResizing(null);
  };

  useEffect(() => {
    if (resizing) {
      document.addEventListener('mousemove', handleMouseMove);
      document.addEventListener('mouseup', handleMouseUp);
      return () => {
        document.removeEventListener('mousemove', handleMouseMove);
        document.removeEventListener('mouseup', handleMouseUp);
      };
    }
  }, [resizing]);

  // ESC 키로 글로벌 연결 종료
  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === 'Escape' && globalConnecting) {
        handleCancelConnection();
      }
    };
    
    document.addEventListener('keydown', handleKeyDown);
    return () => {
      document.removeEventListener('keydown', handleKeyDown);
    };
  }, [globalConnecting]);

  const handleCellClick = (stepId, orgId) => {
    // ProcessCell에서 직접 처리하므로 여기서는 제거
  };

  const handleAddProcess = (cellId, newProcess) => {
    const currentData = cellData[cellId] || { processes: [], connections: [] };
    const updatedData = {
      ...currentData,
      processes: [...currentData.processes, newProcess]
    };
    onUpdateCellData(cellId, updatedData);
  };

  const handleUpdateProcess = (cellId, processId, updatedProcess) => {
    const currentData = cellData[cellId] || { processes: [], connections: [] };
    const updatedData = {
      ...currentData,
      processes: currentData.processes.map(p => 
        p.id === processId ? updatedProcess : p
      )
    };
    onUpdateCellData(cellId, updatedData);
  };

  const handleDeleteProcess = (cellId, processId) => {
    const currentData = cellData[cellId] || { processes: [], connections: [] };
    const updatedData = {
      ...currentData,
      processes: currentData.processes.filter(p => p.id !== processId)
    };
    onUpdateCellData(cellId, updatedData);
  };

  const handleUpdateConnections = (cellId, connections) => {
    const currentData = cellData[cellId] || { processes: [], connections: [] };
    const updatedData = {
      ...currentData,
      connections
    };
    onUpdateCellData(cellId, updatedData);
  };

  // 글로벌 연결 핸들러
  const handleGlobalConnect = (fromCellId, fromProcessId, toCellId, toProcessId) => {
    // 두 셀이 같으면 로컬 연결
    if (fromCellId === toCellId) {
      const currentData = cellData[fromCellId] || { processes: [], connections: [] };
      const newConnection = {
        id: Date.now(),
        from: fromProcessId,
        to: toProcessId
      };
      const updatedData = {
        ...currentData,
        connections: [...currentData.connections, newConnection]
      };
      onUpdateCellData(fromCellId, updatedData);
    } else {
      // 다른 셀 간 연결 - 첫 번째 셀에 연결 정보 저장
      const fromData = cellData[fromCellId] || { processes: [], connections: [] };
      const newConnection = {
        id: Date.now(),
        from: fromProcessId,
        to: toProcessId,
        targetCell: toCellId // 타겟 셀 정보 추가
      };
      const updatedData = {
        ...fromData,
        connections: [...fromData.connections, newConnection]
      };
      onUpdateCellData(fromCellId, updatedData);
    }
    
    // 연결 모드 종료
    // setGlobalConnecting(false); // 상단에서 관리하므로 제거
    onToggleGlobalConnection && onToggleGlobalConnection(); // 상단에 알림
    setConnectingFrom(null);
  };

  const handleStartConnection = (cellId, processId) => {
    if (!globalConnecting) {
      // 연결 모드 활성화 - 상단에서 관리
      onToggleGlobalConnection && onToggleGlobalConnection();
    }
    setConnectingFrom({ cellId, processId });
  };

  const handleStartGlobalConnection = () => {
    // 연결 버튼을 눌렀을 때 글로벌 연결 모드 시작 - 상단에서 관리
    if (!globalConnecting) {
      onToggleGlobalConnection && onToggleGlobalConnection();
    }
    setConnectingFrom(null); // 아직 시작점 선택 안함
  };

  const handleEndConnection = (cellId, processId) => {
    if (connectingFrom && globalConnecting) {
      if (connectingFrom.cellId !== cellId || connectingFrom.processId !== processId) {
        handleGlobalConnect(connectingFrom.cellId, connectingFrom.processId, cellId, processId);
      }
    }
  };

  const handleCancelConnection = () => {
    // 상단에서 글로벌 연결 상태 관리
    if (globalConnecting) {
      onToggleGlobalConnection && onToggleGlobalConnection();
    }
    setConnectingFrom(null);
  };

  const handleEditStep = (e, stepId) => {
    e.stopPropagation();
    if (onEditStep) {
      onEditStep(stepId);
    }
  };

  const handleDeleteStep = (e, stepId) => {
    e.stopPropagation();
    if (onDeleteStep) {
      onDeleteStep(stepId);
    }
  };

  // 프로세스 박스의 edge 연결점 계산 함수 (글로벌 연결용)
  const getGlobalProcessEdgePoint = (fromCellId, fromProcessId, toCellId, toProcessId) => {
    const fromCellRef = cellRefs[fromCellId];
    const toCellRef = cellRefs[toCellId];
    const chartRect = chartContentRef.current?.getBoundingClientRect();
    
    if (!fromCellRef?.current || !toCellRef?.current || !chartRect) {
      return null;
    }
    
    const fromData = cellData[fromCellId];
    const toData = cellData[toCellId];
    const fromProcess = fromData?.processes?.find(p => p.id === fromProcessId);
    const toProcess = toData?.processes?.find(p => p.id === toProcessId);
    
    if (!fromProcess || !toProcess) {
      return null;
    }
    
    // 셀 좌표 계산
    const fromCellRect = fromCellRef.current.getBoundingClientRect();
    const toCellRect = toCellRef.current.getBoundingClientRect();
    
    // 프로세스 중심점 (차트 기준)
    const fromCenterX = (fromCellRect.left - chartRect.left) + fromProcess.x + 120;
    const fromCenterY = (fromCellRect.top - chartRect.top) + fromProcess.y + 50;
    const toCenterX = (toCellRect.left - chartRect.left) + toProcess.x + 120;
    const toCenterY = (toCellRect.top - chartRect.top) + toProcess.y + 50;
    
    // 서로 간의 방향 벡터
    const dx = toCenterX - fromCenterX;
    const dy = toCenterY - fromCenterY;
    
    // 프로세스 박스 크기
    const boxWidth = 240;
    const boxHeight = 100;
    const halfWidth = boxWidth / 2;
    const halfHeight = boxHeight / 2;
    
    // From edge point 계산
    let fromEdgeX, fromEdgeY;
    if (Math.abs(dx) > Math.abs(dy)) {
      // 수평 연결
      if (dx > 0) {
        fromEdgeX = fromCenterX + halfWidth;  // 오른쪽 edge
        fromEdgeY = fromCenterY;
      } else {
        fromEdgeX = fromCenterX - halfWidth;  // 왼쪽 edge
        fromEdgeY = fromCenterY;
      }
    } else {
      // 수직 연결
      if (dy > 0) {
        fromEdgeX = fromCenterX;
        fromEdgeY = fromCenterY + halfHeight;  // 아래쪽 edge
      } else {
        fromEdgeX = fromCenterX;
        fromEdgeY = fromCenterY - halfHeight;  // 위쪽 edge
      }
    }
    
    // To edge point 계산 (반대 방향)
    let toEdgeX, toEdgeY;
    if (Math.abs(dx) > Math.abs(dy)) {
      // 수평 연결
      if (dx > 0) {
        toEdgeX = toCenterX - halfWidth;  // 왼쪽 edge
        toEdgeY = toCenterY;
      } else {
        toEdgeX = toCenterX + halfWidth;  // 오른쪽 edge
        toEdgeY = toCenterY;
      }
    } else {
      // 수직 연결
      if (dy > 0) {
        toEdgeX = toCenterX;
        toEdgeY = toCenterY - halfHeight;  // 위쪽 edge
      } else {
        toEdgeX = toCenterX;
        toEdgeY = toCenterY + halfHeight;  // 아래쪽 edge
      }
    }
    
    return {
      from: { x: fromEdgeX, y: fromEdgeY },
      to: { x: toEdgeX, y: toEdgeY }
    };
  };

  // ChartContent에 ref 추가 필요
  const chartContentRef = useRef(null);

  // 글로벌 연결선 삭제 핸들러
  const handleDeleteGlobalConnection = (fromCellId, connectionId) => {
    if (window.confirm('이 연결선을 삭제하시겠습니까?')) {
      const currentData = cellData[fromCellId] || { processes: [], connections: [] };
      const updatedConnections = currentData.connections.filter(conn => conn.id !== connectionId);
      const updatedData = {
        ...currentData,
        connections: updatedConnections
      };
      onUpdateCellData(fromCellId, updatedData);
    }
  };

  // 글로벌 연결선 렌더링
  const renderGlobalConnections = () => {
    const globalConnections = [];
    
    // 모든 셀에서 다른 셀로의 연결만 찾기
    Object.entries(cellData).forEach(([fromCellId, data]) => {
      if (data.connections) {
        data.connections.forEach(conn => {
          if (conn.targetCell) {
            // 다른 셀로의 연결을 전역 레이어에 생성
            const edgePoints = getGlobalProcessEdgePoint(
              fromCellId, 
              conn.from, 
              conn.targetCell, 
              conn.to
            );
            
            if (edgePoints) {
              const { from: fromEdge, to: toEdge } = edgePoints;
              
              // 프로세스 위치 정보 가져오기
              const fromData = cellData[fromCellId];
              const toData = cellData[conn.targetCell];
              const fromProcess = fromData?.processes?.find(p => p.id === conn.from);
              const toProcess = toData?.processes?.find(p => p.id === conn.to);
              
              if (fromProcess && toProcess) {
                // 전체 좌표계 기준 중심점 계산
                const fromCellRect = cellRefs[fromCellId]?.current?.getBoundingClientRect();
                const toCellRect = cellRefs[conn.targetCell]?.current?.getBoundingClientRect();
                const chartRect = chartContentRef.current?.getBoundingClientRect();
                
                if (fromCellRect && toCellRect && chartRect) {
                  const fromCenterX = (fromCellRect.left - chartRect.left) + fromProcess.x + 120;
                  const fromCenterY = (fromCellRect.top - chartRect.top) + fromProcess.y + 50;
                  const toCenterX = (toCellRect.left - chartRect.left) + toProcess.x + 120;
                  const toCenterY = (toCellRect.top - chartRect.top) + toProcess.y + 50;
                  
                  const dx = toCenterX - fromCenterX;
                  const dy = toCenterY - fromCenterY;
                  
                  // edge에서 직각으로 나가는 거리 정의
                  const orthogonalDistance = 30;
                  
                  let pathData;
                  let arrowAngle;
                  
                  if (Math.abs(dx) > Math.abs(dy)) {
                    // 수평 주 방향 연결
                    if (dx > 0) {
                      // 왼쪽에서 오른쪽으로
                      const fromExtend = fromEdge.x + orthogonalDistance;
                      const toExtend = toEdge.x - orthogonalDistance;
                      pathData = `M ${fromEdge.x} ${fromEdge.y} L ${fromExtend} ${fromEdge.y} L ${fromExtend} ${toEdge.y} L ${toEdge.x} ${toEdge.y}`;
                      arrowAngle = 0; // 오른쪽으로 (안쪽으로)
                    } else {
                      // 오른쪽에서 왼쪽으로
                      const fromExtend = fromEdge.x - orthogonalDistance;
                      const toExtend = toEdge.x + orthogonalDistance;
                      pathData = `M ${fromEdge.x} ${fromEdge.y} L ${fromExtend} ${fromEdge.y} L ${fromExtend} ${toEdge.y} L ${toEdge.x} ${toEdge.y}`;
                      arrowAngle = 180; // 왼쪽으로 (안쪽으로)
                    }
                  } else {
                    // 수직 주 방향 연결
                    if (dy > 0) {
                      // 위에서 아래로
                      const fromExtend = fromEdge.y + orthogonalDistance;
                      const toExtend = toEdge.y - orthogonalDistance;
                      pathData = `M ${fromEdge.x} ${fromEdge.y} L ${fromEdge.x} ${fromExtend} L ${toEdge.x} ${fromExtend} L ${toEdge.x} ${toEdge.y}`;
                      arrowAngle = 90; // 아래쪽으로 (안쪽으로)
                    } else {
                      // 아래에서 위로
                      const fromExtend = fromEdge.y - orthogonalDistance;
                      const toExtend = toEdge.y + orthogonalDistance;
                      pathData = `M ${fromEdge.x} ${fromEdge.y} L ${fromEdge.x} ${fromExtend} L ${toEdge.x} ${fromExtend} L ${toEdge.x} ${toEdge.y}`;
                      arrowAngle = -90; // 위쪽으로 (안쪽으로)
                    }
                  }
                  
                  globalConnections.push(
                    <g key={`${fromCellId}-${conn.id}`}>
                      <path
                        d={pathData}
                        stroke="#ef4444"
                        strokeWidth="3"
                        strokeDasharray="8,4"
                        fill="none"
                        markerEnd={`url(#global-arrowhead-${fromCellId}-${conn.id})`}
                      />
                      {/* 삭제 가능한 투명한 굵은 선 */}
                      <path
                        d={pathData}
                        stroke="transparent"
                        strokeWidth="12"
                        fill="none"
                        cursor="pointer"
                        onClick={() => handleDeleteGlobalConnection(fromCellId, conn.id)}
                        onMouseEnter={(e) => {
                          // 호버 시 연결선 강조
                          const actualLine = e.target.previousElementSibling;
                          if (actualLine) {
                            actualLine.style.stroke = '#dc2626';
                            actualLine.style.strokeWidth = '5';
                          }
                        }}
                        onMouseLeave={(e) => {
                          // 호버 해제 시 원래 색상으로 복귀
                          const actualLine = e.target.previousElementSibling;
                          if (actualLine) {
                            actualLine.style.stroke = '#ef4444';
                            actualLine.style.strokeWidth = '3';
                          }
                        }}
                        title="클릭하여 연결선 삭제"
                      />
                      {/* 각 연결마다 개별 마커 정의 */}
                      <defs>
                        <marker
                          id={`global-arrowhead-${fromCellId}-${conn.id}`}
                          markerWidth="8"
                          markerHeight="6"
                          refX="7"
                          refY="3"
                          orient={arrowAngle}
                        >
                          <polygon
                            points="0 0, 8 3, 0 6"
                            fill="#ef4444"
                          />
                        </marker>
                      </defs>
                    </g>
                  );
                }
              }
            }
          }
        });
      }
    });
    
    return globalConnections;
  };

  const getCellData = (stepId, orgId) => {
    const cellId = `${stepId}-${orgId}`;
    return cellData[cellId] || { processes: [], connections: [] };
  };

  return (
    <ChartContainer>
      <ChartContent ref={chartContentRef}>
        {/* 헤더 */}
        <GridHeader 
          gridTemplateColumns={generateGridTemplateColumns()}
        >
          <HeaderCell 
            onMouseDown={(e) => handleMouseDown(e, 'stepColumn', 'step')}
            style={{ position: 'relative' }}
          >
            단계 \ 팀
            <div
              style={{
                position: 'absolute',
                right: '-2px',
                top: 0,
                bottom: 0,
                width: '6px',
                background: 'rgba(59, 130, 246, 0.4)',
                cursor: 'col-resize',
                zIndex: 20,
                borderRadius: '0 2px 2px 0',
                transition: 'background-color 0.2s ease'
              }}
              onMouseDown={(e) => handleMouseDown(e, 'stepColumn', 'step')}
              onMouseEnter={(e) => {
                e.target.style.background = 'rgba(59, 130, 246, 0.8)';
              }}
              onMouseLeave={(e) => {
                e.target.style.background = 'rgba(59, 130, 246, 0.4)';
              }}
              title="Resize step column"
            />
          </HeaderCell>
          {defaultOrganizations.map(org => (
            <HeaderCell 
              key={org.id}
            >
              {org.name}
              <div
                style={{
                  position: 'absolute',
                  right: '-2px',
                  top: 0,
                  bottom: 0,
                  width: '6px',
                  background: 'rgba(99, 102, 241, 0.4)',
                  cursor: 'col-resize',
                  zIndex: 20,
                  borderRadius: '0 2px 2px 0',
                  transition: 'background-color 0.2s ease'
                }}
                onMouseDown={(e) => handleMouseDown(e, 'column', org.id)}
                onMouseEnter={(e) => {
                  e.target.style.background = 'rgba(99, 102, 241, 0.8)';
                }}
                onMouseLeave={(e) => {
                  e.target.style.background = 'rgba(99, 102, 241, 0.4)';
                }}
                title={`Resize ${org.name} column`}
              />
            </HeaderCell>
          ))}
        </GridHeader>

        {/* 본문 */}
        <GridBody 
          gridTemplateColumns={generateGridTemplateColumns()}
        >
          {defaultSteps.map(step => (
            <React.Fragment key={step.id}>
              <StepCell height={getRowHeight(step.id)}>
                <div className="step-name">{step.name}</div>
                <div className="step-actions">
                  <ActionButton 
                    onClick={(e) => handleEditStep(e, step.id)}
                    title="편집"
                  >
                    <Edit3 size={14} />
                  </ActionButton>
                  <ActionButton 
                    className="delete"
                    onClick={(e) => handleDeleteStep(e, step.id)}
                    title="삭제"
                  >
                    <Trash2 size={14} />
                  </ActionButton>
                </div>
                <div
                  style={{
                    position: 'absolute',
                    bottom: '-2px',
                    left: 0,
                    right: 0,
                    height: '6px',
                    background: 'rgba(16, 185, 129, 0.4)',
                    cursor: 'row-resize',
                    zIndex: 20,
                    borderRadius: '0 0 2px 2px',
                    transition: 'background-color 0.2s ease'
                  }}
                  onMouseDown={(e) => handleMouseDown(e, 'row', step.id)}
                  onMouseEnter={(e) => {
                    e.target.style.background = 'rgba(16, 185, 129, 0.8)';
                  }}
                  onMouseLeave={(e) => {
                    e.target.style.background = 'rgba(16, 185, 129, 0.4)';
                  }}
                  title={`Resize ${step.name} row`}
                />
              </StepCell>
              
              {defaultOrganizations.map(org => {
                const cellId = `${step.id}-${org.id}`;
                const data = getCellData(step.id, org.id);
                const cellRef = getCellRef(cellId);
                
                return (
                  <ProcessCellContainer 
                    key={cellId}
                    ref={cellRef}
                    height={getRowHeight(step.id)}
                    onMouseDown={(e) => {
                      // ProcessCell의 드래그와 충돌하지 않도록 바닥 영역에서만 행 리사이징
                      const rect = e.currentTarget.getBoundingClientRect();
                      const isBottomArea = e.clientY > rect.bottom - 10;
                      if (isBottomArea) {
                        handleMouseDown(e, 'row', step.id);
                      }
                    }}
                  >
                    <ProcessCell
                      cellId={cellId}
                      processes={data.processes}
                      connections={data.connections}
                      containerRef={cellRef}
                      globalConnecting={globalConnecting}
                      connectingFrom={connectingFrom}
                      onAddProcess={handleAddProcess}
                      onUpdateProcess={handleUpdateProcess}
                      onDeleteProcess={handleDeleteProcess}
                      onUpdateConnections={handleUpdateConnections}
                      onStartConnection={handleStartConnection}
                      onStartGlobalConnection={handleStartGlobalConnection}
                      onEndConnection={handleEndConnection}
                      onCancelConnection={handleCancelConnection}
                      allCellData={cellData} // 다른 셀의 프로세스 정보 접근용
                      cellRefs={cellRefs} // 다른 셀의 DOM 요소 접근용
                    />
                  </ProcessCellContainer>
                );
              })}
            </React.Fragment>
          ))}
        </GridBody>
        
        {/* 글로벌 연결선 레이어 */}
        <GlobalConnectionLayer>
          {renderGlobalConnections()}
        </GlobalConnectionLayer>
      </ChartContent>
    </ChartContainer>
  );
};

export default SwimlaneChart;

