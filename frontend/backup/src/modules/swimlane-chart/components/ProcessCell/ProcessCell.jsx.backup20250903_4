import React, { useState, useRef, useEffect } from 'react';
import styled from 'styled-components';
import { Plus, Edit3, Trash2, X } from 'lucide-react';

const ProcessBox = styled.div`
  position: absolute;
  background: ${props => props.selected ? '#dbeafe' : '#f9fafb'};
  border: 2px solid ${props => props.selected ? '#3b82f6' : '#d1d5db'};
  border-radius: 12px;
  padding: 20px;
  min-width: 240px;
  max-width: 360px;
  min-height: 100px;
  cursor: move;
  user-select: none;
  font-size: 16px;
  line-height: 1.5;
  z-index: 2;
  
  &:hover {
    border-color: #6366f1;
    box-shadow: 0 4px 16px rgba(99, 102, 241, 0.3);
  }
  
  .process-text {
    word-break: break-word;
    color: #374151;
    font-weight: 500;
    min-height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  
  .process-actions {
    display: none;
    position: absolute;
    top: -12px;
    right: -12px;
    gap: 4px;
  }
  
  &:hover .process-actions {
    display: flex;
  }
`;

const ActionButton = styled.button`
  width: 32px;
  height: 32px;
  padding: 0;
  border: none;
  border-radius: 6px;
  background: ${props => props.danger ? '#ef4444' : '#6366f1'};
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  
  &:hover {
    background: ${props => props.danger ? '#dc2626' : '#4f46e5'};
    transform: scale(1.05);
  }
`;

const ConnectionLine = styled.svg`
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 100; // 프로세스 박스(z-index: 2)보다 앞에 표시
  
  // 삭제 가능한 연결선만 pointer-events 활성화
  path[cursor="pointer"] {
    pointer-events: all;
  }
`;

const HeaderActions = styled.div`
  position: absolute;
  top: 12px;
  right: 12px;
  display: flex;
  gap: 8px;
  z-index: 3;
`;

const AddProcessButton = styled.button`
  width: 40px;
  height: 40px;
  border: none;
  border-radius: 50%;
  background: #e5e7eb;
  color: #111827;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  transition: all 0.2s ease;
  
  &:hover {
    background: #d1d5db;
    transform: scale(1.1);
  }
`;

// 연결선 삭제 버튼 스타일
const ConnectionDeleteButton = styled.button`
  position: absolute;
  width: 24px;
  height: 24px;
  border: none;
  border-radius: 50%;
  background: #ef4444;
  color: white;
  cursor: pointer;
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 150;
  font-size: 12px;
  transition: all 0.2s ease;
  
  &:hover {
    background: #dc2626;
    transform: scale(1.1);
  }
  
  &.visible {
    display: flex;
  }
`;

const ProcessCell = ({ 
  cellId,
  processes = [],
  connections = [],
  onAddProcess,
  onUpdateProcess,
  onDeleteProcess,
  onUpdateConnections,
  containerRef,
  globalConnecting = false,
  connectingFrom = null,
  onStartConnection,
  onStartGlobalConnection,
  onEndConnection,
  onCancelConnection,
  allCellData = {},
  cellRefs = {}
}) => {
  const [selectedProcess, setSelectedProcess] = useState(null);
  const [selectedConnection, setSelectedConnection] = useState(null);
  const [dragging, setDragging] = useState(null);
  
  const cellRef = containerRef || useRef(null);

  const handleAddProcess = () => {
    const text = prompt('프로세스 이름을 입력하세요:');
    if (text && text.trim()) {
      const newProcess = {
        id: Date.now(),
        text: text.trim(),
        x: 20,
        y: 30 + (processes.length * 140)
      };
      onAddProcess(cellId, newProcess);
    }
  };

  const handleEditProcess = (processId) => {
    const process = processes.find(p => p.id === processId);
    if (process) {
      const newText = prompt('프로세스 이름을 수정하세요:', process.text);
      if (newText && newText.trim()) {
        onUpdateProcess(cellId, processId, { ...process, text: newText.trim() });
      }
    }
  };

  const handleDeleteProcess = (processId) => {
    if (window.confirm('이 프로세스를 삭제하시겠습니까?')) {
      onDeleteProcess(cellId, processId);
      const newConnections = connections.filter(
        conn => conn.from !== processId && conn.to !== processId
      );
      onUpdateConnections(cellId, newConnections);
    }
  };

  const handleProcessClick = (processId) => {
    if (globalConnecting) {
      if (connectingFrom && connectingFrom.cellId === cellId && connectingFrom.processId === processId) {
        // 같은 프로세스를 다시 클릭하면 연결 취소
        onCancelConnection();
      } else if (connectingFrom) {
        // 연결 완료
        onEndConnection(cellId, processId);
      } else {
        // 연결 시작
        onStartConnection(cellId, processId);
      }
    } else {
      // 일반 모드 - 프로세스 선택
      setSelectedProcess(processId === selectedProcess ? null : processId);
      setSelectedConnection(null); // 프로세스 선택 시 연결선 선택 해제
    }
  };

  const handleMouseDown = (e, processId) => {
    if (globalConnecting) return; // 글로벌 연결 모드에서는 드래그 비활성화
    
    e.preventDefault();
    e.stopPropagation();
    setDragging(processId);
    setSelectedProcess(processId);
  };

  const handleMouseMove = (e) => {
    if (!dragging || !cellRef.current) return;
    
    const rect = cellRef.current.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    
    const process = processes.find(p => p.id === dragging);
    if (process) {
      onUpdateProcess(cellId, dragging, { 
        ...process, 
        x: Math.max(0, Math.min(x - 120, rect.width - 240)),
        y: Math.max(0, Math.min(y - 50, rect.height - 100))
      });
    }
  };

  const handleMouseUp = () => {
    setDragging(null);
  };

  useEffect(() => {
    if (dragging) {
      document.addEventListener('mousemove', handleMouseMove);
      document.addEventListener('mouseup', handleMouseUp);
      return () => {
        document.removeEventListener('mousemove', handleMouseMove);
        document.removeEventListener('mouseup', handleMouseUp);
      };
    }
  }, [dragging]);

  // Delete 키로 선택된 연결선 삭제
  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === 'Delete' && selectedConnection && !globalConnecting) {
        handleDeleteConnection(selectedConnection);
      }
    };
    
    document.addEventListener('keydown', handleKeyDown);
    return () => {
      document.removeEventListener('keydown', handleKeyDown);
    };
  }, [selectedConnection, globalConnecting]);

  // 프로세스 박스의 edge 연결점 계산 함수
  const getProcessEdgePoint = (processId, targetProcessId) => {
    const process = processes.find(p => p.id === processId);
    const targetProcess = processes.find(p => p.id === targetProcessId);
    if (!process || !targetProcess) return { x: 0, y: 0 };
    
    // 프로세스 박스 중심점
    const centerX = process.x + 120;
    const centerY = process.y + 50;
    const targetCenterX = targetProcess.x + 120;
    const targetCenterY = targetProcess.y + 50;
    
    // 방향 벡터
    const dx = targetCenterX - centerX;
    const dy = targetCenterY - centerY;
    
    // 프로세스 박스 크기 (min-width: 240px, min-height: 100px)
    const boxWidth = 240;
    const boxHeight = 100;
    const halfWidth = boxWidth / 2;
    const halfHeight = boxHeight / 2;
    
    let edgeX, edgeY;
    
    // 수직 또는 수평 연결인지 확인
    if (Math.abs(dx) > Math.abs(dy)) {
      // 수평 연결 (왼쪽 또는 오른쪽 edge)
      if (dx > 0) {
        // 오른쪽 edge
        edgeX = centerX + halfWidth;
        edgeY = centerY;
      } else {
        // 왼쪽 edge
        edgeX = centerX - halfWidth;
        edgeY = centerY;
      }
    } else {
      // 수직 연결 (위쪽 또는 아래쪽 edge)
      if (dy > 0) {
        // 아래쪽 edge
        edgeX = centerX;
        edgeY = centerY + halfHeight;
      } else {
        // 위쪽 edge
        edgeX = centerX;
        edgeY = centerY - halfHeight;
      }
    }
    
    return { x: edgeX, y: edgeY };
  };

  // 다른 셀에서 프로세스 찾기
  const getProcessFromOtherCell = (targetCellId, processId) => {
    const targetCellData = allCellData[targetCellId];
    if (!targetCellData) return null;
    return targetCellData.processes.find(p => p.id === processId);
  };

  // 다른 셀의 프로세스 위치 계산
  const getOtherCellProcessPosition = (targetCellId, processId) => {
    // cellRefs를 통해 다른 셀의 DOM 요소에 접근
    const targetCellRef = cellRefs?.[targetCellId];
    if (!targetCellRef?.current) {
      return null; // 대상 셀을 찾을 수 없음
    }
    
    const process = getProcessFromOtherCell(targetCellId, processId);
    if (!process) {
      return null; // 대상 프로세스를 찾을 수 없음
    }
    
    // 현재 셀과 대상 셀의 DOM 요소 위치 계산
    const currentRect = cellRef.current?.getBoundingClientRect();
    const targetRect = targetCellRef.current.getBoundingClientRect();
    
    if (!currentRect || !targetRect) {
      return null;
    }
    
    // 대상 셀 내에서의 프로세스 위치
    const processX = process.x + 120; // 프로세스 중앙
    const processY = process.y + 50;
    
    // 현재 셀 기준으로 상대 위치 계산
    const relativeX = (targetRect.left - currentRect.left) + processX;
    const relativeY = (targetRect.top - currentRect.top) + processY;
    
    return { x: relativeX, y: relativeY };
  };

  // 연결선 삭제 핸들러
  const handleDeleteConnection = (connectionId) => {
    if (window.confirm('이 연결선을 삭제하시겠습니까?')) {
      const updatedConnections = connections.filter(conn => conn.id !== connectionId);
      onUpdateConnections(cellId, updatedConnections);
      setSelectedConnection(null);
    }
  };

  // 연결선 선택 핸들러
  const handleConnectionClick = (e, connectionId) => {
    e.stopPropagation();
    if (!globalConnecting) {
      setSelectedConnection(connectionId === selectedConnection ? null : connectionId);
      setSelectedProcess(null); // 연결선 선택 시 프로세스 선택 해제
    }
  };

  // 연결선 중점 계산 (삭제 버튼 위치용)
  const getConnectionMidPoint = (connection) => {
    const fromPos = getProcessEdgePoint(connection.from, connection.to);
    const toPos = getProcessEdgePoint(connection.to, connection.from);
    
    if (!fromPos || !toPos) return null;
    
    return {
      x: (fromPos.x + toPos.x) / 2,
      y: (fromPos.y + toPos.y) / 2
    };
  };

  // 연결선 렌더링 (로컬 연결만 - 글로벌 연결은 전역 레이어에서 처리)
  const renderConnections = () => {
    return connections.map(conn => {
      // 다른 셀로의 연결은 전역 레이어에서 처리하므로 여기서는 건너뛰기
      if (conn.targetCell) {
        return null;
      }
      
      // 같은 셀 내 연결만 렌더링 - edge point 사용
      const fromPos = getProcessEdgePoint(conn.from, conn.to);
      const toPos = getProcessEdgePoint(conn.to, conn.from);
      
      if (!fromPos || !toPos) return null;
      
      // 프로세스 위치 정보 가져오기
      const fromProcess = processes.find(p => p.id === conn.from);
      const toProcess = processes.find(p => p.id === conn.to);
      if (!fromProcess || !toProcess) return null;
      
      const fromCenterX = fromProcess.x + 120;
      const fromCenterY = fromProcess.y + 50;
      const toCenterX = toProcess.x + 120;
      const toCenterY = toProcess.y + 50;
      const dx = toCenterX - fromCenterX;
      const dy = toCenterY - fromCenterY;
      
      // edge에서 직각으로 나가는 거리 정의
      const orthogonalDistance = 30;
      
      let pathData;
      let arrowAngle;
      
      if (Math.abs(dx) > Math.abs(dy)) {
        // 수평 주 방향 연결
        if (dx > 0) {
          // 왼쪽에서 오른쪽으로
          const fromExtend = fromPos.x + orthogonalDistance;
          const toExtend = toPos.x - orthogonalDistance;
          pathData = `M ${fromPos.x} ${fromPos.y} L ${fromExtend} ${fromPos.y} L ${fromExtend} ${toPos.y} L ${toPos.x} ${toPos.y}`;
          arrowAngle = 0; // 오른쪽으로 (안쪽으로)
        } else {
          // 오른쪽에서 왼쪽으로
          const fromExtend = fromPos.x - orthogonalDistance;
          const toExtend = toPos.x + orthogonalDistance;
          pathData = `M ${fromPos.x} ${fromPos.y} L ${fromExtend} ${fromPos.y} L ${fromExtend} ${toPos.y} L ${toPos.x} ${toPos.y}`;
          arrowAngle = 180; // 왼쪽으로 (안쪽으로)
        }
      } else {
        // 수직 주 방향 연결
        if (dy > 0) {
          // 위에서 아래로
          const fromExtend = fromPos.y + orthogonalDistance;
          const toExtend = toPos.y - orthogonalDistance;
          pathData = `M ${fromPos.x} ${fromPos.y} L ${fromPos.x} ${fromExtend} L ${toPos.x} ${fromExtend} L ${toPos.x} ${toPos.y}`;
          arrowAngle = 90; // 아래쪽으로 (안쪽으로)
        } else {
          // 아래에서 위로
          const fromExtend = fromPos.y - orthogonalDistance;
          const toExtend = toPos.y + orthogonalDistance;
          pathData = `M ${fromPos.x} ${fromPos.y} L ${fromPos.x} ${fromExtend} L ${toPos.x} ${fromExtend} L ${toPos.x} ${toPos.y}`;
          arrowAngle = -90; // 위쪽으로 (안쪽으로)
        }
      }

      const isSelected = selectedConnection === conn.id;
      const strokeColor = isSelected ? '#dc2626' : '#6366f1';
      const strokeWidth = isSelected ? '4' : '3';
      
      return (
        <g key={conn.id}>
          <path
            d={pathData}
            stroke={strokeColor}
            strokeWidth={strokeWidth}
            fill="none"
            markerEnd={`url(#arrowhead-${cellId}-${conn.id})`}
            style={{ filter: isSelected ? 'drop-shadow(0 0 6px rgba(220, 38, 38, 0.6))' : 'none' }}
          />
          {/* 삭제 가능한 투명한 굵은 선 */}
          <path
            d={pathData}
            stroke="transparent"
            strokeWidth="15"
            fill="none"
            cursor="pointer"
            onClick={(e) => handleConnectionClick(e, conn.id)}
            onMouseEnter={(e) => {
              // 호버 시 연결선 강조
              const actualLine = e.target.previousElementSibling;
              if (actualLine) {
                actualLine.style.stroke = '#dc2626';
                actualLine.style.strokeWidth = '5';
                actualLine.style.filter = 'drop-shadow(0 0 6px rgba(220, 38, 38, 0.6))';
              }
            }}
            onMouseLeave={(e) => {
              // 호버 해제 시 원래 색상으로 복귀 (선택된 경우 제외)
              const actualLine = e.target.previousElementSibling;
              if (actualLine && !isSelected) {
                actualLine.style.stroke = '#6366f1';
                actualLine.style.strokeWidth = '3';
                actualLine.style.filter = 'none';
              }
            }}
            title="클릭하여 로컬 연결선 선택/삭제 (Delete 키 또는 버튼 클릭)"
          />
          {/* 각 연결마다 개별 마커 정의 */}
          <defs>
            <marker
              id={`arrowhead-${cellId}-${conn.id}`}
              markerWidth="8"
              markerHeight="6"
              refX="7"
              refY="3"
              orient={arrowAngle}
            >
              <polygon
                points="0 0, 8 3, 0 6"
                fill={strokeColor}
              />
            </marker>
          </defs>
        </g>
      );
    }).filter(Boolean); // null 값 제거
  };

  return (
    <>
      <ConnectionLine>
        {renderConnections()}
      </ConnectionLine>
      
      {/* 선택된 연결선의 삭제 버튼 */}
      {selectedConnection && !globalConnecting && connections.find(c => c.id === selectedConnection) && (() => {
        const selectedConn = connections.find(c => c.id === selectedConnection);
        const midPoint = getConnectionMidPoint(selectedConn);
        return midPoint ? (
          <ConnectionDeleteButton
            className="visible"
            style={{
              left: midPoint.x - 12,
              top: midPoint.y - 12
            }}
            onClick={() => handleDeleteConnection(selectedConnection)}
            title="연결선 삭제"
          >
            <X size={12} />
          </ConnectionDeleteButton>
        ) : null;
      })()}
      
      <HeaderActions>
        <AddProcessButton onClick={handleAddProcess}>
          <Plus size={16} />
        </AddProcessButton>
      </HeaderActions>
      
      {processes.map(process => (
        <ProcessBox
          key={process.id}
          selected={selectedProcess === process.id}
          style={{
            left: process.x,
            top: process.y,
            border: (connectingFrom && connectingFrom.cellId === cellId && connectingFrom.processId === process.id) 
                    ? '3px solid #ef4444' : undefined
          }}
          onMouseDown={(e) => handleMouseDown(e, process.id)}
          onClick={() => handleProcessClick(process.id)}
        >
          <div className="process-text">{process.text}</div>
          <div className="process-actions">
            <ActionButton onClick={() => handleEditProcess(process.id)}>
              <Edit3 size={16} />
            </ActionButton>
            <ActionButton 
              danger
              onClick={() => handleDeleteProcess(process.id)}
            >
              <Trash2 size={16} />
            </ActionButton>
          </div>
        </ProcessBox>
      ))}
      
      {processes.length === 0 && (
        <div style={{
          position: 'absolute',
          top: '50%',
          left: '50%',
          transform: 'translate(-50%, -50%)',
          color: '#9ca3af',
          fontSize: '16px',
          textAlign: 'center',
          fontWeight: '600'
        }}>
          + 프로세스 추가
        </div>
      )}
    </>
  );
};

export default ProcessCell;
