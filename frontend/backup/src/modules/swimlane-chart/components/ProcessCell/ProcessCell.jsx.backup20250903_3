import React, { useState, useRef, useEffect } from 'react';
import styled from 'styled-components';
import { Plus, Edit3, Trash2 } from 'lucide-react';

const ProcessBox = styled.div`
  position: absolute;
  background: ${props => props.selected ? '#dbeafe' : '#f9fafb'};
  border: 2px solid ${props => props.selected ? '#3b82f6' : '#d1d5db'};
  border-radius: 12px;
  padding: 20px;
  min-width: 240px;
  max-width: 360px;
  min-height: 100px;
  cursor: move;
  user-select: none;
  font-size: 16px;
  line-height: 1.5;
  z-index: 2;
  
  &:hover {
    border-color: #6366f1;
    box-shadow: 0 4px 16px rgba(99, 102, 241, 0.3);
  }
  
  .process-text {
    word-break: break-word;
    color: #374151;
    font-weight: 500;
    min-height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  
  .process-actions {
    display: none;
    position: absolute;
    top: -12px;
    right: -12px;
    gap: 4px;
  }
  
  &:hover .process-actions {
    display: flex;
  }
`;

const ActionButton = styled.button`
  width: 32px;
  height: 32px;
  padding: 0;
  border: none;
  border-radius: 6px;
  background: ${props => props.danger ? '#ef4444' : '#6366f1'};
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  
  &:hover {
    background: ${props => props.danger ? '#dc2626' : '#4f46e5'};
    transform: scale(1.05);
  }
`;

const ConnectionLine = styled.svg`
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
`;

const AddProcessButton = styled.button`
  position: absolute;
  top: 12px;
  right: 12px;
  width: 40px;
  height: 40px;
  border: none;
  border-radius: 50%;
  background: #e5e7eb;
  color: #111827;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  transition: all 0.2s ease;
  
  &:hover {
    background: #d1d5db;
    transform: scale(1.1);
  }
`;

const ConnectButton = styled.button`
  position: absolute;
  top: 12px;
  left: 12px;
  padding: 10px 16px;
  border: none;
  border-radius: 8px;
  background: ${props => props.active ? '#ef4444' : '#6366f1'};
  color: white;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  z-index: 3;
  
  &:hover {
    background: ${props => props.active ? '#dc2626' : '#4f46e5'};
    transform: translateY(-2px);
  }
`;

const ProcessCell = ({ 
  cellId,
  processes = [],
  connections = [],
  onAddProcess,
  onUpdateProcess,
  onDeleteProcess,
  onUpdateConnections,
  containerRef,
  globalConnecting = false,
  connectingFrom = null,
  onStartConnection,
  onEndConnection,
  onCancelConnection,
  allCellData = {}
}) => {
  const [selectedProcess, setSelectedProcess] = useState(null);
  const [isConnecting, setIsConnecting] = useState(false);
  const [localConnectingFrom, setLocalConnectingFrom] = useState(null);
  const [dragging, setDragging] = useState(null);
  
  const cellRef = containerRef || useRef(null);

  const handleAddProcess = () => {
    const text = prompt('프로세스 이름을 입력하세요:');
    if (text && text.trim()) {
      const newProcess = {
        id: Date.now(),
        text: text.trim(),
        x: 20,
        y: 30 + (processes.length * 140)
      };
      onAddProcess(cellId, newProcess);
    }
  };

  const handleEditProcess = (processId) => {
    const process = processes.find(p => p.id === processId);
    if (process) {
      const newText = prompt('프로세스 이름을 수정하세요:', process.text);
      if (newText && newText.trim()) {
        onUpdateProcess(cellId, processId, { ...process, text: newText.trim() });
      }
    }
  };

  const handleDeleteProcess = (processId) => {
    if (window.confirm('이 프로세스를 삭제하시겠습니까?')) {
      onDeleteProcess(cellId, processId);
      const newConnections = connections.filter(
        conn => conn.from !== processId && conn.to !== processId
      );
      onUpdateConnections(cellId, newConnections);
    }
  };

  const handleProcessClick = (processId) => {
    if (isConnecting || globalConnecting) {
      if (globalConnecting && connectingFrom) {
        // 글로벌 연결 모드 - 다른 셀에서 온 연결
        onEndConnection(cellId, processId);
      } else if (localConnectingFrom && localConnectingFrom !== processId) {
        // 로컬 연결 모드 - 같은 셀 내 연결
        const newConnection = {
          id: Date.now(),
          from: localConnectingFrom,
          to: processId
        };
        onUpdateConnections(cellId, [...connections, newConnection]);
        setIsConnecting(false);
        setLocalConnectingFrom(null);
      } else {
        // 연결 시작점 설정
        if (globalConnecting) {
          onStartConnection(cellId, processId);
        } else {
          setLocalConnectingFrom(processId);
        }
      }
    } else {
      setSelectedProcess(processId === selectedProcess ? null : processId);
    }
  };

  const handleMouseDown = (e, processId) => {
    if (isConnecting || globalConnecting) return;
    
    e.preventDefault();
    e.stopPropagation();
    setDragging(processId);
    setSelectedProcess(processId);
  };

  const handleMouseMove = (e) => {
    if (!dragging || !cellRef.current) return;
    
    const rect = cellRef.current.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    
    const process = processes.find(p => p.id === dragging);
    if (process) {
      onUpdateProcess(cellId, dragging, { 
        ...process, 
        x: Math.max(0, Math.min(x - 120, rect.width - 240)),
        y: Math.max(0, Math.min(y - 50, rect.height - 100))
      });
    }
  };

  const handleMouseUp = () => {
    setDragging(null);
  };

  useEffect(() => {
    if (dragging) {
      document.addEventListener('mousemove', handleMouseMove);
      document.addEventListener('mouseup', handleMouseUp);
      return () => {
        document.removeEventListener('mousemove', handleMouseMove);
        document.removeEventListener('mouseup', handleMouseUp);
      };
    }
  }, [dragging]);

  const getProcessCenter = (processId) => {
    const process = processes.find(p => p.id === processId);
    if (!process) return { x: 0, y: 0 };
    return {
      x: process.x + 120,
      y: process.y + 50
    };
  };

  // 다른 셀에서 프로세스 찾기
  const getProcessFromOtherCell = (targetCellId, processId) => {
    const targetCellData = allCellData[targetCellId];
    if (!targetCellData) return null;
    return targetCellData.processes.find(p => p.id === processId);
  };

  // 연결선 렌더링 (로컬 + 글로벌)
  const renderConnections = () => {
    return connections.map(conn => {
      let fromPos, toPos;
      
      if (conn.targetCell) {
        // 다른 셀로의 연결
        fromPos = getProcessCenter(conn.from);
        // 다른 셀로의 연결선은 셀 경계에서 끝남
        toPos = { x: cellRef.current?.offsetWidth || 0, y: fromPos.y };
      } else {
        // 같은 셀 내 연결
        fromPos = getProcessCenter(conn.from);
        toPos = getProcessCenter(conn.to);
      }
      
      const dx = toPos.x - fromPos.x;
      const dy = toPos.y - fromPos.y;
      const length = Math.sqrt(dx * dx + dy * dy);
      
      if (length === 0) return null;
      
      const unitX = dx / length;
      const unitY = dy / length;
      
      const startX = fromPos.x + unitX * 120;
      const startY = fromPos.y + unitY * 50;
      const endX = toPos.x - unitX * (conn.targetCell ? 0 : 120);
      const endY = toPos.y - unitY * (conn.targetCell ? 0 : 50);
      
      return (
        <g key={conn.id}>
          <line
            x1={startX}
            y1={startY}
            x2={endX}
            y2={endY}
            stroke={conn.targetCell ? "#ef4444" : "#6366f1"}
            strokeWidth="3"
            strokeDasharray={conn.targetCell ? "5,5" : "none"}
            markerEnd={`url(#arrowhead-${cellId})`}
          />
        </g>
      );
    });
  };

  // 연결 버튼 처리
  const handleConnectButtonClick = () => {
    if (globalConnecting) {
      // 글로벌 연결 취소
      onCancelConnection();
    } else if (isConnecting) {
      // 로컬 연결 취소
      setIsConnecting(false);
      setLocalConnectingFrom(null);
    } else {
      // 로컬 연결 시작
      setIsConnecting(true);
    }
  };

  return (
    <>
      <ConnectionLine>
        <defs>
          <marker
            id={`arrowhead-${cellId}`}
            markerWidth="10"
            markerHeight="7"
            refX="9"
            refY="3.5"
            orient="auto"
          >
            <polygon
              points="0 0, 10 3.5, 0 7"
              fill="#6366f1"
            />
          </marker>
        </defs>
        {renderConnections()}
      </ConnectionLine>
      
      <AddProcessButton onClick={handleAddProcess}>
        <span style={{ fontSize: '20px', fontWeight: 'bold', lineHeight: 1 }}>+</span>
      </AddProcessButton>
      
      <ConnectButton 
        active={isConnecting || globalConnecting}
        onClick={handleConnectButtonClick}
      >
        {globalConnecting ? '글로벌 연결 중' : isConnecting ? '취소' : '연결'}
      </ConnectButton>
      
      {processes.map(process => (
        <ProcessBox
          key={process.id}
          selected={selectedProcess === process.id}
          style={{
            left: process.x,
            top: process.y,
            border: (localConnectingFrom === process.id || 
                    (connectingFrom && connectingFrom.cellId === cellId && connectingFrom.processId === process.id)) 
                    ? '3px solid #ef4444' : undefined
          }}
          onMouseDown={(e) => handleMouseDown(e, process.id)}
          onClick={() => handleProcessClick(process.id)}
        >
          <div className="process-text">{process.text}</div>
          <div className="process-actions">
            <ActionButton onClick={() => handleEditProcess(process.id)}>
              <Edit3 size={16} />
            </ActionButton>
            <ActionButton 
              danger
              onClick={() => handleDeleteProcess(process.id)}
            >
              <Trash2 size={16} />
            </ActionButton>
          </div>
        </ProcessBox>
      ))}
      
      {processes.length === 0 && (
        <div style={{
          position: 'absolute',
          top: '50%',
          left: '50%',
          transform: 'translate(-50%, -50%)',
          color: '#9ca3af',
          fontSize: '16px',
          textAlign: 'center',
          fontWeight: '600'
        }}>
          + 프로세스 추가
        </div>
      )}
    </>
  );
};

export default ProcessCell;