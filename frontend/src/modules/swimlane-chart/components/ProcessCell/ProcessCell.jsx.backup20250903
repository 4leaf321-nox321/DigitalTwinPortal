import React, { useState, useRef, useEffect } from 'react';
import styled from 'styled-components';
import { Plus, Edit3, Trash2 } from 'lucide-react';

const ProcessBox = styled.div`
  position: absolute;
  background: ${props => props.selected ? '#dbeafe' : '#f9fafb'};
  border: 2px solid ${props => props.selected ? '#3b82f6' : '#d1d5db'};
  border-radius: 8px;
  padding: 8px;
  min-width: 80px;
  max-width: 120px;
  cursor: move;
  user-select: none;
  font-size: 12px;
  line-height: 1.3;
  z-index: 2;
  
  &:hover {
    border-color: #6366f1;
    box-shadow: 0 2px 4px rgba(99, 102, 241, 0.2);
  }
  
  .process-text {
    word-break: break-word;
    color: #374151;
    font-weight: 500;
  }
  
  .process-actions {
    display: none;
    position: absolute;
    top: -8px;
    right: -8px;
    gap: 2px;
  }
  
  &:hover .process-actions {
    display: flex;
  }
`;

const ActionButton = styled.button`
  width: 20px;
  height: 20px;
  padding: 0;
  border: none;
  border-radius: 4px;
  background: ${props => props.danger ? '#ef4444' : '#6366f1'};
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  
  &:hover {
    background: ${props => props.danger ? '#dc2626' : '#4f46e5'};
  }
`;

const ConnectionLine = styled.svg`
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
`;

const AddProcessButton = styled.button`
  position: absolute;
  top: 8px;
  right: 8px;
  width: 24px;
  height: 24px;
  border: none;
  border-radius: 50%;
  background: #10b981;
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  
  &:hover {
    background: #059669;
  }
`;

const ConnectButton = styled.button`
  position: absolute;
  top: 8px;
  left: 8px;
  padding: 4px 8px;
  border: none;
  border-radius: 4px;
  background: ${props => props.active ? '#ef4444' : '#6366f1'};
  color: white;
  font-size: 10px;
  cursor: pointer;
  z-index: 3;
  
  &:hover {
    background: ${props => props.active ? '#dc2626' : '#4f46e5'};
  }
`;

const ProcessCell = ({ 
  cellId,
  processes = [],
  connections = [],
  onAddProcess,
  onUpdateProcess,
  onDeleteProcess,
  onUpdateConnections,
  containerRef, // 부모 컨테이너 ref를 받음
  isConnecting: externalIsConnecting // 외부에서 연결 모드를 제어할 수도 있음
}) => {
  const [selectedProcess, setSelectedProcess] = useState(null);
  const [isConnecting, setIsConnecting] = useState(false);
  const [connectingFrom, setConnectingFrom] = useState(null);
  const [dragging, setDragging] = useState(null);
  
  // containerRef가 전달되면 사용, 아니면 내부 ref 사용 (호환성)
  const cellRef = containerRef || useRef(null);

  const handleAddProcess = () => {
    const text = prompt('프로세스 이름을 입력하세요:');
    if (text && text.trim()) {
      const newProcess = {
        id: Date.now(),
        text: text.trim(),
        x: 20,
        y: 20 + (processes.length * 60)
      };
      onAddProcess(cellId, newProcess);
    }
  };

  const handleEditProcess = (processId) => {
    const process = processes.find(p => p.id === processId);
    if (process) {
      const newText = prompt('프로세스 이름을 수정하세요:', process.text);
      if (newText && newText.trim()) {
        onUpdateProcess(cellId, processId, { ...process, text: newText.trim() });
      }
    }
  };

  const handleDeleteProcess = (processId) => {
    if (window.confirm('이 프로세스를 삭제하시겠습니까?')) {
      onDeleteProcess(cellId, processId);
      // 연결선도 함께 삭제
      const newConnections = connections.filter(
        conn => conn.from !== processId && conn.to !== processId
      );
      onUpdateConnections(cellId, newConnections);
    }
  };

  const handleProcessClick = (processId) => {
    if (isConnecting || externalIsConnecting) {
      if (connectingFrom && connectingFrom !== processId) {
        // 연결 생성
        const newConnection = {
          id: Date.now(),
          from: connectingFrom,
          to: processId
        };
        onUpdateConnections(cellId, [...connections, newConnection]);
        setIsConnecting(false);
        setConnectingFrom(null);
      } else {
        setConnectingFrom(processId);
      }
    } else {
      setSelectedProcess(processId === selectedProcess ? null : processId);
    }
  };

  const handleMouseDown = (e, processId) => {
    if (isConnecting || externalIsConnecting) return;
    
    e.preventDefault();
    e.stopPropagation(); // 상위 리사이징 핸들러와 충돌 방지
    setDragging(processId);
    setSelectedProcess(processId);
  };

  const handleMouseMove = (e) => {
    if (!dragging || !cellRef.current) return;
    
    const rect = cellRef.current.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    
    const process = processes.find(p => p.id === dragging);
    if (process) {
      onUpdateProcess(cellId, dragging, { 
        ...process, 
        x: Math.max(0, Math.min(x - 40, rect.width - 80)), 
        y: Math.max(0, Math.min(y - 20, rect.height - 40))
      });
    }
  };

  const handleMouseUp = () => {
    setDragging(null);
  };

  useEffect(() => {
    if (dragging) {
      document.addEventListener('mousemove', handleMouseMove);
      document.addEventListener('mouseup', handleMouseUp);
      return () => {
        document.removeEventListener('mousemove', handleMouseMove);
        document.removeEventListener('mouseup', handleMouseUp);
      };
    }
  }, [dragging]);

  const getProcessCenter = (processId) => {
    const process = processes.find(p => p.id === processId);
    if (!process) return { x: 0, y: 0 };
    return {
      x: process.x + 40, // 박스 중앙
      y: process.y + 20
    };
  };

  const renderConnections = () => {
    return connections.map(conn => {
      const fromPos = getProcessCenter(conn.from);
      const toPos = getProcessCenter(conn.to);
      
      // 화살표 방향 계산
      const dx = toPos.x - fromPos.x;
      const dy = toPos.y - fromPos.y;
      const length = Math.sqrt(dx * dx + dy * dy);
      
      if (length === 0) return null;
      
      const unitX = dx / length;
      const unitY = dy / length;
      
      // 박스 가장자리에서 시작/종료하도록 조정
      const startX = fromPos.x + unitX * 40;
      const startY = fromPos.y + unitY * 20;
      const endX = toPos.x - unitX * 40;
      const endY = toPos.y - unitY * 20;
      
      return (
        <g key={conn.id}>
          <line
            x1={startX}
            y1={startY}
            x2={endX}
            y2={endY}
            stroke="#6366f1"
            strokeWidth="2"
            markerEnd="url(#arrowhead)"
          />
        </g>
      );
    });
  };

  return (
    <>
      <ConnectionLine>
        <defs>
          <marker
            id={`arrowhead-${cellId}`} // 고유한 ID로 변경
            markerWidth="10"
            markerHeight="7"
            refX="9"
            refY="3.5"
            orient="auto"
          >
            <polygon
              points="0 0, 10 3.5, 0 7"
              fill="#6366f1"
            />
          </marker>
        </defs>
        {connections.map(conn => {
          const fromPos = getProcessCenter(conn.from);
          const toPos = getProcessCenter(conn.to);
          
          // 화살표 방향 계산
          const dx = toPos.x - fromPos.x;
          const dy = toPos.y - fromPos.y;
          const length = Math.sqrt(dx * dx + dy * dy);
          
          if (length === 0) return null;
          
          const unitX = dx / length;
          const unitY = dy / length;
          
          // 박스 가장자리에서 시작/종료하도록 조정
          const startX = fromPos.x + unitX * 40;
          const startY = fromPos.y + unitY * 20;
          const endX = toPos.x - unitX * 40;
          const endY = toPos.y - unitY * 20;
          
          return (
            <g key={conn.id}>
              <line
                x1={startX}
                y1={startY}
                x2={endX}
                y2={endY}
                stroke="#6366f1"
                strokeWidth="2"
                markerEnd={`url(#arrowhead-${cellId})`}
              />
            </g>
          );
        })}
      </ConnectionLine>
      
      <AddProcessButton onClick={handleAddProcess}>
        <Plus size={14} />
      </AddProcessButton>
      
      <ConnectButton 
        active={isConnecting}
        onClick={() => {
          setIsConnecting(!isConnecting);
          setConnectingFrom(null);
        }}
      >
        {isConnecting ? '취소' : '연결'}
      </ConnectButton>
      
      {processes.map(process => (
        <ProcessBox
          key={process.id}
          selected={selectedProcess === process.id}
          style={{
            left: process.x,
            top: process.y,
            border: connectingFrom === process.id ? '2px solid #ef4444' : undefined
          }}
          onMouseDown={(e) => handleMouseDown(e, process.id)}
          onClick={() => handleProcessClick(process.id)}
        >
          <div className="process-text">{process.text}</div>
          <div className="process-actions">
            <ActionButton onClick={() => handleEditProcess(process.id)}>
              <Edit3 size={10} />
            </ActionButton>
            <ActionButton 
              danger
              onClick={() => handleDeleteProcess(process.id)}
            >
              <Trash2 size={10} />
            </ActionButton>
          </div>
        </ProcessBox>
      ))}
      
      {processes.length === 0 && (
        <div style={{
          position: 'absolute',
          top: '50%',
          left: '50%',
          transform: 'translate(-50%, -50%)',
          color: '#9ca3af',
          fontSize: '12px',
          textAlign: 'center'
        }}>
          + 프로세스 추가
        </div>
      )}
    </>
  );
};

export default ProcessCell;