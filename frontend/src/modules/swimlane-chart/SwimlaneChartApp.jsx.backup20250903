import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import styled from 'styled-components';
import Header from './components/Layout/Header';
import SwimlaneChart from './components/SwimlaneChart/SwimlaneChart';

const AppContainer = styled.div`
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f9fafb;
`;

const MainContent = styled.main`
  flex: 1;
  padding: 20px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
`;

const ChartWrapper = styled.div`
  flex: 1;
  min-height: 0;
`;

const SwimlaneChartApp = () => {
  const navigate = useNavigate();
  
  // 상태 관리
  const [organizations, setOrganizations] = useState([
    { id: 1, name: '마케팅팀' },
    { id: 2, name: '개발팀' },
    { id: 3, name: '품질팀' }
  ]);
  
  const [steps, setSteps] = useState([
    { id: 1, name: '1단계' },
    { id: 2, name: '2단계' },
    { id: 3, name: '3단계' },
    { id: 4, name: '4단계' }
  ]);
  
  const [cellData, setCellData] = useState({
    '1-1': {
      processes: [
        { id: 1, text: '시장 조사', x: 20, y: 20 },
        { id: 2, text: '경쟁사 분석', x: 20, y: 80 }
      ],
      connections: [
        { id: 1, from: 1, to: 2 }
      ]
    },
    '2-1': {
      processes: [
        { id: 3, text: '요구사항 수집', x: 20, y: 20 }
      ],
      connections: []
    },
    '2-2': {
      processes: [
        { id: 4, text: '시스템 설계', x: 20, y: 20 },
        { id: 5, text: 'DB 설계', x: 20, y: 80 }
      ],
      connections: [
        { id: 2, from: 4, to: 5 }
      ]
    }
  });

  // 이벤트 핸들러들
  const handleGoHome = () => {
    navigate('/');
  };

  const handleAddOrganization = () => {
    const name = prompt('새 조직 이름을 입력하세요:');
    if (name && name.trim()) {
      const newOrg = {
        id: Date.now(),
        name: name.trim()
      };
      setOrganizations(prev => [...prev, newOrg]);
    }
  };

  const handleAddStep = () => {
    const nextStepNumber = steps.length + 1;
    const newStep = {
      id: Date.now(),
      name: `${nextStepNumber}단계`
    };
    setSteps(prev => [...prev, newStep]);
  };

  const handleLoadSample = () => {
    // 샘플 데이터 로드
    setOrganizations([
      { id: 1, name: '기획팀' },
      { id: 2, name: '디자인팀' },
      { id: 3, name: '개발팀' },
      { id: 4, name: '테스트팀' },
      { id: 5, name: '운영팀' }
    ]);
    
    setSteps([
      { id: 1, name: '1단계' },
      { id: 2, name: '2단계' },
      { id: 3, name: '3단계' },
      { id: 4, name: '4단계' },
      { id: 5, name: '5단계' }
    ]);
    
    setCellData({
      '1-1': {
        processes: [
          { id: 1, text: '요구사항 정의', x: 20, y: 20 },
          { id: 2, text: '기능 명세서', x: 20, y: 80 }
        ],
        connections: [
          { id: 1, from: 1, to: 2 }
        ]
      },
      '2-1': {
        processes: [
          { id: 3, text: '사용자 스토리', x: 20, y: 20 }
        ],
        connections: []
      },
      '2-2': {
        processes: [
          { id: 4, text: 'UI/UX 디자인', x: 20, y: 20 },
          { id: 5, text: '프로토타입', x: 20, y: 80 }
        ],
        connections: [
          { id: 2, from: 4, to: 5 }
        ]
      },
      '3-2': {
        processes: [
          { id: 6, text: '프론트엔드', x: 20, y: 20 },
          { id: 7, text: '백엔드', x: 120, y: 20 },
          { id: 8, text: '통합 테스트', x: 70, y: 80 }
        ],
        connections: [
          { id: 3, from: 6, to: 8 },
          { id: 4, from: 7, to: 8 }
        ]
      },
      '3-3': {
        processes: [
          { id: 9, text: '개발 구현', x: 20, y: 20 },
          { id: 10, text: '코드 리뷰', x: 20, y: 80 }
        ],
        connections: [
          { id: 5, from: 9, to: 10 }
        ]
      },
      '4-3': {
        processes: [
          { id: 11, text: '코드 리뷰', x: 20, y: 20 }
        ],
        connections: []
      },
      '4-4': {
        processes: [
          { id: 12, text: '테스트 계획', x: 20, y: 20 },
          { id: 13, text: '테스트 실행', x: 20, y: 80 }
        ],
        connections: [
          { id: 6, from: 12, to: 13 }
        ]
      },
      '5-4': {
        processes: [
          { id: 14, text: '품질 검증', x: 20, y: 20 }
        ],
        connections: []
      },
      '5-5': {
        processes: [
          { id: 15, text: '배포', x: 20, y: 20 },
          { id: 16, text: '모니터링', x: 20, y: 80 }
        ],
        connections: [
          { id: 7, from: 15, to: 16 }
        ]
      }
    });
  };

  const handleEditOrganization = (orgId) => {
    const org = organizations.find(o => o.id === orgId);
    if (org) {
      const newName = prompt('조직 이름을 수정하세요:', org.name);
      if (newName && newName.trim()) {
        setOrganizations(prev => 
          prev.map(o => o.id === orgId ? { ...o, name: newName.trim() } : o)
        );
      }
    }
  };

  const handleDeleteOrganization = (orgId) => {
    if (organizations.length <= 1) {
      alert('최소 하나의 조직은 있어야 합니다.');
      return;
    }
    
    if (window.confirm('이 조직을 삭제하시겠습니까?')) {
      setOrganizations(prev => prev.filter(o => o.id !== orgId));
      
      // 해당 조직의 모든 셀 데이터 삭제
      setCellData(prev => {
        const newCellData = { ...prev };
        Object.keys(newCellData).forEach(key => {
          if (key.endsWith(`-${orgId}`)) {
            delete newCellData[key];
          }
        });
        return newCellData;
      });
    }
  };

  const handleEditStep = (stepId) => {
    const step = steps.find(s => s.id === stepId);
    if (step) {
      const newName = prompt('단계 이름을 수정하세요:', step.name);
      if (newName && newName.trim()) {
        setSteps(prev => 
          prev.map(s => s.id === stepId ? { ...s, name: newName.trim() } : s)
        );
      }
    }
  };

  const handleDeleteStep = (stepId) => {
    if (steps.length <= 1) {
      alert('최소 하나의 단계는 있어야 합니다.');
      return;
    }
    
    if (window.confirm('이 단계를 삭제하시겠습니까?')) {
      setSteps(prev => prev.filter(s => s.id !== stepId));
      
      // 해당 단계의 모든 셀 데이터 삭제
      setCellData(prev => {
        const newCellData = { ...prev };
        Object.keys(newCellData).forEach(key => {
          if (key.startsWith(`${stepId}-`)) {
            delete newCellData[key];
          }
        });
        return newCellData;
      });
    }
  };

  const handleUpdateCellData = (cellId, data) => {
    setCellData(prev => ({
      ...prev,
      [cellId]: data
    }));
  };

  return (
    <AppContainer>
      <Header
        onGoHome={handleGoHome}
        onAddStep={handleAddStep}
        onAddOrganization={handleAddOrganization}
        onLoadSample={handleLoadSample}
        stepsCount={steps.length}
        organizationsCount={organizations.length}
      />
      
      <MainContent>
        <ChartWrapper>
          <SwimlaneChart
            organizations={organizations}
            steps={steps}
            cellData={cellData}
            onAddOrganization={handleAddOrganization}
            onEditOrganization={handleEditOrganization}
            onDeleteOrganization={handleDeleteOrganization}
            onAddStep={handleAddStep}
            onEditStep={handleEditStep}
            onDeleteStep={handleDeleteStep}
            onUpdateCellData={handleUpdateCellData}
          />
        </ChartWrapper>
      </MainContent>
    </AppContainer>
  );
};

export default SwimlaneChartApp;
