const AddProjectModal = ({ isOpen, onClose, onSubmit, currentYear }) => {
  const [formData, setFormData] = useState({
    사업부: '',
    부문: '',
    과제구분: '',
    과제명: '',
    성과목록: [{ 성과구분: '', 경영성과: '' }],
    시작: 1,
    종료: 12,
    진행상태: '미착수',
    담당부서: '',
    과제참여인력: '',
    과제PL: '',
    비고: ''
  });

  const [errors, setErrors] = useState({});

  // 모달 열림/닫힘시 body 스크롤 제어
  useEffect(() => {
    if (isOpen) {
      // 모달이 열릴 때 body 스크롤 방지
      const originalStyle = window.getComputedStyle(document.body).overflow;
      document.body.style.overflow = 'hidden';
      
      return () => {
        // 모달이 닫힐 때 body 스크롤 복원
        document.body.style.overflow = originalStyle;
      };
    }
  }, [isOpen]);

  // 기본 설정 데이터에서 드롭다운 옵션 추출 (고정값)
  const 사업부Options = settingsData.divisions.map(division => division.name);
  const 부문Options = settingsData.categories.map(category => category.name);
  const 과제구분Options = settingsData.taskCategories.map(taskCategory => taskCategory.name);
  const 진행상태Options = settingsData.statuses.map(status => status.name);
  const 성과구분Options = settingsData.objectives.map(objective => objective.name);

  const monthOptions = Array.from({ length: 12 }, (_, i) => ({
    value: i + 1,
    label: `${i + 1}월`
  }));

  const handleInputChange = (e) => {
    const { name, value } = e.target;
    setFormData(prev => ({
      ...prev,
      [name]: value
    }));
    
    // 에러 클리어
    if (errors[name]) {
      setErrors(prev => ({
        ...prev,
        [name]: null
      }));
    }
  };

  // 성과 관련 함수들
  const handlePerformanceChange = (index, field, value) => {
    const newPerformances = [...formData.성과목록];
    newPerformances[index][field] = value;
    setFormData(prev => ({
      ...prev,
      성과목록: newPerformances
    }));
    
    // 에러 클리어
    const errorKey = `성과목록_${index}_${field}`;
    if (errors[errorKey]) {
      setErrors(prev => ({
        ...prev,
        [errorKey]: null
      }));
    }
  };

  const addPerformance = () => {
    if (formData.성과목록.length < 3) {
      setFormData(prev => ({
        ...prev,
        성과목록: [...prev.성과목록, { 성과구분: '', 경영성과: '' }]
      }));
    }
  };

  const removePerformance = (index) => {
    if (formData.성과목록.length > 1) {
      const newPerformances = formData.성과목록.filter((_, i) => i !== index);
      setFormData(prev => ({
        ...prev,
        성과목록: newPerformances
      }));
      
      // 해당 인덱스의 에러 제거
      const newErrors = { ...errors };
      Object.keys(newErrors).forEach(key => {
        if (key.startsWith(`성과목록_${index}_`)) {
          delete newErrors[key];
        }
      });
      setErrors(newErrors);
    }
  };

  const validateForm = () => {
    const newErrors = {};
    
    if (!formData.사업부) newErrors.사업부 = '사업부를 선택해주세요.';
    if (!formData.부문) newErrors.부문 = '부문을 선택해주세요.';
    if (!formData.과제구분) newErrors.과제구분 = '과제 구분을 선택해주세요.';
    if (!formData.과제명.trim()) newErrors.과제명 = '과제명을 입력해주세요.';
    
    // 성과 목록 검증
    formData.성과목록.forEach((performance, index) => {
      if (!performance.성과구분) {
        newErrors[`성과목록_${index}_성과구분`] = '성과구분을 선택해주세요.';
      }
      if (!performance.경영성과.trim()) {
        newErrors[`성과목록_${index}_경영성과`] = '경영성과를 입력해주세요.';
      }
    });
    
    // 담당부서 및 담당자 유효성 검사 (쉼표로 구분된 값 고려)
    const deptValues = formData.담당부서.split(',').map(dept => dept.trim()).filter(dept => dept.length > 0);
    const assigneeValues = formData.과제참여인력.split(',').map(person => person.trim()).filter(person => person.length > 0);
    
    if (deptValues.length === 0) newErrors.담당부서 = '담당부서를 입력해주세요.';
    if (assigneeValues.length === 0) newErrors.과제참여인력 = '과제 참여 인력을 입력해주세요.';
    if (!formData.과제PL.trim()) newErrors.과제PL = '과제 PL을 입력해주세요.';
    
    if (formData.종료 < formData.시작) {
      newErrors.종료 = '종료월은 시작월보다 늦어야 합니다.';
    }
    
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    
    if (!validateForm()) {
      return;
    }
    
    // 담당부서와 담당자를 쉼표로 분리하여 배열로 변환
    const processedData = {
      ...formData,
      담당부서: formData.담당부서.split(',').map(dept => dept.trim()).filter(dept => dept.length > 0),
      담당자: formData.과제참여인력.split(',').map(person => person.trim()).filter(person => person.length > 0)
    };
    
    const newProject = {
      ...processedData,
      id: Date.now(), // 임시 ID
      과제년도: currentYear,
      관리자: formData.과제PL,
      시작: parseInt(formData.시작),
      종료: parseInt(formData.종료),
      // 하위 호환성을 위해 첫 번째 성과를 기본 필드로 설정
      성과구분: formData.성과목록[0]?.성과구분 || '',
      경영성과: formData.성과목록[0]?.경영성과 || '',
      // 새로운 구조도 유지
      성과목록: formData.성과목록
    };
    
    console.log('새 과제 데이터:', newProject);
    onSubmit(newProject);
    handleClose();
  };

  const handleClose = () => {
    setFormData({
      사업부: '',
      부문: '',
      과제구분: '',
      과제명: '',
      성과목록: [{ 성과구분: '', 경영성과: '' }],
      시작: 1,
      종료: 12,
      진행상태: '미착수',
      담당부서: '',
      과제참여인력: '',
      과제PL: '',
      비고: ''
    });
    setErrors({});
    onClose();
  };

  if (!isOpen) return null;

  return (
    <AnimatePresence>
      <ModalOverlay
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        onClick={(e) => {
          if (e.target === e.currentTarget) {
            handleClose();
          }
        }}
      >
        <ModalContainer
          initial={{ opacity: 0, scale: 0.9, y: 20 }}
          animate={{ opacity: 1, scale: 1, y: 0 }}
          exit={{ opacity: 0, scale: 0.9, y: 20 }}
          transition={{ type: "spring", damping: 25, stiffness: 500 }}
        >
          <ModalHeader>
            <div className="title">
              <Plus size={20} />
              새 과제 추가 ({currentYear}년)
            </div>
            <button className="close-btn" onClick={handleClose}>
              <X size={18} />
            </button>
          </ModalHeader>

          <form onSubmit={handleSubmit}>
            <ModalBody>
              <HorizontalSectionsContainer>
                {/* 기본정보 섹션 */}
                <SectionContainer>
                  <SectionTitle>
                    <Building size={16} />
                    기본정보
                  </SectionTitle>
                  
                  <FormGroup>
                    <Label>
                      <Building size={16} />
                      사업부 <span className="required">*</span>
                    </Label>
                    <Select
                      name="사업부"
                      value={formData.사업부}
                      onChange={handleInputChange}
                      required
                    >
                      <option value="">사업부 선택</option>
                      {사업부Options.map(option => (
                        <option key={option} value={option}>{option}</option>
                      ))}
                    </Select>
                    {errors.사업부 && <ErrorMessage>{errors.사업부}</ErrorMessage>}
                  </FormGroup>

                  <FormGroup>
                    <Label>부문 <span className="required">*</span></Label>
                    <Select
                      name="부문"
                      value={formData.부문}
                      onChange={handleInputChange}
                      required
                    >
                      <option value="">부문 선택</option>
                      {부문Options.map(option => (
                        <option key={option} value={option}>{option}</option>
                      ))}
                    </Select>
                    {errors.부문 && <ErrorMessage>{errors.부문}</ErrorMessage>}
                  </FormGroup>

                  <FormGroup>
                    <Label>과제 구분 <span className="required">*</span></Label>
                    <Select
                      name="과제구분"
                      value={formData.과제구분}
                      onChange={handleInputChange}
                      required
                    >
                      <option value="">과제 구분 선택</option>
                      {과제구분Options.map(option => (
                        <option key={option} value={option}>{option}</option>
                      ))}
                    </Select>
                    {errors.과제구분 && <ErrorMessage>{errors.과제구분}</ErrorMessage>}
                  </FormGroup>

                  <FormGroup>
                    <Label>
                      <FileText size={16} />
                      과제명 <span className="required">*</span>
                    </Label>
                    <Input
                      type="text"
                      name="과제명"
                      value={formData.과제명}
                      onChange={handleInputChange}
                      placeholder="과제명을 입력하세요"
                      required
                    />
                    {errors.과제명 && <ErrorMessage>{errors.과제명}</ErrorMessage>}
                  </FormGroup>

                  <FormGroup>
                    <Label>
                      <FileText size={16} />
                      진행상태
                    </Label>
                    <Select
                      name="진행상태"
                      value={formData.진행상태}
                      onChange={handleInputChange}
                    >
                      {진행상태Options.map(option => (
                        <option key={option} value={option}>{option}</option>
                      ))}
                    </Select>
                  </FormGroup>

                  <FormGroup>
                    <Label>
                      <Calendar size={16} />
                      진행 기간
                    </Label>
                    <DateRangeContainer>
                      <Select
                        name="시작"
                        value={formData.시작}
                        onChange={handleInputChange}
                      >
                        {monthOptions.map(({ value, label }) => (
                          <option key={value} value={value}>{label} 시작</option>
                        ))}
                      </Select>
                      <Select
                        name="종료"
                        value={formData.종료}
                        onChange={handleInputChange}
                      >
                        {monthOptions.map(({ value, label }) => (
                          <option key={value} value={value}>{label} 종료</option>
                        ))}
                      </Select>
                    </DateRangeContainer>
                    {errors.종료 && <ErrorMessage>{errors.종료}</ErrorMessage>}
                  </FormGroup>
                </SectionContainer>

                {/* 과제 성과 섹션 */}
                <SectionContainer>
                  <SectionTitle>
                    <Target size={16} />
                    과제 성과
                  </SectionTitle>
                  
                  <PerformanceContainer>
                    {formData.성과목록.map((performance, index) => (
                      <div key={index}>
                        <PerformanceRow>
                          <Select
                            value={performance.성과구분}
                            onChange={(e) => handlePerformanceChange(index, '성과구분', e.target.value)}
                            required
                          >
                            <option value="">성과 대분류 선택</option>
                            {성과구분Options.map(option => (
                              <option key={option} value={option}>{option}</option>
                            ))}
                          </Select>
                          
                          <Input
                            type="text"
                            value={performance.경영성과}
                            onChange={(e) => handlePerformanceChange(index, '경영성과', e.target.value)}
                            placeholder="예: 5PM, 1.5억 등"
                            required
                          />
                          
                          <RemoveButton
                            type="button"
                            onClick={() => removePerformance(index)}
                            disabled={formData.성과목록.length === 1}
                            title="성과 삭제"
                          >
                            ×
                          </RemoveButton>
                        </PerformanceRow>
                        
                        {/* 에러 메시지 표시 */}
                        {(errors[`성과목록_${index}_성과구분`] || errors[`성과목록_${index}_경영성과`]) && (
                          <div style={{ marginTop: '0.5rem' }}>
                            {errors[`성과목록_${index}_성과구분`] && (
                              <ErrorMessage>{errors[`성과목록_${index}_성과구분`]}</ErrorMessage>
                            )}
                            {errors[`성과목록_${index}_경영성과`] && (
                              <ErrorMessage>{errors[`성과목록_${index}_경영성과`]}</ErrorMessage>
                            )}
                          </div>
                        )}
                      </div>
                    ))}
                    
                    {formData.성과목록.length < 3 && (
                      <AddButton
                        type="button"
                        onClick={addPerformance}
                      >
                        <Plus size={16} />
                        성과 추가
                      </AddButton>
                    )}
                  </PerformanceContainer>
                </SectionContainer>

                {/* 담당자 섹션 */}
                <SectionContainer>
                  <SectionTitle>
                    <User size={16} />
                    담당자
                  </SectionTitle>
                  
                  <FormGroup>
                    <Label>
                      <Building size={16} />
                      담당부서 <span className="required">*</span>
                      <small style={{fontSize: '0.75rem', color: '#6b7280', fontWeight: 400, marginLeft: '0.25rem'}}>(콤마로 구분)</small>
                    </Label>
                    <Input
                      type="text"
                      name="담당부서"
                      value={formData.담당부서}
                      onChange={handleInputChange}
                      placeholder="담당부서를 입력하세요 (예: Mecha Solution(VD), Mecha 1Lab(VD))"
                      required
                    />
                    {formData.담당부서 && (
                      <div style={{fontSize: '0.75rem', color: '#059669', marginTop: '0.25rem'}}>
                        확인: {formData.담당부서.split(',').map(dept => dept.trim()).filter(dept => dept.length > 0).length}개 부서
                      </div>
                    )}
                    {errors.담당부서 && <ErrorMessage>{errors.담당부서}</ErrorMessage>}
                  </FormGroup>

                  <FormGroup>
                    <Label>
                      <User size={16} />
                      과제 참여 인력 <span className="required">*</span>
                      <small style={{fontSize: '0.75rem', color: '#6b7280', fontWeight: 400, marginLeft: '0.25rem'}}>(콤마로 구분)</small>
                    </Label>
                    <Input
                      type="text"
                      name="과제참여인력"
                      value={formData.과제참여인력}
                      onChange={handleInputChange}
                      placeholder="과제 참여 인력을 입력하세요 (예: 남규현, 박용진)"
                      required
                    />
                    {formData.과제참여인력 && (
                      <div style={{fontSize: '0.75rem', color: '#059669', marginTop: '0.25rem'}}>
                        확인: {formData.과제참여인력.split(',').map(person => person.trim()).filter(person => person.length > 0).length}명
                      </div>
                    )}
                    {errors.과제참여인력 && <ErrorMessage>{errors.과제참여인력}</ErrorMessage>}
                  </FormGroup>

                  <FormGroup>
                    <Label>
                      <ShieldCheck size={16} />
                      과제 PL <span className="required">*</span>
                    </Label>
                    <Input
                      type="text"
                      name="과제PL"
                      value={formData.과제PL}
                      onChange={handleInputChange}
                      placeholder="과제 PL 이름을 입력하세요"
                      required
                    />
                    {errors.과제PL && <ErrorMessage>{errors.과제PL}</ErrorMessage>}
                  </FormGroup>
                </SectionContainer>
              </HorizontalSectionsContainer>

              {/* 비고 섹션 - 별도로 배치 */}
              <RemarksSection>
                <SectionTitle>
                  <FileText size={16} />
                  비고
                </SectionTitle>
                
                <FormGroup>
                  <TextArea
                    name="비고"
                    value={formData.비고}
                    onChange={handleInputChange}
                    placeholder="추가 설명이나 참고사항을 입력하세요 (선택사항)&#10;&#10;예시:&#10;- 프로젝트의 특별한 요구사항&#10;- 리스크 요소&#10;- 협력 부서와의 조율 사항&#10;- 예산 관련 주의사항&#10;- 일정상 중요한 마일스톤&#10;- 기타 중요 사항들을 자세히 기록하세요..."
                  />
                </FormGroup>
              </RemarksSection>

              {/* 스크롤 테스트용 추가 섹션들 */}
              <TestSection>
                <h4>🔍 스크롤 테스트 섹션 1</h4>
                <p>이 섹션은 모달 내부에 스크롤이 생기는지 테스트하기 위한 용도입니다. 브라우저 창을 축소하거나 확대해보세요.</p>
              </TestSection>

              <TestSection>
                <h4>🔍 스크롤 테스트 섹션 2</h4>
                <p>스크롤바가 보이시나요? 오른쪽에 녹색 스크롤바가 나타나야 합니다. 마우스 휠이나 터치로 스크롤해보세요.</p>
              </TestSection>

              <TestSection>
                <h4>🔍 스크롤 테스트 섹션 3</h4>
                <p>더 많은 내용을 추가해서 스크롤이 필요한 상황을 만들었습니다. 이제 스크롤이 잘 작동하는지 확인해보세요!</p>
              </TestSection>

              <TestSection>
                <h4>🔍 스크롤 테스트 섹션 4</h4>
                <p>마지막 테스트 섹션입니다. 여기까지 스크롤이 되었다면 성공적으로 작동하고 있는 것입니다!</p>
              </TestSection>
            </ModalBody>

            <ModalFooter>
              <Button type="button" className="secondary" onClick={handleClose}>
                취소
              </Button>
              <Button type="submit" className="primary">
                <Save size={16} />
                과제 추가
              </Button>
            </ModalFooter>
          </form>
        </ModalContainer>
      </ModalOverlay>
    </AnimatePresence>
  );
};

export default AddProjectModal;