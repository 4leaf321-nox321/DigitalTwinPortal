import React, { useState, useEffect } from 'react';
import { AnimatePresence } from 'framer-motion';

// 기본 설정 데이터 직접 import
import { settingsData } from '../../data/sampleData';

// 컴포넌트들 import
import ModalLayout from './components/ModalLayout';
import BasicInfoSection from './components/BasicInfoSection';
import ResponsibleInfoSection from './components/ResponsibleInfoSection';
import PerformanceSection from './components/PerformanceSection';
import RemarksSection from './components/RemarksSection';

// 상수들 import
import { 
  UNIT_OPTIONS, 
  SUBCATEGORY_OPTIONS, 
  INITIAL_FORM_DATA, 
  INITIAL_PERFORMANCE_INPUT 
} from './constants/formConstants';

// 유틸리티 함수들 import
import { 
  validateForm, 
  processFormData, 
  resetFormData,
  validatePerformanceInput,
  validateNumericInput
} from './utils/formUtils';

const AddProjectModal = ({ isOpen, onClose, onSubmit, currentYear }) => {
  const [formData, setFormData] = useState(INITIAL_FORM_DATA);
  const [performanceInput, setPerformanceInput] = useState(INITIAL_PERFORMANCE_INPUT);
  const [errors, setErrors] = useState({});

  // 모달 열림/닫힘시 body 스크롤 제어
  useEffect(() => {
    if (isOpen) {
      const originalStyle = window.getComputedStyle(document.body).overflow;
      document.body.style.overflow = 'hidden';
      
      return () => {
        document.body.style.overflow = originalStyle;
      };
    }
  }, [isOpen]);

  // 기본 설정 데이터에서 드롭다운 옵션 추출
  const 사업부Options = settingsData.divisions.map(division => division.name);
  const 부문Options = settingsData.categories.map(category => category.name);
  const 과제구분Options = settingsData.taskCategories.map(taskCategory => taskCategory.name);
  const 진행상태Options = settingsData.statuses.map(status => status.name);

  const monthOptions = Array.from({ length: 12 }, (_, i) => ({
    value: i + 1,
    label: `${i + 1}월`
  }));

  const handleInputChange = (e) => {
    const { name, value } = e.target;
    setFormData(prev => ({
      ...prev,
      [name]: value
    }));
    
    // 에러 클리어
    if (errors[name]) {
      setErrors(prev => ({
        ...prev,
        [name]: null
      }));
    }
  };

  // 성과 입력 필드 변경 처리 (모든 문자 입력 가능)
  const handlePerformanceInputChange = (field, value) => {
    // 성과항목 필드의 경우 모든 문자 허용
    if (field === '성과항목') {
      value = validatePerformanceInput(value);
    }
    // 목표치, 실적치 필드의 경우 숫자만 허용
    else if (field.includes('수준')) {
      value = validateNumericInput(value);
    }

    setPerformanceInput(prev => {
      const newState = { ...prev, [field]: value };
      // 대분류가 바뀌면 소분류와 단위 초기화
      if (field === '대분류') {
        newState.소분류 = '';
        newState.단위 = '';
      }
      return newState;
    });
  };

  // 성과 리스트에 추가
  const addPerformanceToList = () => {
    if (performanceInput.대분류 && performanceInput.소분류 && performanceInput.성과항목 && 
        performanceInput.현재수준 && performanceInput.목표수준 && performanceInput.단위) {
      const newPerformance = {
        대분류: performanceInput.대분류,
        소분류: performanceInput.소분류,
        성과항목: performanceInput.성과항목,
        현재수준: performanceInput.현재수준,
        목표수준: performanceInput.목표수준,
        실적수준: performanceInput.실적수준 || '', // 선택사항이므로 빈 문자열로 처리
        단위: performanceInput.단위
      };
      
      setFormData(prev => ({
        ...prev,
        성과목록: [...prev.성과목록, newPerformance]
      }));
      
      // 입력 필드 초기화
      setPerformanceInput(INITIAL_PERFORMANCE_INPUT);
    }
  };

  // 성과 리스트에서 제거
  const removePerformanceFromList = (index) => {
    setFormData(prev => ({
      ...prev,
      성과목록: prev.성과목록.filter((_, i) => i !== index)
    }));
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    
    const validationErrors = validateForm(formData);
    if (Object.keys(validationErrors).length > 0) {
      setErrors(validationErrors);
      return;
    }
    
    const newProject = processFormData(formData, currentYear);
    console.log('새 과제 데이터:', newProject);
    onSubmit(newProject);
    handleClose();
  };

  const handleClose = () => {
    resetFormData(setFormData, setPerformanceInput, setErrors);
    onClose();
  };

  if (!isOpen) return null;

  const modalProps = {
    handleClose,
    currentYear,
    handleSubmit
  };

  const basicInfoProps = {
    formData,
    handleInputChange,
    errors,
    사업부Options,
    부문Options,
    과제구분Options,
    진행상태Options,
    monthOptions
  };

  const responsibleInfoProps = {
    formData,
    handleInputChange,
    errors
  };

  const performanceProps = {
    performanceInput,
    handlePerformanceInputChange,
    addPerformanceToList,
    formData,
    removePerformanceFromList,
    errors,
    UNIT_OPTIONS,
    SUBCATEGORY_OPTIONS
  };

  const remarksProps = {
    formData,
    handleInputChange
  };

  return (
    <AnimatePresence>
      <ModalLayout {...modalProps}>
        <BasicInfoSection {...basicInfoProps} />
        <ResponsibleInfoSection {...responsibleInfoProps} />
        <PerformanceSection {...performanceProps} />
        <RemarksSection {...remarksProps} />
      </ModalLayout>
    </AnimatePresence>
  );
};

export default AddProjectModal;
