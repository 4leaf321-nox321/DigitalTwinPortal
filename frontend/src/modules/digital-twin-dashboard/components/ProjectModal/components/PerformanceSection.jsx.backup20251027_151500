const PerformanceSection = ({ 
  performanceInput, 
  handlePerformanceInputChange, 
  addPerformanceToList, 
  formData, 
  removePerformanceFromList, 
  errors, 
  UNIT_OPTIONS, 
  SUBCATEGORY_OPTIONS,
  settingsData
}) => {
  // 설정에서 받아온 성과 분류 데이터
  const performanceCategories = settingsData?.performanceCategories || [];
  const performanceSubcategories = settingsData?.performanceSubcategories || [];
  const performanceItems = settingsData?.performanceItems || [];
  
  // 선택된 대분류에 따른 소분류 필터링
  const getSubcategoriesForCategory = (categoryId) => {
    return performanceSubcategories.filter(sub => sub.categoryId === categoryId);
  };
  
  // 선택된 소분류에 따른 성과 항목 필터링
  const getItemsForSubcategory = (subcategoryId) => {
    return performanceItems.filter(item => item.subcategoryId === subcategoryId);
  };
  
  // 대분류 ID로 대분류 이름 찾기
  const getCategoryName = (categoryId) => {
    const category = performanceCategories.find(cat => cat.id === categoryId);
    return category ? category.name : categoryId;
  };
  
  // 소분류 ID로 소분류 이름 찾기
  const getSubcategoryName = (subcategoryId) => {
    const subcategory = performanceSubcategories.find(sub => sub.id === subcategoryId);
    return subcategory ? subcategory.name : subcategoryId;
  };
  
  // 성과 항목 ID로 성과 항목 이름 찾기
  const getItemName = (itemId) => {
    const item = performanceItems.find(item => item.id === itemId);
    return item ? item.name : itemId;
  };
  
  // 성과 항목 ID로 단위 찾기
  const getItemUnit = (itemId) => {
    const item = performanceItems.find(item => item.id === itemId);
    return item ? item.unit : '';
  };

  // 성과 항목 ID로 수준 값들 찾기
  const getItemLevels = (itemId) => {
    const item = performanceItems.find(item => item.id === itemId);
    return item ? {
      currentLevel: item.currentLevel || '',
      targetLevel: item.targetLevel || '',
      actualLevel: item.actualLevel || ''
    } : {
      currentLevel: '',
      targetLevel: '',
      actualLevel: ''
    };
  };
  
  // 대분류 변경 시 소분류 및 성과 항목 초기화
  const handleCategoryChange = (categoryId) => {
    handlePerformanceInputChange('대분류ID', categoryId);
    handlePerformanceInputChange('소분류ID', '');
    handlePerformanceInputChange('성과항목ID', '');
    handlePerformanceInputChange('단위', '');
    handlePerformanceInputChange('현재수준', '');
    handlePerformanceInputChange('목표수준', '');
    handlePerformanceInputChange('실적수준', '');
  };
  
  // 소분류 변경 시 성과 항목 초기화
  const handleSubcategoryChange = (subcategoryId) => {
    handlePerformanceInputChange('소분류ID', subcategoryId);
    handlePerformanceInputChange('성과항목ID', '');
    handlePerformanceInputChange('단위', '');
    handlePerformanceInputChange('현재수준', '');
    handlePerformanceInputChange('목표수준', '');
    handlePerformanceInputChange('실적수준', '');
  };
  
  // 성과 항목 변경 시 자동으로 단위와 수준 값들 설정
  const handleItemChange = (itemId) => {
    handlePerformanceInputChange('성과항목ID', itemId);
    const unit = getItemUnit(itemId);
    const levels = getItemLevels(itemId);
    
    handlePerformanceInputChange('단위', unit);
    handlePerformanceInputChange('현재수준', levels.currentLevel);
    handlePerformanceInputChange('목표수준', levels.targetLevel);
    handlePerformanceInputChange('실적수준', levels.actualLevel);
  };
  
  // 숫자 입력 핸들러 (목표치, 실적치용)
  const handleNumericValueChange = (field, value) => {
    const validatedValue = validateNumericInput ? validateNumericInput(value) : value;
    handlePerformanceInputChange(field, validatedValue);
  };

  // 성과 기여도 입력 핸들러 (퍼센트 전용)
  const handleContributionValueChange = (value) => {
    const validatedValue = validateContributionInput ? validateContributionInput(value) : value;
    handlePerformanceInputChange('과제기여도', validatedValue);
  };

  // 성과 입력 필드에서 엔터 키 핸들러
  const handlePerformanceKeyDown = (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      if (performanceInput.대분류ID && performanceInput.소분류ID && performanceInput.성과항목ID && 
          performanceInput.과제기여도 && performanceInput.현재수준 && performanceInput.목표수준 && performanceInput.단위) {
        addPerformanceToList();
      }
    }
  };

  return (
    <RemarksSection>
      <SectionTitle>
        <Target size={16} />
        과제 성과
      </SectionTitle>
      
      <PerformanceContainer>
        {/* 성과 입력 영역 */}
        <div>
          <Label>성과 입력</Label>
          <PerformanceInputContainer>
            {/* 첫 번째 줄: 대분류, 소분류, 성과 항목 */}
            <div className="input-row">
              <div>
                <Label>대분류 <span className="required">*</span></Label>
                <Select
                  value={performanceInput.대분류ID || ''}
                  onChange={(e) => handleCategoryChange(e.target.value)}
                  onKeyDown={handlePerformanceKeyDown}
                >
                  <option value="">대분류 선택</option>
                  {performanceCategories.map(category => (
                    <option key={category.id} value={category.id}>{category.name}</option>
                  ))}
                </Select>
              </div>
              
              <div>
                <Label>소분류 <span className="required">*</span></Label>
                <Select
                  value={performanceInput.소분류ID || ''}
                  onChange={(e) => handleSubcategoryChange(e.target.value)}
                  onKeyDown={handlePerformanceKeyDown}
                  disabled={!performanceInput.대분류ID}
                >
                  <option value="">소분류 선택</option>
                  {performanceInput.대분류ID && getSubcategoriesForCategory(performanceInput.대분류ID).map(subcategory => (
                    <option key={subcategory.id} value={subcategory.id}>{subcategory.name}</option>
                  ))}
                </Select>
              </div>
              
              <div>
                <Label>성과 항목 <span className="required">*</span></Label>
                <Select
                  value={performanceInput.성과항목ID || ''}
                  onChange={(e) => handleItemChange(e.target.value)}
                  onKeyDown={handlePerformanceKeyDown}
                  disabled={!performanceInput.소분류ID}
                >
                  <option value="">성과 항목 선택</option>
                  {performanceInput.소분류ID && getItemsForSubcategory(performanceInput.소분류ID).map(item => (
                    <option key={item.id} value={item.id}>{item.name}</option>
                  ))}
                </Select>
              </div>
            </div>

            {/* 두 번째 줄: 성과 기여도, 단위, 현재 수준, 목표 수준, 실적 수준 */}
            <div className="metrics-row">
              <div>
                <Label>성과 기여도 <span className="required">*</span></Label>
                <PercentInputContainer>
                  <Input
                    type="text"
                    value={performanceInput.과제기여도 || ''}
                    onChange={(e) => handleContributionValueChange(e.target.value)}
                    onKeyDown={handlePerformanceKeyDown}
                    placeholder="0~100"
                    title="0부터 100까지 숫자만 입력 가능합니다"
                  />
                  <span className="percent-symbol">%</span>
                </PercentInputContainer>
              </div>
              
              <div>
                <Label>단위 <span className="required">*</span></Label>
                <Input
                  type="text"
                  value={performanceInput.단위 || ''}
                  onChange={(e) => handlePerformanceInputChange('단위', e.target.value)}
                  onKeyDown={handlePerformanceKeyDown}
                  placeholder="예: hours, %, 억원, ppm"
                  disabled={!!performanceInput.성과항목ID}
                  title={performanceInput.성과항목ID ? "성과 항목에서 자동으로 설정됩니다" : "단위를 입력하세요"}
                />
              </div>
              
              <div>
                <Label>현재 수준 <span className="required">*</span></Label>
                <Input
                  type="text"
                  value={performanceInput.현재수준 || ''}
                  onChange={(e) => handleNumericValueChange('현재수준', e.target.value)}
                  onKeyDown={handlePerformanceKeyDown}
                  placeholder="현재 수준 입력"
                  title={performanceInput.성과항목ID ? "성과 항목에서 자동으로 설정됩니다 (수정 가능)" : "숫자만 입력 가능합니다"}
                />
              </div>
              
              <div>
                <Label>목표 수준 <span className="required">*</span></Label>
                <Input
                  type="text"
                  value={performanceInput.목표수준 || ''}
                  onChange={(e) => handleNumericValueChange('목표수준', e.target.value)}
                  onKeyDown={handlePerformanceKeyDown}
                  placeholder="목표 수준 입력"
                  title={performanceInput.성과항목ID ? "성과 항목에서 자동으로 설정됩니다 (수정 가능)" : "숫자만 입력 가능합니다"}
                />
              </div>
              
              <div>
                <Label>실적 수준</Label>
                <Input
                  type="text"
                  value={performanceInput.실적수준 || ''}
                  onChange={(e) => handleNumericValueChange('실적수준', e.target.value)}
                  onKeyDown={handlePerformanceKeyDown}
                  placeholder="실적 수준 입력 (선택사항)"
                  title={performanceInput.성과항목ID ? "성과 항목에서 자동으로 설정됩니다 (수정 가능)" : "숫자만 입력 가능합니다"}
                />
              </div>
            </div>

            {/* 버튼 행 */}
            <div className="button-row">
              <AddButton
                type="button"
                onClick={addPerformanceToList}
                disabled={!performanceInput.대분류ID || !performanceInput.소분류ID || !performanceInput.성과항목ID || 
                         !performanceInput.과제기여도 || !performanceInput.현재수준 || !performanceInput.목표수준 || !performanceInput.단위}
              >
                <Plus size={16} />
                추가
              </AddButton>
            </div>
          </PerformanceInputContainer>
        </div>
        
        {/* 성과 목록 */}
        {formData.성과목록 && formData.성과목록.length > 0 && (
          <div>
            <Label>등록된 성과 ({formData.성과목록.length}개)</Label>
            <PerformanceList>
              {formData.성과목록.map((performance, index) => (
                <PerformanceItem key={index}>
                  <div className="performance-info">
                    <div className="main-category">{getCategoryName(performance.대분류ID || performance.대분류)}</div>
                    <div className="sub-category">{getSubcategoryName(performance.소분류ID || performance.소분류)}</div>
                    <div className="performance-text">{getItemName(performance.성과항목ID) || performance.성과항목}</div>
                    <div className="metrics-info">
                      <div className="level-info">
                        <span className="label">성과 기여도: </span>{performance.과제기여도}% | 
                        <span className="label"> 현재: </span>{performance.현재수준} {performance.단위} | 
                        <span className="label"> 목표: </span>{performance.목표수준} {performance.단위}
                        {performance.실적수준 && (
                          <>
                            <span className="label"> | 실적: </span>{performance.실적수준} {performance.단위}
                          </>
                        )}
                      </div>
                    </div>
                  </div>
                  <RemoveButton
                    type="button"
                    onClick={() => removePerformanceFromList(index)}
                    title="성과 삭제"
                  >
                    ×
                  </RemoveButton>
                </PerformanceItem>
              ))}
            </PerformanceList>
          </div>
        )}
        
        {errors.성과목록 && <ErrorMessage>{errors.성과목록}</ErrorMessage>}
      </PerformanceContainer>
    </RemarksSection>
  );
};

export default PerformanceSection;