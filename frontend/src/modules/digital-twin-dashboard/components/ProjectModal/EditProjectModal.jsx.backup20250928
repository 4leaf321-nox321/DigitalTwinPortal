import styled from 'styled-components';
import { motion, AnimatePresence } from 'framer-motion';
import { 
  X, 
  Calendar, 
  Building, 
  Target, 
  User, 
  ShieldCheck, 
  FileText, 
  TrendingUp,
  Edit3,
  Save
} from 'lucide-react';

