const PerformanceTreemap = ({ projects, divisionColors, statusColors }) => {
  const [selectedFilter, setSelectedFilter] = useState('전체');
  const [tooltip, setTooltip] = useState(null);

  // 성과 데이터 분석
  const performanceData = useMemo(() => {
    if (!projects || projects.length === 0) {
      return {};
    }

    const data = {};
    let totalPerformances = 0;
    
    projects.forEach(project => {
      const division = project.사업부 || 'Unknown';
      
      if (!data[division]) {
        data[division] = {
          categories: {},
          total: 0
        };
      }
      
      // 각 프로젝트의 성과목록을 순회
      (project.성과목록 || []).forEach(performance => {
        const 대분류 = performance.대분류 || '기타';
        const 소분류 = performance.소분류 || '기타';
        
        if (!data[division].categories[대분류]) {
          data[division].categories[대분류] = {
            subcategories: {},
            total: 0
          };
        }
        
        if (!data[division].categories[대분류].subcategories[소분류]) {
          data[division].categories[대분류].subcategories[소분류] = [];
        }
        
        data[division].categories[대분류].subcategories[소분류].push({
          projectId: project.id,
          projectName: project.과제명,
          performanceItem: performance.성과항목,
          contribution: performance.과제기여도,
          current: performance.현재수준,
          target: performance.목표수준,
          actual: performance.실적수준,
          unit: performance.단위,
          status: project.진행상태,
          division: project.사업부
        });
        
        data[division].categories[대분류].total++;
        data[division].total++;
        totalPerformances++;
      });
    });
    
    return { data, totalPerformances };
  }, [projects]);

  // 필터 옵션 생성
  const filterOptions = useMemo(() => {
    if (!performanceData.data) return ['전체'];
    const divisions = sortDivisions(Object.keys(performanceData.data));
    return ['전체', ...divisions];
  }, [performanceData]);

  // 필터링된 데이터
  const filteredData = useMemo(() => {
    if (!performanceData.data) return {};
    if (selectedFilter === '전체') {
      return performanceData.data;
    }
    return { [selectedFilter]: performanceData.data[selectedFilter] || { categories: {}, total: 0 } };
  }, [performanceData, selectedFilter]);

  // 통계 계산
  const stats = useMemo(() => {
    const categories = Object.keys(filteredData);
    const totalCategories = categories.length;
    let totalSubcategories = 0;
    let totalPerformances = 0;
    
    categories.forEach(category => {
      const categoryData = filteredData[category];
      totalSubcategories += Object.keys(categoryData.subcategories).length;
      totalPerformances += categoryData.total;
    });
    
    return {
      categories: totalCategories,
      subcategories: totalSubcategories,
      performances: totalPerformances
    };
  }, [filteredData]);

  // 트리맵 레이아웃 계산 (대분류-소분류 단순화)
  const treemapLayout = useMemo(() => {
    const categories = Object.keys(filteredData);
    if (categories.length === 0) return [];
    
    const containerWidth = 100;
    const containerHeight = 100;
    
    // 각 대분류의 성과 개수로 크기 계산
    const categorySizes = categories.map(category => ({
      category,
      size: filteredData[category].total
    }));
    
    const totalSize = categorySizes.reduce((sum, c) => sum + c.size, 0);
    if (totalSize === 0) return [];
    
    // 대분류 레이아웃 (행 우선 배치)
    const layout = [];
    let currentY = 0;
    
    categorySizes.forEach(({ category, size }) => {
      const categoryRatio = size / totalSize;
      const categoryHeight = Math.max(categoryRatio * containerHeight, 25); // 최소 높이 보장
      
      const categoryData = filteredData[category];
      const subcategories = Object.keys(categoryData.subcategories);
      
      const subcategoryLayouts = [];
      let currentX = 0;
      
      // 대분류 제목 공간 (3%)
      const categoryTitleSpace = 3;
      
      subcategories.forEach(subcategory => {
        const projects = categoryData.subcategories[subcategory];
        const subRatio = projects.length / size;
        const subWidth = Math.max(subRatio * containerWidth, 20); // 최소 너비 보장
        
        subcategoryLayouts.push({
          subcategory,
          count: projects.length,
          projects,
          x: currentX,
          y: currentY + categoryTitleSpace,
          width: subWidth,
          height: categoryHeight - categoryTitleSpace
        });
        
        currentX += subWidth;
      });
      
      layout.push({
        category,
        subcategories: subcategoryLayouts,
        x: 0,
        y: currentY,
        width: containerWidth,
        height: categoryHeight
      });
      
      currentY += categoryHeight;
    });
    
    return layout;
  }, [filteredData]);

  const handleMouseEnter = (e, item) => {
    const contribution = item.contribution ? `${item.contribution}%` : 'N/A';
    const target = item.target || 'N/A';
    const actual = item.actual || 'N/A';
    const unit = item.unit || '';
    
    setTooltip({
      x: e.clientX,
      y: e.clientY,
      content: `프로젝트: ${item.projectName}
성과항목: ${item.performanceItem}
기여도: ${contribution}
목표: ${target} ${unit}
실적: ${actual} ${unit}
상태: ${item.status}`
    });
  };

  const handleMouseLeave = () => {
    setTooltip(null);
  };

  // 대분류별 색상 정의
  const getCategoryColors = () => {
    return {
      '리드타임단축': {
        primary: '#1e40af', // 더 진한 파란색
        light: '#dbeafe',
        dark: '#1e3a8a'
      },
      '비용절감': {
        primary: '#047857', // 더 진한 초록색
        light: '#d1fae5',
        dark: '#064e3b'
      },
      '품질향상': {
        primary: '#d97706', // 더 진한 주황색
        light: '#fef3c7',
        dark: '#92400e'
      },
      '기술혁신': {
        primary: '#7c3aed', // 더 진한 보라색
        light: '#ede9fe',
        dark: '#5b21b6'
      },
      '기타': {
        primary: '#374151', // 더 진한 회색
        light: '#f3f4f6',
        dark: '#1f2937'
      }
    };
  };

  // 색상 생성 함수들
  const getCategoryColor = (category) => {
    const colors = getCategoryColors();
    return colors[category] || colors['기타'];
  };

  const getSubcategoryColor = (category, subcategoryIndex, totalSubcategories) => {
    const categoryColors = getCategoryColor(category);
    // 소분류는 대분류와 같은 계통의 진한 색상 사용
    
    // 기본 색상의 HSL 값 추출
    const hex = categoryColors.primary.replace('#', '');
    const r = parseInt(hex.substr(0, 2), 16) / 255;
    const g = parseInt(hex.substr(2, 2), 16) / 255;
    const b = parseInt(hex.substr(4, 2), 16) / 255;
    
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    const diff = max - min;
    
    let h = 0;
    if (diff !== 0) {
      if (max === r) h = ((g - b) / diff) % 6;
      else if (max === g) h = (b - r) / diff + 2;
      else h = (r - g) / diff + 4;
    }
    h = Math.round(h * 60);
    if (h < 0) h += 360;
    
    const l = (max + min) / 2;
    const s = diff === 0 ? 0 : diff / (1 - Math.abs(2 * l - 1));
    
    // 진한 색상 사용 (명도 40-50% 범위)
    const lightnessStep = 10 / Math.max(totalSubcategories, 1);
    const lightness = 50 - (subcategoryIndex * lightnessStep); // 50%에서 시작해서 점점 어둡게
    
    return {
      background: `hsl(${h}, ${Math.round(s * 90)}%, ${Math.max(lightness, 40)}%)`,
      border: `hsl(${h}, ${Math.round(s * 100)}%, ${Math.max(lightness - 10, 25)}%)`
    };
  };

  const getProjectColor = (category, subcategoryIndex, projectIndex, totalSubcategories, totalProjects) => {
    const categoryColors = getCategoryColor(category);
    
    // 기본 색상의 HSL 값 추출
    const hex = categoryColors.primary.replace('#', '');
    const r = parseInt(hex.substr(0, 2), 16) / 255;
    const g = parseInt(hex.substr(2, 2), 16) / 255;
    const b = parseInt(hex.substr(4, 2), 16) / 255;
    
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    const diff = max - min;
    
    let h = 0;
    if (diff !== 0) {
      if (max === r) h = ((g - b) / diff) % 6;
      else if (max === g) h = (b - r) / diff + 2;
      else h = (r - g) / diff + 4;
    }
    h = Math.round(h * 60);
    if (h < 0) h += 360;
    
    const l = (max + min) / 2;
    const s = diff === 0 ? 0 : diff / (1 - Math.abs(2 * l - 1));
    
    // 소분류 기반 명도와 프로젝트 인덱스 기반 채도 조절
    const baseSubcategoryLightness = 85 - (subcategoryIndex * (20 / Math.max(totalSubcategories, 1)));
    const projectLightness = baseSubcategoryLightness - (projectIndex * 5); // 프로젝트별로 5%씩 더 어둡게
    const projectSaturation = Math.min(s * 70 + (projectIndex * 10), 90); // 프로젝트별로 채도 증가
    
    return `hsl(${h}, ${Math.round(projectSaturation)}%, ${Math.max(projectLightness, 30)}%)`;
  };

  // 텍스트 색상 결정 함수 (배경색이 어두우면 흰색, 밝으면 검은색)
  const getTextColor = (backgroundColor) => {
    // HSL 색상에서 명도 값 추출
    const hslMatch = backgroundColor.match(/hsl\(\d+,\s*\d+%,\s*(\d+)%\)/);
    if (hslMatch) {
      const lightness = parseInt(hslMatch[1]);
      return lightness > 60 ? '#374151' : '#ffffff';
    }
    return '#374151'; // 기본값
  };

  // 테두리 색상 결정 함수
  const getBorderColor = (backgroundColor) => {
    const hslMatch = backgroundColor.match(/hsl\((\d+),\s*(\d+)%,\s*(\d+)%\)/);
    if (hslMatch) {
      const h = parseInt(hslMatch[1]);
      const s = parseInt(hslMatch[2]);
      const l = Math.max(parseInt(hslMatch[3]) - 20, 10); // 20% 더 어둡게
      return `hsl(${h}, ${s}%, ${l}%)`;
    }
    return '#d1d5db'; // 기본값
  };

  // 데이터가 없는 경우
  if (!performanceData.data || Object.keys(performanceData.data).length === 0) {
    return (
      <Container
        initial={{ opacity: 0, scale: 0.95 }}
        animate={{ opacity: 1, scale: 1 }}
        transition={{ duration: 0.5 }}
      >
        <Title>사업부별 성과 분류 현황</Title>
        <EmptyState>
          <div className="icon">📊</div>
          <div className="message">
            분석할 성과 데이터가 없습니다.<br />
            프로젝트에 성과를 추가해보세요.
          </div>
        </EmptyState>
      </Container>
    );
  }

  return (
    <Container
      initial={{ opacity: 0, scale: 0.95 }}
      animate={{ opacity: 1, scale: 1 }}
      transition={{ duration: 0.5 }}
    >
      <Title>사업부별 성과 분류 현황</Title>
      
      <FilterTabs>
        {filterOptions.map(option => (
          <FilterTab
            key={option}
            active={selectedFilter === option}
            onClick={() => setSelectedFilter(option)}
          >
            {option}
          </FilterTab>
        ))}
      </FilterTabs>
      
      <TreemapContainer>
        {treemapLayout.map((categoryLayout) => {
          const categoryColors = getCategoryColor(categoryLayout.category);
          
          return (
            <CategoryBlock
              key={categoryLayout.category}
              style={{
                left: `${categoryLayout.x}%`,
                top: `${categoryLayout.y}%`,
                width: `${categoryLayout.width}%`,
                height: `${categoryLayout.height}%`
              }}
              bgColor={categoryColors.light}
              borderColor={categoryColors.dark}
            >
              <CategoryTitle bgColor={categoryColors.primary}>
                {categoryLayout.category}
              </CategoryTitle>
              
              {categoryLayout.subcategories.map((subLayout, subcategoryIndex) => {
                const subcategoryColors = getSubcategoryColor(categoryLayout.category, subcategoryIndex, categoryLayout.subcategories.length);
                
                return (
                  <SubcategoryBlock
                    key={subLayout.subcategory}
                    style={{
                      left: `${(subLayout.x - categoryLayout.x) / categoryLayout.width * 100}%`,
                      top: `${(subLayout.y - categoryLayout.y) / categoryLayout.height * 100}%`,
                      width: `${subLayout.width / categoryLayout.width * 100}%`,
                      height: `${subLayout.height / categoryLayout.height * 100}%`
                    }}
                    bgColor={subcategoryColors.background}
                    borderColor={subcategoryColors.border}
                    onMouseEnter={(e) => {
                      setTooltip({
                        x: e.clientX,
                        y: e.clientY,
                        content: `${subLayout.subcategory}\n성과 개수: ${subLayout.count}개\n관련 프로젝트: ${subLayout.projects.map(p => p.projectName).join(', ')}`
                      });
                    }}
                    onMouseLeave={handleMouseLeave}
                    title={`${subLayout.subcategory} - ${subLayout.count}개 성과`}
                  >
                    <SubcategoryTitle bgColor={subcategoryColors.border}>
                      {subLayout.subcategory}
                    </SubcategoryTitle>
                    <SubcategoryCount>
                      {subLayout.count}
                    </SubcategoryCount>
                  </SubcategoryBlock>
                );
              })}
            </CategoryBlock>
          );
        })}
      </TreemapContainer>
      
      <Legend>
        {Object.entries(getCategoryColors()).map(([category, colors]) => (
          <LegendItem key={category}>
            <LegendColor 
              color={colors.primary} 
              borderColor={colors.dark}
            />
            <span>{category}</span>
          </LegendItem>
        ))}
      </Legend>
      
      <StatsPanel>
        <StatItem>
          <StatValue color="#8b5cf6">{stats.categories}</StatValue>
          <StatLabel>대분류</StatLabel>
        </StatItem>
        <StatItem>
          <StatValue color="#f59e0b">{stats.subcategories}</StatValue>
          <StatLabel>소분류</StatLabel>
        </StatItem>
        <StatItem>
          <StatValue color="#10b981">{stats.performances}</StatValue>
          <StatLabel>총 성과</StatLabel>
        </StatItem>
      </StatsPanel>
      
      {tooltip && (
        <Tooltip
          style={{
            left: tooltip.x + 10,
            top: tooltip.y - 10
          }}
        >
          {tooltip.content}
        </Tooltip>
      )}
    </Container>
  );
};

export default PerformanceTreemap;