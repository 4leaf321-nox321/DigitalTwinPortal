import React, { useState } from 'react';
import { X, Download, FileText, Database, BarChart3, Check, Info, ChevronRight, Target, AlertCircle } from 'lucide-react';
import { 
  exportProjectsToJSON, 
  exportProjectsToCSV,
  EXPORT_MODES,
  EXPORT_MODE_DESCRIPTIONS
} from '../../utils/importExportUtils';

const ExportDataModal = ({ 
  isOpen, 
  onClose, 
  projects = [],
  onExportComplete 
}) => {
  const [exportFormat, setExportFormat] = useState('csv');
  const [csvMode, setCsvMode] = useState(EXPORT_MODES.MULTI_TABLE);
  const [isExporting, setIsExporting] = useState(false);
  const [exportStatus, setExportStatus] = useState(null); // 'success' | 'error'
  const [error, setError] = useState('');

  const handleExport = async () => {
    if (!projects || projects.length === 0) {
      setError('내보낼 프로젝트 데이터가 없습니다.');
      return;
    }

    try {
      setIsExporting(true);
      setError('');
      setExportStatus(null);

      const filename = `digital-twin-dashboard-${exportFormat === 'json' ? 'data' : `${csvMode}-csv`}`;

      if (exportFormat === 'json') {
        await exportProjectsToJSON(projects, filename);
      } else {
        await exportProjectsToCSV(projects, filename, csvMode);
      }

      setExportStatus('success');
      
      // 부모 컴포넌트에 완료 알림
      if (onExportComplete) {
        onExportComplete({
          format: exportFormat,
          mode: csvMode,
          projectCount: projects.length
        });
      }

      // 1.5초 후 모달 닫기
      setTimeout(() => {
        handleClose();
      }, 1500);

    } catch (err) {
      setError(err.message);
      setExportStatus('error');
    } finally {
      setIsExporting(false);
    }
  };

  const handleClose = () => {
    setExportFormat('csv');
    setCsvMode(EXPORT_MODES.MULTI_TABLE);
    setIsExporting(false);
    setExportStatus(null);
    setError('');
    onClose();
  };

  const getProjectStats = () => {
    if (!projects || projects.length === 0) {
      return {
        totalProjects: 0,
        totalPerformances: 0,
        totalActionItems: 0,
        totalTeamMembers: 0,
        avgPerformancePerProject: 0,
        avgActionItemsPerProject: 0,
        avgTeamMembersPerProject: 0
      };
    }

    const totalPerformances = projects.reduce((sum, p) => sum + (p.성과목록?.length || 0), 0);
    const totalActionItems = projects.reduce((sum, p) => sum + (p.액션아이템목록?.length || 0), 0);
    const totalTeamMembers = projects.reduce((sum, p) => sum + (p.과제참여인력목록?.length || 0), 0);

    return {
      totalProjects: projects.length,
      totalPerformances,
      totalActionItems,
      totalTeamMembers,
      avgPerformancePerProject: Math.round(totalPerformances / projects.length * 10) / 10,
      avgActionItemsPerProject: Math.round(totalActionItems / projects.length * 10) / 10,
      avgTeamMembersPerProject: Math.round(totalTeamMembers / projects.length * 10) / 10
    };
  };

  const stats = getProjectStats();

  const getEstimatedFileSize = () => {
    if (!projects || projects.length === 0) return '0 KB';

    // 대략적인 파일 크기 계산
    const avgProjectSize = exportFormat === 'json' ? 2000 : 800; // bytes per project
    const totalSize = projects.length * avgProjectSize;

    if (exportFormat === 'csv' && csvMode === EXPORT_MODES.MULTI_TABLE) {
      // 4테이블 방식은 테이블 수만큼 증가
      const multiplier = 4; // PROJECTS, PERFORMANCES, ACTION_ITEMS, TEAM_MEMBERS
      return `~${Math.round(totalSize * multiplier / 1024)} KB`;
    }

    return `~${Math.round(totalSize / 1024)} KB`;
  };

  const renderFormatOption = (format, icon, title, description) => (
    <label className={`format-option ${exportFormat === format ? 'selected' : ''}`}>
      <input
        type="radio"
        name="exportFormat"
        value={format}
        checked={exportFormat === format}
        onChange={(e) => setExportFormat(e.target.value)}
      />
      <div className="format-content">
        <div className="format-header">
          {icon}
          <span className="format-title">{title}</span>
        </div>
        <p className="format-description">{description}</p>
      </div>
    </label>
  );

  const renderCSVModeOption = (mode) => {
    const config = EXPORT_MODE_DESCRIPTIONS[mode];
    return (
      <label key={mode} className={`csv-mode-option ${csvMode === mode ? 'selected' : ''}`}>
        <input
          type="radio"
          name="csvMode"
          value={mode}
          checked={csvMode === mode}
          onChange={(e) => setCsvMode(e.target.value)}
        />
        <div className="csv-mode-content">
          <div className="csv-mode-header">
            <span className="mode-icon">{config.icon}</span>
            <span className="mode-title">{config.name}</span>
          </div>
          <p className="mode-description">{config.description}</p>
          <div className="mode-pros-cons">
            <div className="pros">
              <strong>장점:</strong>
              <ul>
                {config.pros.map((pro, index) => (
                  <li key={index}>{pro}</li>
                ))}
              </ul>
            </div>
            {config.cons.length > 0 && (
              <div className="cons">
                <strong>주의:</strong>
                <ul>
                  {config.cons.map((con, index) => (
                    <li key={index}>{con}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </label>
    );
  };

  if (!isOpen) return null;

  return (
    <div className="modal-overlay">
      <div className="modal-container export-modal">
        <div className="modal-header">
          <h2>데이터 내보내기</h2>
          <button className="close-button" onClick={handleClose}>
            <X size={24} />
          </button>
        </div>

        <div className="modal-content">
          {exportStatus === 'success' ? (
            <div className="export-success">
              <div className="success-icon">
                <Check size={48} />
              </div>
              <h3>내보내기 완료!</h3>
              <p>
                {exportFormat === 'json' ? 'JSON' : 'CSV'} 파일이 성공적으로 저장되었습니다.
                {exportFormat === 'csv' && csvMode === EXPORT_MODES.MULTI_TABLE && (
                  <>
                    <br />
                    <small>🎯 Excel 편집에 최적화된 4테이블 분리 형태로 저장되었습니다</small>
                  </>
                )}
              </p>
            </div>
          ) : (
            <>
              {/* 프로젝트 통계 */}
              <div className="data-stats">
                <h3>내보낼 데이터 현황</h3>
                <div className="stats-grid">
                  <div className="stat-item">
                    <span className="stat-value">{stats.totalProjects}</span>
                    <span className="stat-label">프로젝트</span>
                  </div>
                  <div className="stat-item">
                    <span className="stat-value">{stats.totalPerformances}</span>
                    <span className="stat-label">성과 항목</span>
                  </div>
                  <div className="stat-item">
                    <span className="stat-value">{stats.totalActionItems}</span>
                    <span className="stat-label">액션아이템</span>
                  </div>
                  <div className="stat-item">
                    <span className="stat-value">{getEstimatedFileSize()}</span>
                    <span className="stat-label">예상 크기</span>
                  </div>
                </div>
              </div>

              {/* 파일 형식 선택 */}
              <div className="format-selection">
                <h3>파일 형식 선택</h3>
                <div className="format-options">
                  {renderFormatOption(
                    'json',
                    <Database size={24} />,
                    'JSON 형식',
                    '완전한 데이터 구조를 보존하는 형식입니다. 시스템 간 데이터 이동에 최적화되어 있습니다.'
                  )}
                  {renderFormatOption(
                    'csv',
                    <BarChart3 size={24} />,
                    'CSV 형식',
                    'Excel 등 스프레드시트 프로그램에서 열 수 있는 형식입니다. 데이터 분석에 적합합니다.'
                  )}
                </div>
              </div>

              {/* CSV 모드 선택 (CSV 선택 시에만 표시) */}
              {exportFormat === 'csv' && (
                <div className="csv-mode-selection">
                  <h3>
                    <Target size={20} />
                    CSV 저장 방식 선택
                  </h3>
                  <div className="csv-mode-options">
                    {Object.values(EXPORT_MODES).map(mode => renderCSVModeOption(mode))}
                  </div>
                  
                  {csvMode === EXPORT_MODES.MULTI_TABLE && (
                    <div className="multi-table-explanation">
                      <div className="explanation-header">
                        <Info size={16} />
                        <span>4테이블 분리 방식 상세 설명</span>
                      </div>
                      <div className="explanation-content">
                        <p>하나의 CSV 파일 안에 4개 섹션으로 분리하여 저장하는 방식입니다:</p>
                        <ul>
                          <li><strong>[PROJECTS]:</strong> 기본 프로젝트 정보 (중복 없음)</li>
                          <li><strong>[PERFORMANCES]:</strong> project_id로 연결된 성과 정보</li>
                          <li><strong>[ACTION_ITEMS]:</strong> project_id로 연결된 액션아이템</li>
                          <li><strong>[TEAM_MEMBERS]:</strong> project_id로 연결된 참여인력</li>
                        </ul>
                        <div className="file-preview">
                          <strong>예상 섹션:</strong> 4개 테이블 + 메타데이터 → Excel에서 섹션별 독립 편집 가능
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              )}

              {/* 에러 메시지 */}
              {error && (
                <div className="error-message">
                  <AlertCircle size={20} />
                  <span>{error}</span>
                </div>
              )}
            </>
          )}
        </div>

        <div className="modal-footer">
          {exportStatus === 'success' ? (
            <button className="close-btn" onClick={handleClose}>
              닫기
            </button>
          ) : (
            <>
              <button className="cancel-btn" onClick={handleClose}>
                취소
              </button>
              <button 
                className="export-btn"
                onClick={handleExport}
                disabled={isExporting || stats.totalProjects === 0}
              >
                {isExporting ? (
                  <>
                    <div className="spinner"></div>
