// 날짜 관련 유틸리티 함수들 (로컬 시간 기준으로 통일)

/**
 * 날짜를 YYYY-MM-DD 형식으로 변환
 */
export const formatDate = (date) => {
  if (!date) return '';
  const d = new Date(date);
  return d.toISOString().split('T')[0];
};

/**
 * 날짜 범위 생성 (시작일부터 종료일까지)
 */
export const getDateRange = (startDate, endDate) => {
  const dates = [];
  const start = new Date(startDate);
  const end = new Date(endDate);
  
  for (let dt = new Date(start); dt <= end; dt.setDate(dt.getDate() + 1)) {
    dates.push(new Date(dt));
  }
  
  return dates;
};

/**
 * 로컬 시간 기준으로 날짜 정규화 (시간 부분 제거)
 */
const normalizeDate = (date) => {
  const normalized = new Date(date);
  // 로컬 시간 기준으로 시간 부분 제거
  normalized.setHours(0, 0, 0, 0);
  return normalized;
};

/**
 * 주어진 날짜의 주차 계산 (해당 연도의 몇 번째 주) - 로컬 시간 기준
 * ISO 8601 표준에 따른 주차 계산
 */
export const getWeekOfYear = (date) => {
  const d = normalizeDate(date);
  
  // 목요일을 주 중간으로 설정
  const target = new Date(d.getTime());
  const dayNr = (d.getDay() + 6) % 7;
  target.setDate(target.getDate() - dayNr + 3);
  
  // 해당 연도 1월 1일
  const jan1 = new Date(target.getFullYear(), 0, 1);
  
  // 첫 번째 목요일 찾기
  const jan1DayNr = (jan1.getDay() + 6) % 7;
  const firstThursday = new Date(jan1.getTime());
  firstThursday.setDate(1 + 3 - jan1DayNr);
  
  // 주차 계산
  const weekNumber = Math.floor((target.getTime() - firstThursday.getTime()) / (7 * 24 * 60 * 60 * 1000)) + 1;
  
  return weekNumber;
};

/**
 * 주어진 날짜의 주 시작일 (월요일) 계산 - 로컬 시간 기준
 */
export const getWeekStart = (date) => {
  const result = normalizeDate(date);
  const day = result.getDay();
  const diff = result.getDate() - day + (day === 0 ? -6 : 1); // 일요일이면 -6, 그외는 1을 더해 월요일로
  result.setDate(diff);
  return result;
};

/**
 * 주어진 날짜의 주 종료일 (일요일) 계산 - 로컬 시간 기준
 */
export const getWeekEnd = (date) => {
  const weekStart = getWeekStart(date);
  const weekEnd = new Date(weekStart);
  weekEnd.setDate(weekEnd.getDate() + 6);
  return weekEnd;
};

/**
 * 주어진 날짜 범위에서 주 단위로 그룹화 (로컬 시간 기준)
 */
export const groupByWeeks = (startDate, endDate) => {
  const weeks = [];
  const start = normalizeDate(startDate);
  const end = normalizeDate(endDate);
  
  // 시작 주의 월요일 찾기
  let weekStart = getWeekStart(start);
  
  while (weekStart <= end) {
    const weekEnd = getWeekEnd(weekStart);
    const weekNumber = getWeekOfYear(weekStart);
    const year = weekStart.getFullYear();
    
    weeks.push({
      start: new Date(weekStart),
      end: new Date(weekEnd),
      label: `${year}년 ${weekNumber}주`,
      weekNumber: weekNumber,
      year: year
    });
    
    // 다음 주로 이동
    weekStart = new Date(weekStart);
    weekStart.setDate(weekStart.getDate() + 7);
  }
  
  return weeks;
};

/**
 * 월 단위로 그룹화 (로컬 시간 기준)
 */
export const groupByMonths = (startDate, endDate) => {
  const months = [];
  const start = normalizeDate(startDate);
  const end = normalizeDate(endDate);
  
  // 시작 월과 종료 월 계산
  const startYear = start.getFullYear();
  const startMonth = start.getMonth();
  const endYear = end.getFullYear();
  const endMonth = end.getMonth();
  
  // 실제 범위 내의 월들만 처리
  let currentYear = startYear;
  let currentMonth = startMonth;
  
  while (currentYear < endYear || (currentYear === endYear && currentMonth <= endMonth)) {
    // 해당 월의 실제 표시 범위 계산
    let monthStart, monthEnd;
    
    if (currentYear === startYear && currentMonth === startMonth && currentYear === endYear && currentMonth === endMonth) {
      // 같은 월 내의 범위
      monthStart = new Date(start);
      monthEnd = new Date(end);
    } else if (currentYear === startYear && currentMonth === startMonth) {
      // 시작 월
      monthStart = new Date(start);
      monthEnd = new Date(currentYear, currentMonth + 1, 0);
    } else if (currentYear === endYear && currentMonth === endMonth) {
      // 종료 월
      monthStart = new Date(currentYear, currentMonth, 1);
      monthEnd = new Date(end);
    } else {
      // 중간 월들
      monthStart = new Date(currentYear, currentMonth, 1);
      monthEnd = new Date(currentYear, currentMonth + 1, 0);
    }
    
    months.push({
      start: new Date(monthStart),
      end: new Date(monthEnd),
      label: `${currentYear}.${String(currentMonth + 1).padStart(2, '0')}`
    });
    
    // 다음 월로 이동
    if (currentMonth === 11) {
      currentYear++;
      currentMonth = 0;
    } else {
      currentMonth++;
    }
  }
  
  return months;
};

/**
 * 연 단위로 그룹화 (로컬 시간 기준)
 */
export const groupByYears = (startDate, endDate) => {
  const years = [];
  const start = normalizeDate(startDate);
  const end = normalizeDate(endDate);
  
  const currentYear = start.getFullYear();
  const endYear = end.getFullYear();
  
  for (let year = currentYear; year <= endYear; year++) {
    // 실제 표시 범위 내의 연도 범위만 계산
    let yearStart, yearEnd;
    
    if (year === currentYear && year === endYear) {
      // 같은 연도 내의 범위
      yearStart = new Date(start);
      yearEnd = new Date(end);
    } else if (year === currentYear) {
      // 시작 연도
      yearStart = new Date(start);
      yearEnd = new Date(year, 11, 31); // 12월 31일
    } else if (year === endYear) {
      // 종료 연도  
      yearStart = new Date(year, 0, 1); // 1월 1일
      yearEnd = new Date(end);
    } else {
      // 중간 연도들
      yearStart = new Date(year, 0, 1); // 1월 1일
      yearEnd = new Date(year, 11, 31); // 12월 31일
    }
    
    years.push({
      start: yearStart,
      end: yearEnd,
      label: `${year}년`,
      months: groupByMonths(yearStart, yearEnd)
    });
  }
  
  return years;
};

/**
 * 주 단위로 그룹화 (월별 그룹화용) - 로컬 시간 기준
 */
export const groupWeeksByMonth = (startDate, endDate) => {
  const months = [];
  const start = normalizeDate(startDate);
  const end = normalizeDate(endDate);
  
  // 시작 월과 종료 월 계산
  const startYear = start.getFullYear();
  const startMonth = start.getMonth();
  const endYear = end.getFullYear();
  const endMonth = end.getMonth();
  
  // 실제 범위 내의 월들만 처리
  let currentYear = startYear;
  let currentMonth = startMonth;
  
  while (currentYear < endYear || (currentYear === endYear && currentMonth <= endMonth)) {
    // 해당 월의 시작일과 종료일 계산
    let monthStart, monthEnd;
    
    if (currentYear === startYear && currentMonth === startMonth && currentYear === endYear && currentMonth === endMonth) {
      // 같은 월 내의 범위
      monthStart = new Date(start);
      monthEnd = new Date(end);
    } else if (currentYear === startYear && currentMonth === startMonth) {
      // 시작 월
      monthStart = new Date(start);
      monthEnd = new Date(currentYear, currentMonth + 1, 0);
    } else if (currentYear === endYear && currentMonth === endMonth) {
      // 종료 월
      monthStart = new Date(currentYear, currentMonth, 1);
      monthEnd = new Date(end);
    } else {
      // 중간 월들
      monthStart = new Date(currentYear, currentMonth, 1);
      monthEnd = new Date(currentYear, currentMonth + 1, 0);
    }
    
    // 이 달에 포함되는 주들 계산
    const monthWeekStart = getWeekStart(monthStart);
    const monthWeekEnd = getWeekEnd(monthEnd);
    
    // 해당 월의 주들을 정확히 계산
    const weeks = [];
    let weekCursor = new Date(monthWeekStart);
    
    while (weekCursor <= monthWeekEnd) {
      const currentWeekEnd = getWeekEnd(weekCursor);
      
      // 해당 주가 현재 월과 겹치는지 확인
      if (currentWeekEnd >= monthStart && weekCursor <= monthEnd) {
        const weekNumber = getWeekOfYear(weekCursor);
        const year = weekCursor.getFullYear();
        
        weeks.push({
          start: new Date(weekCursor),
          end: new Date(currentWeekEnd),
          label: `${year}년 ${weekNumber}주`,
          weekNumber: weekNumber,
          year: year
        });
      }
      
      // 다음 주로 이동
      weekCursor.setDate(weekCursor.getDate() + 7);
    }
    
    months.push({
      start: new Date(monthStart),
      end: new Date(monthEnd),
      label: `${currentYear}.${String(currentMonth + 1).padStart(2, '0')}`,
      weeks: weeks
    });
    
    // 다음 월로 이동
    if (currentMonth === 11) {
      currentYear++;
      currentMonth = 0;
    } else {
      currentMonth++;
    }
  }
  
  return months;
};

/**
 * 두 날짜 사이의 정확한 일수 계산 (로컬 시간 기준)
 */
export const getDaysBetween = (startDate, endDate) => {
  const start = normalizeDate(startDate);
  const end = normalizeDate(endDate);
  const diffTime = end.getTime() - start.getTime();
  return Math.round(diffTime / (1000 * 60 * 60 * 24));
};

/**
 * 날짜가 주어진 범위 내에 있는지 확인
 */
export const isDateInRange = (date, startDate, endDate) => {
  const d = normalizeDate(date);
  const start = normalizeDate(startDate);
  const end = normalizeDate(endDate);
  return d >= start && d <= end;
};

/**
 * 전체 프로젝트 기간 계산 (로컬 시간 기준)
 */
export const getProjectDateRange = (tasks) => {
  if (!tasks || tasks.length === 0) {
    const today = new Date();
    return { 
      start: normalizeDate(today), 
      end: normalizeDate(today) 
    };
  }
  
  const dates = tasks.reduce((acc, task) => {
    if (task.startDate) acc.push(normalizeDate(task.startDate));
    if (task.endDate) acc.push(normalizeDate(task.endDate));
    return acc;
  }, []);
  
  if (dates.length === 0) {
    const today = new Date();
    return { 
      start: normalizeDate(today), 
      end: normalizeDate(today) 
    };
  }
  
  let start = new Date(Math.min(...dates));
  let end = new Date(Math.max(...dates));
  
  // 시작일을 해당 주의 월요일로, 종료일을 해당 주의 일요일로 확장
  start = getWeekStart(start);
  end = getWeekEnd(end);
  
  return { start, end };
};

/**
 * 날짜를 한국어 형식으로 포맷
 */
export const formatDateKorean = (date) => {
  if (!date) return '';
  const d = normalizeDate(date);
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
};

/**
 * 오늘 날짜 체크 (로컬 시간 기준)
 */
export const isToday = (date) => {
  const today = normalizeDate(new Date());
  const d = normalizeDate(date);
  return d.getTime() === today.getTime();
};

/**
 * 날짜 문자열을 Date 객체로 안전하게 변환
 */
export const parseDate = (dateString) => {
  if (!dateString) return null;
  
  try {
    const date = new Date(dateString);
    if (isNaN(date.getTime())) return null;
    return normalizeDate(date);
  } catch (error) {
    console.warn('Invalid date string:', dateString);
    return null;
  }
};

/**
 * 월의 첫 번째 날 구하기 (로컬 시간 기준)
 */
export const getMonthStart = (date) => {
  const d = normalizeDate(date);
  return new Date(d.getFullYear(), d.getMonth(), 1);
};

/**
 * 월의 마지막 날 구하기 (로컬 시간 기준)
 */
export const getMonthEnd = (date) => {
  const d = normalizeDate(date);
  return new Date(d.getFullYear(), d.getMonth() + 1, 0);
};

/**
 * 연도의 첫 번째 날 구하기 (로컬 시간 기준)
 */
export const getYearStart = (date) => {
  const d = normalizeDate(date);
  return new Date(d.getFullYear(), 0, 1);
};

/**
 * 연도의 마지막 날 구하기 (로컬 시간 기준)
 */
export const getYearEnd = (date) => {
  const d = normalizeDate(date);
  return new Date(d.getFullYear(), 11, 31);
};

