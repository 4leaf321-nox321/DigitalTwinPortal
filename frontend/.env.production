# Build-time configuration for `vite build`. Vite loads this automatically in
# production mode.
#
# This file is committed on purpose. frontend/.env is untracked, so CI builds
# had no VITE_API_URL and every call fell back to the hardcoded
# 'http://localhost:5000/api'. In a browser that points at the viewer's own
# machine, not the server, so nothing worked -- login included.
#
# Keep it relative: the backend serves the SPA from the same origin
# (create_app sets static_folder to frontend/dist), so /api is the API on
# whatever host and port the app happens to be served from.
VITE_API_URL=/api
