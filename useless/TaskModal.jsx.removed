import React, { useState, useEffect } from 'react';
import { X, Calendar, Users, Tag, AlertCircle, CheckCircle2, Clock, Star } from 'lucide-react';
import './TaskModal.css';

const TaskModal = ({ isOpen, onClose, onSave, typeSettings, currentGraphData, showError }) => {
  const [taskData, setTaskData] = useState({
    title: '',
    description: '',
    priority: 'medium',
    status: 'todo',
    assignee: '',
    startDate: '',
    dueDate: '',
    tags: [],
    category: 'general'
  });

  const [newTag, setNewTag] = useState('');
  const [availableAssignees, setAvailableAssignees] = useState([]);

  // 우선순위 옵션
  const priorityOptions = [
    { value: 'low', label: '낮음', icon: '🟢', color: '#2ecc71' },
    { value: 'medium', label: '보통', icon: '🟡', color: '#f39c12' },
    { value: 'high', label: '높음', icon: '🔴', color: '#e74c3c' },
    { value: 'urgent', label: '긴급', icon: '⚡', color: '#9b59b6' }
  ];

  // 상태 옵션
  const statusOptions = [
    { value: 'todo', label: '할 일', icon: '📋', color: '#95a5a6' },
    { value: 'in_progress', label: '진행 중', icon: '🔄', color: '#3498db' },
    { value: 'review', label: '검토', icon: '👁️', color: '#f39c12' },
    { value: 'done', label: '완료', icon: '✅', color: '#2ecc71' },
    { value: 'blocked', label: '차단됨', icon: '🚫', color: '#e74c3c' }
  ];

  // 카테고리 옵션
  const categoryOptions = [
    { value: 'general', label: '일반', icon: '📝' },
    { value: 'development', label: '개발', icon: '💻' },
    { value: 'design', label: '디자인', icon: '🎨' },
    { value: 'research', label: '연구', icon: '🔬' },
    { value: 'meeting', label: '회의', icon: '🤝' },
    { value: 'planning', label: '계획', icon: '📋' },
    { value: 'bug_fix', label: '버그 수정', icon: '🐛' },
    { value: 'feature', label: '새 기능', icon: '✨' }
  ];

  useEffect(() => {
    if (isOpen) {
      // 현재 그래프에서 person 타입의 노드들을 담당자 목록으로 설정
      const personNodes = currentGraphData?.nodes?.filter(node => 
        node.type === 'person' || node.type === 'user' || node.type === 'member'
      ) || [];
      
      setAvailableAssignees(personNodes.map(node => ({
        id: node.id,
        name: node.label || node.id
      })));

      // 모달이 열릴 때 폼 초기화
      setTaskData({
        title: '',
        description: '',
        priority: 'medium',
        status: 'todo',
        assignee: '',
        startDate: '',
        dueDate: '',
        tags: [],
        category: 'general'
      });
      setNewTag('');
    }
  }, [isOpen, currentGraphData]);

  const handleInputChange = (field, value) => {
    setTaskData(prev => ({
      ...prev,
      [field]: value
    }));
  };

  const handleAddTag = () => {
    if (newTag.trim() && !taskData.tags.includes(newTag.trim())) {
      setTaskData(prev => ({
        ...prev,
        tags: [...prev.tags, newTag.trim()]
      }));
      setNewTag('');
    }
  };

  const handleRemoveTag = (tagToRemove) => {
    setTaskData(prev => ({
      ...prev,
      tags: prev.tags.filter(tag => tag !== tagToRemove)
    }));
  };

  const handleKeyPress = (e) => {
    if (e.key === 'Enter' && e.target.name === 'newTag') {
      e.preventDefault();
      handleAddTag();
    }
  };

  const handleSave = () => {
    // 필수 필드 검증
    if (!taskData.title.trim()) {
      if (showError) {
        showError('작업 제목을 입력해주세요.');
      }
      return;
    }

    // 날짜 검증
    if (taskData.startDate && taskData.dueDate) {
      const start = new Date(taskData.startDate);
      const due = new Date(taskData.dueDate);
      if (start > due) {
        if (showError) {
          showError('시작 날짜는 마감 날짜보다 빨라야 합니다.');
        }
        return;
      }
    }

    // 태스크 노드 생성
    const taskNode = {
      id: `task_${Date.now()}`,
      label: taskData.title,
      type: 'task',
      data: {
        ...taskData,
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString()
      }
    };

    // 관련 엣지들 생성
    const edges = [];
    
    // 담당자와의 연결
    if (taskData.assignee) {
      edges.push({
        id: `edge_${taskNode.id}_${taskData.assignee}`,
        source: taskData.assignee,
        target: taskNode.id,
        type: 'assigned_to',
        label: '담당'
      });
    }

    // 태그들과의 연결
    taskData.tags.forEach((tag, index) => {
      const tagNodeId = `tag_${tag.toLowerCase().replace(/\s+/g, '_')}`;
      
      // 태그 노드 생성 (이미 존재하지 않는 경우만)
      const existingTagNode = currentGraphData?.nodes?.find(node => node.id === tagNodeId);
      if (!existingTagNode) {
        const tagNode = {
          id: tagNodeId,
          label: tag,
          type: 'tag',
          data: {
            createdAt: new Date().toISOString()
          }
        };
        edges.push({ type: 'node', data: tagNode });
      }

      // 태그와 태스크 간의 관계
      edges.push({
        id: `edge_${taskNode.id}_${tagNodeId}`,
        source: taskNode.id,
        target: tagNodeId,
        type: 'has_tag',
        label: '태그'
      });
    });

    // 저장 콜백 호출
    onSave({
      taskNode,
      edges
    });

    onClose();
  };

  const handleClose = () => {
    setTaskData({
      title: '',
      description: '',
      priority: 'medium',
      status: 'todo',
      assignee: '',
      startDate: '',
      dueDate: '',
      tags: [],
      category: 'general'
    });
    setNewTag('');
    onClose();
  };

  if (!isOpen) return null;

  return (
    <div className="modal-overlay">
      <div className="modal-container task-modal">
        <div className="modal-header">
          <h2>
            <CheckCircle2 size={24} />
            새 작업 추가
          </h2>
          <button 
            className="modal-close-btn"
            onClick={handleClose}
            aria-label="닫기"
          >
            <X size={20} />
          </button>
        </div>

        <div className="modal-content">
          <div className="task-form">
            {/* 제목 */}
            <div className="form-group">
              <label htmlFor="task-title">
                <Star size={16} />
                작업 제목 *
              </label>
              <input
                id="task-title"
                type="text"
                value={taskData.title}
                onChange={(e) => handleInputChange('title', e.target.value)}
                placeholder="작업 제목을 입력하세요"
                className="form-input"
                autoFocus
              />
            </div>

            {/* 설명 */}
            <div className="form-group">
              <label htmlFor="task-description">
                📄 설명
              </label>
              <textarea
                id="task-description"
                value={taskData.description}
                onChange={(e) => handleInputChange('description', e.target.value)}
                placeholder="작업에 대한 자세한 설명을 입력하세요"
                className="form-textarea"
                rows="3"
              />
            </div>

            {/* 우선순위와 상태 */}
            <div className="form-row">
              <div className="form-group">
                <label htmlFor="task-priority">
                  <AlertCircle size={16} />
                  우선순위
                </label>
                <select
                  id="task-priority"
                  value={taskData.priority}
                  onChange={(e) => handleInputChange('priority', e.target.value)}
                  className="form-select"
                >
                  {priorityOptions.map(option => (
                    <option key={option.value} value={option.value}>
                      {option.icon} {option.label}
                    </option>
                  ))}
                </select>
              </div>

              <div className="form-group">
                <label htmlFor="task-status">
                  <Clock size={16} />
                  상태
                </label>
                <select
                  id="task-status"
                  value={taskData.status}
                  onChange={(e) => handleInputChange('status', e.target.value)}
                  className="form-select"
                >
                  {statusOptions.map(option => (
                    <option key={option.value} value={option.value}>
                      {option.icon} {option.label}
                    </option>
                  ))}
                </select>
              </div>
            </div>

            {/* 카테고리와 담당자 */}
            <div className="form-row">
              <div className="form-group">
                <label htmlFor="task-category">
                  <Tag size={16} />
                  카테고리
                </label>
                <select
                  id="task-category"
                  value={taskData.category}
                  onChange={(e) => handleInputChange('category', e.target.value)}
                  className="form-select"
                >
                  {categoryOptions.map(option => (
                    <option key={option.value} value={option.value}>
                      {option.icon} {option.label}
                    </option>
                  ))}
                </select>
              </div>

              <div className="form-group">
                <label htmlFor="task-assignee">
                  <Users size={16} />
                  담당자
                </label>
                <select
                  id="task-assignee"
                  value={taskData.assignee}
                  onChange={(e) => handleInputChange('assignee', e.target.value)}
                  className="form-select"
                >
                  <option value="">담당자 선택...</option>
                  {availableAssignees.map(assignee => (
                    <option key={assignee.id} value={assignee.id}>
                      {assignee.name}
                    </option>
                  ))}
                </select>
              </div>
            </div>

            {/* 날짜 */}
            <div className="form-row">
              <div className="form-group">
                <label htmlFor="task-start-date">
                  <Calendar size={16} />
                  시작 날짜
                </label>
                <input
                  id="task-start-date"
                  type="date"
                  value={taskData.startDate}
                  onChange={(e) => handleInputChange('startDate', e.target.value)}
                  className="form-input"
                />
              </div>

              <div className="form-group">
                <label htmlFor="task-due-date">
                  <Calendar size={16} />
                  마감 날짜
                </label>
                <input
                  id="task-due-date"
                  type="date"
                  value={taskData.dueDate}
                  onChange={(e) => handleInputChange('dueDate', e.target.value)}
                  className="form-input"
                />
              </div>
            </div>

            {/* 태그 */}
            <div className="form-group">
              <label htmlFor="task-tags">
                <Tag size={16} />
                태그
              </label>
              <div className="tag-input-container">
                <input
                  id="task-tags"
                  type="text"
                  name="newTag"
                  value={newTag}
                  onChange={(e) => setNewTag(e.target.value)}
                  onKeyPress={handleKeyPress}
                  placeholder="태그를 입력하고 Enter를 누르세요"
                  className="form-input"
                />
                <button
                  type="button"
                  onClick={handleAddTag}
                  className="tag-add-btn"
                  disabled={!newTag.trim()}
                >
                  추가
                </button>
              </div>
              
              {taskData.tags.length > 0 && (
                <div className="tag-list">
                  {taskData.tags.map(tag => (
                    <span key={tag} className="tag-item">
                      {tag}
                      <button
                        type="button"
                        onClick={() => handleRemoveTag(tag)}
                        className="tag-remove-btn"
                        aria-label={`${tag} 태그 제거`}
                      >
                        <X size={12} />
                      </button>
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>

        <div className="modal-actions">
          <button 
            className="btn btn-secondary"
            onClick={handleClose}
          >
            취소
          </button>
          <button 
            className="btn btn-primary"
            onClick={handleSave}
            disabled={!taskData.title.trim()}
          >
            작업 생성
          </button>
        </div>
      </div>
    </div>
  );
};

export default TaskModal;