import React, { useState, useEffect } from 'react';
import Layout from './components/Layout/Layout';
import KnowledgeGraph from './components/KnowledgeGraph/KnowledgeGraph';
import DataPanel from './components/DataPanel/DataPanel';
import { useGraphData } from './hooks/useGraphData';
import { useGraphInteraction } from './hooks/useGraphInteraction';
import { sampleGraphData } from './data/sampleData';
import { applyNodeTypeColors, applyEdgeTypeColors } from './utils/colorUtils';
import './App.css';

function App() {
  // 타입 설정을 먼저 로드하기 위한 상태
  const [isInitialized, setIsInitialized] = useState(false);
  const [typeSettings, setTypeSettings] = useState({
    nodeTypes: [],
    edgeTypes: []
  });

  // 기본 타입 정의
  const getDefaultNodeTypes = () => [
    { id: 'person', label: 'Person', color: '#3498db' },
    { id: 'company', label: 'Company', color: '#e74c3c' },
    { id: 'project', label: 'Project', color: '#2ecc71' },
    { id: 'skill', label: 'Skill', color: '#f39c12' },
    { id: 'department', label: 'Department', color: '#9b59b6' },
    { id: 'technology', label: 'Technology', color: '#f39c12' },
    { id: 'team', label: 'Team', color: '#1abc9c' },
    { id: 'product', label: 'Product', color: '#34495e' },
    { id: 'service', label: 'Service', color: '#95a5a6' },
    { id: 'location', label: 'Location', color: '#e67e22' },
    { id: 'unknown', label: 'Unknown', color: '#cccccc' }
  ];

  const getDefaultEdgeTypes = () => [
    { id: 'works_for', label: '근무' },
    { id: 'participates_in', label: '참여' },
    { id: 'has_skill', label: '보유' },
    { id: 'belongs_to', label: '소속' },
    { id: 'uses_technology', label: '사용' },
    { id: 'utilizes', label: '활용' },
    { id: 'part_of', label: '부분' },
    { id: 'collaborates_with', label: '협업' },
    { id: 'unknown', label: '알 수 없음' }
  ];

  // 노드/엣지 데이터와 타입 설정 동기화 함수
  const syncDataWithTypeSettings = (currentData, currentTypeSettings) => {
    console.log('=== 데이터 동기화 시작 ===');
    console.log('현재 데이터:', {
      nodeCount: currentData.nodes.length,
      edgeCount: currentData.edges.length
    });
    console.log('타입 설정:', currentTypeSettings);

    // 타입 설정이 비어있으면 기본 타입 사용
    const nodeTypes = currentTypeSettings.nodeTypes && currentTypeSettings.nodeTypes.length > 0 
      ? currentTypeSettings.nodeTypes 
      : getDefaultNodeTypes();
      
    const edgeTypes = currentTypeSettings.edgeTypes && currentTypeSettings.edgeTypes.length > 0 
      ? currentTypeSettings.edgeTypes 
      : getDefaultEdgeTypes();

    const validNodeTypeIds = new Set(nodeTypes.map(t => t.id));
    const validEdgeTypeIds = new Set(edgeTypes.map(t => t.id));
    
    console.log('유효한 노드 타입들:', Array.from(validNodeTypeIds));
    console.log('유효한 엣지 타입들:', Array.from(validEdgeTypeIds));

    let hasChanges = false;
    const updatedData = { ...currentData };

    // 노드 타입 동기화
    updatedData.nodes = currentData.nodes.map(node => {
      if (!validNodeTypeIds.has(node.type)) {
        console.log(`🔄 노드 ${node.id} (${node.label}): ${node.type} → unknown`);
        hasChanges = true;
        return {
          ...node,
          type: 'unknown',
          color: '#cccccc'
        };
      }
      return node;
    });

    // 엣지 타입 동기화
    updatedData.edges = currentData.edges.map(edge => {
      if (!validEdgeTypeIds.has(edge.type)) {
        console.log(`🔄 엣지 ${edge.id}: ${edge.type} → unknown`);
        hasChanges = true;
        return {
          ...edge,
          type: 'unknown',
          label: '알 수 없음'
        };
      }
      // 타입이 유효하지만 레이블이 타입 이름과 다를 경우 업데이트
      const edgeType = edgeTypes.find(t => t.id === edge.type);
      if (edgeType && edge.label !== edgeType.label) {
        console.log(`🔄 엣지 ${edge.id} 레이블 업데이트: ${edge.label} → ${edgeType.label}`);
        hasChanges = true;
        return {
          ...edge,
          label: edgeType.label
        };
      }
      return edge;
    });

    if (hasChanges) {
      console.log('✅ 데이터 동기화 완료 - 변경사항 적용됨');
      // 색상을 다시 적용
      const dataWithColors = {
      ...updatedData,
      nodes: applyNodeTypeColors(updatedData.nodes, nodeTypes),
        edges: applyEdgeTypeColors(updatedData.edges, edgeTypes)
    };
      console.log('=== 동기화 결과 ===');
      console.log('변경된 데이터:', dataWithColors);
      return dataWithColors;
    }

    console.log('✅ 데이터 동기화 완료 - 변경사항 없음');
    return currentData;
  };

  // 초기 데이터를 타입 설정과 동기화하여 생성
  const getInitialData = () => {
    console.log('🔧 초기 데이터 생성 시작');
    const rawData = {
      ...sampleGraphData,
      nodes: applyNodeTypeColors(sampleGraphData.nodes),
      edges: applyEdgeTypeColors(sampleGraphData.edges)
    };

    if (typeSettings.nodeTypes.length > 0 || typeSettings.edgeTypes.length > 0) {
      console.log('📋 타입 설정과 동기화하여 초기 데이터 생성');
      return syncDataWithTypeSettings(rawData, typeSettings);
    }

    console.log('📋 기본 초기 데이터 사용');
    return rawData;
  };

  // 초기화가 완료된 후에만 그래프 데이터 상태 생성
  const [graphData, setGraphData] = useState(() => {
    if (!isInitialized) {
      return { nodes: [], edges: [] }; // 임시 빈 데이터
    }
    return getInitialData();
  });
  
  const [selectedNode, setSelectedNode] = useState(null);
  const [selectedEdge, setSelectedEdge] = useState(null);
  const [searchQuery, setSearchQuery] = useState('');
  const [layoutType, setLayoutType] = useState('force-directed');
  const [filterOptions, setFilterOptions] = useState({
    nodeTypes: [],
    edgeTypes: [],
    minConnections: 0
  });

  // 컴포넌트 마운트 시 타입 설정을 먼저 로드
  useEffect(() => {
    console.log('🚀 앱 초기화 시작 - 타입 설정 우선 로드');
    
    const savedTypeSettings = localStorage.getItem('knowledgeGraphTypeSettings');
    if (savedTypeSettings) {
      try {
        const parsedSettings = JSON.parse(savedTypeSettings);
        console.log('📁 로드된 타입 설정:', parsedSettings);
        setTypeSettings(parsedSettings);
        
        // 타입 설정 로드 완료 후 초기 데이터 설정
        const rawData = {
          ...sampleGraphData,
          nodes: applyNodeTypeColors(sampleGraphData.nodes),
          edges: applyEdgeTypeColors(sampleGraphData.edges)
        };
        
        const syncedData = syncDataWithTypeSettings(rawData, parsedSettings);
        console.log('📊 동기화된 초기 데이터 설정');
        setGraphData(syncedData);
        
      } catch (error) {
        console.error('❌ 타입 설정 로드 중 오류:', error);
        // 오류 시 기본 데이터 사용
        setGraphData({
          ...sampleGraphData,
          nodes: applyNodeTypeColors(sampleGraphData.nodes)
        });
      }
    } else {
      console.log('📁 저장된 타입 설정 없음 - 기본 데이터 사용');
      setGraphData({
        ...sampleGraphData,
        nodes: applyNodeTypeColors(sampleGraphData.nodes),
        edges: applyEdgeTypeColors(sampleGraphData.edges)
      });
    }
    
    // 초기화 완료
    setIsInitialized(true);
  }, []);

  const { 
    graphData: hookGraphData, // useGraphData에서 반환되는 실제 데이터
    processedData, 
    updateGraphData, 
    addNode, 
    addEdge, 
    removeNode, 
    removeEdge,
    setData // 훅의 데이터를 직접 설정하는 함수
  } = useGraphData(graphData, filterOptions);

  const {
    highlightedNodes,
    highlightedEdges,
    handleNodeClick,
    handleEdgeClick,
    handleSearch,
    clearSelection
  } = useGraphInteraction({
    graphData: processedData,
    searchQuery,
    onNodeSelect: setSelectedNode,
    onEdgeSelect: setSelectedEdge
  });

  // 개발 모드에서 디버깅을 위해 전역 변수로 노출
  useEffect(() => {
    if (import.meta.env.DEV) {
      window.currentGraphData = hookGraphData; // 훅에서 반환되는 실제 데이터
      window.currentRawGraphData = graphData; // App 상태의 원본 데이터
      window.currentProcessedData = processedData; // 필터링된 데이터
      window.currentTypeSettings = typeSettings;
      window.setGraphData = setData; // 훅 데이터 업데이트
      window.setAppGraphData = setGraphData; // App 상태 업데이트
      
      // 강제 업데이트 함수
      window.forceUpdateGraphData = (newData) => {
        console.log('🔄 강제 데이터 업데이트:', newData);
        setGraphData(newData); // App 상태 업데이트
        setData(newData); // 훅 데이터 업데이트
      };
    }
  }, [hookGraphData, graphData, processedData, typeSettings, setData]);

  useEffect(() => {
    handleSearch(searchQuery);
  }, [searchQuery, handleSearch]);

  const handleLayoutChange = (newLayout) => {
    setLayoutType(newLayout);
  };

  const handleFilterChange = (newFilters) => {
    setFilterOptions(newFilters);
  };

  const handleDataImport = (importedData) => {
    const dataWithColors = {
      ...importedData,
      nodes: applyNodeTypeColors(importedData.nodes, typeSettings.nodeTypes),
      edges: applyEdgeTypeColors(importedData.edges, typeSettings.edgeTypes)
    };
    const syncedData = syncDataWithTypeSettings(dataWithColors, typeSettings);
    setGraphData(syncedData);
  };

  const handleTypeSettingsChange = (newTypeSettings) => {
    console.log('🎯 App: 타입 설정 변경됨:', newTypeSettings);
    
    // 타입 설정 상태 업데이트
    const settingsToSave = {
      nodeTypes: newTypeSettings.nodeTypes,
      edgeTypes: newTypeSettings.edgeTypes
    };
    
    console.log('💾 저장할 설정:', settingsToSave);
    
    // 먼저 타입 설정을 업데이트
    setTypeSettings(settingsToSave);
    
    // 타입 설정을 로컬 스토리지에 저장
    localStorage.setItem('knowledgeGraphTypeSettings', JSON.stringify(settingsToSave));
    
    // 현재 그래프 데이터와 새로운 타입 설정 동기화
    console.log('🔄 그래프 데이터 동기화 시작...');
    
    // 모든 엣지의 레이블을 타입에 맞게 업데이트
    const updatedGraphData = {
      ...graphData,
      edges: graphData.edges.map(edge => {
        const edgeType = settingsToSave.edgeTypes.find(t => t.id === edge.type);
        if (edgeType && edge.label !== edgeType.label) {
          return {
            ...edge,
            label: edgeType.label
          };
        }
        return edge;
      })
    };
    
    const syncedData = syncDataWithTypeSettings(updatedGraphData, settingsToSave);
    
    // 동기화된 데이터가 다르면 상태 업데이트
    if (JSON.stringify(syncedData) !== JSON.stringify(graphData)) {
      console.log('📊 그래프 데이터 업데이트 적용');
      setGraphData(syncedData); // 원본 상태 업데이트
    } else {
      console.log('📊 그래프 데이터 변경 없음');
    }
  };

  const handleDataExport = () => {
    const dataStr = JSON.stringify(graphData, null, 2);
    const dataBlob = new Blob([dataStr], { type: 'application/json' });
    const url = URL.createObjectURL(dataBlob);
    const link = document.createElement('a');
    link.href = url;
    link.download = 'knowledge-graph-data.json';
    link.click();
  };

  // 초기화가 완료되지 않았으면 로딩 표시
  if (!isInitialized) {
    return (
      <div className="app loading">
        <div style={{ 
          display: 'flex', 
          justifyContent: 'center', 
          alignItems: 'center', 
          height: '100vh',
          fontSize: '18px',
          color: '#666'
        }}>
          🔄 그래프 데이터 초기화 중...
        </div>
      </div>
    );
  }

  return (
    <div className="app">
      <Layout
        searchQuery={searchQuery}
        onSearchChange={setSearchQuery}
        layoutType={layoutType}
        onLayoutChange={handleLayoutChange}
        onDataImport={handleDataImport}
        onDataExport={handleDataExport}
        filterOptions={filterOptions}
        onFilterChange={handleFilterChange}
        onTypeSettingsChange={handleTypeSettingsChange}
        currentGraphData={processedData}
        typeSettings={typeSettings}
      >
        <div className="app-content">
          <div className="graph-container">
            <KnowledgeGraph
              data={processedData}
              selectedNode={selectedNode}
              selectedEdge={selectedEdge}
              highlightedNodes={highlightedNodes}
              highlightedEdges={highlightedEdges}
              layoutType={layoutType}
              onNodeClick={handleNodeClick}
              onEdgeClick={handleEdgeClick}
              onNodeAdd={addNode}
              onEdgeAdd={addEdge}
              nodeTypes={typeSettings.nodeTypes}
              edgeTypes={typeSettings.edgeTypes}
            />
          </div>
          
          <div className="panel-container">
            <DataPanel
              selectedNode={selectedNode}
              selectedEdge={selectedEdge}
              graphData={processedData}
              onNodeUpdate={(nodeId, updates) => {
                updateGraphData('updateNode', nodeId, updates);
              }}
              onEdgeUpdate={(edgeId, updates) => {
                updateGraphData('updateEdge', edgeId, updates);
              }}
              onNodeDelete={(nodeId) => {
                removeNode(nodeId);
                clearSelection();
              }}
              onEdgeDelete={(edgeId) => {
                removeEdge(edgeId);
                clearSelection();
              }}
              onClearSelection={clearSelection}
              nodeTypes={typeSettings.nodeTypes}
              edgeTypes={typeSettings.edgeTypes}
            />
          </div>
        </div>
      </Layout>
    </div>
  );
}

export default App;