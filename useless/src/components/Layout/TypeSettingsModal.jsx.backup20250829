import React, { useState, useEffect } from 'react';
import { X, Plus, Trash2, Edit2, Save, Settings } from 'lucide-react';
import './TypeSettingsModal.css';

const TypeSettingsModal = ({ 
  isOpen, 
  onClose,
  initialNodeTypes = [],
  initialEdgeTypes = [],
  onSave
}) => {
  const [nodeTypes, setNodeTypes] = useState([]);
  const [edgeTypes, setEdgeTypes] = useState([]);
  const [newNodeType, setNewNodeType] = useState('');
  const [newEdgeType, setNewEdgeType] = useState('');
  const [editingNodeType, setEditingNodeType] = useState(null);
  const [editingEdgeType, setEditingEdgeType] = useState(null);
  const [errors, setErrors] = useState({});

  // Default node types
  const defaultNodeTypes = [
    { id: 'person', label: 'Person', color: '#3498db' },
    { id: 'company', label: 'Company', color: '#e74c3c' },
    { id: 'project', label: 'Project', color: '#2ecc71' },
    { id: 'skill', label: 'Skill', color: '#f39c12' },
    { id: 'department', label: 'Department', color: '#9b59b6' },
    { id: 'technology', label: 'Technology', color: '#f39c12' },
    { id: 'team', label: 'Team', color: '#1abc9c' },
    { id: 'product', label: 'Product', color: '#34495e' },
    { id: 'service', label: 'Service', color: '#95a5a6' },
    { id: 'location', label: 'Location', color: '#e67e22' }
  ];

  // Default edge types
  const defaultEdgeTypes = [
    { id: 'works_for', label: 'Works For' },
    { id: 'participates_in', label: 'Participates In' },
    { id: 'has_skill', label: 'Has Skill' },
    { id: 'belongs_to', label: 'Belongs To' },
    { id: 'uses_technology', label: 'Uses Technology' },
    { id: 'utilizes', label: 'Utilizes' },
    { id: 'part_of', label: 'Part Of' },
    { id: 'collaborates_with', label: 'Collaborates With' }
  ];

  useEffect(() => {
    if (isOpen) {
      setNodeTypes(initialNodeTypes.length > 0 ? initialNodeTypes : defaultNodeTypes);
      setEdgeTypes(initialEdgeTypes.length > 0 ? initialEdgeTypes : defaultEdgeTypes);
      setNewNodeType('');
      setNewEdgeType('');
      setEditingNodeType(null);
      setEditingEdgeType(null);
      setErrors({});
    }
  }, [isOpen, initialNodeTypes, initialEdgeTypes]);

  const validateId = (id, existingTypes, editingId = null) => {
    if (!id.trim()) {
      return 'Please enter an ID.';
    }
    if (!/^[a-zA-Z_][a-zA-Z0-9_]*$/.test(id)) {
      return 'ID must start with a letter or underscore, and contain only letters, numbers, and underscores.';
    }
    if (existingTypes.some(type => type.id === id && type.id !== editingId)) {
      return 'This ID already exists.';
    }
    return null;
  };

  const handleAddNodeType = () => {
    const error = validateId(newNodeType, nodeTypes);
    if (error) {
      setErrors({ ...errors, newNodeType: error });
      return;
    }

    const newType = {
      id: newNodeType.trim(),
      label: newNodeType.trim(),
      color: '#' + Math.floor(Math.random()*16777215).toString(16)
    };

    setNodeTypes([...nodeTypes, newType]);
    setNewNodeType('');
    setErrors({ ...errors, newNodeType: null });
  };

  const handleAddEdgeType = () => {
    const error = validateId(newEdgeType, edgeTypes);
    if (error) {
      setErrors({ ...errors, newEdgeType: error });
      return;
    }

    const newType = {
      id: newEdgeType.trim(),
      label: newEdgeType.trim()
    };

    setEdgeTypes([...edgeTypes, newType]);
    setNewEdgeType('');
    setErrors({ ...errors, newEdgeType: null });
  };

  const handleUpdateNodeType = (id, updates) => {
    if (updates.id && updates.id !== id) {
      const error = validateId(updates.id, nodeTypes, id);
      if (error) {
        setErrors({ ...errors, [`editNodeType_${id}`]: error });
        return;
      }
    }

    setNodeTypes(nodeTypes.map(type => 
      type.id === id ? { ...type, ...updates } : type
    ));
    setEditingNodeType(null);
    setErrors({ ...errors, [`editNodeType_${id}`]: null });
  };

  const handleUpdateEdgeType = (id, updates) => {
    if (updates.id && updates.id !== id) {
      const error = validateId(updates.id, edgeTypes, id);
      if (error) {
        setErrors({ ...errors, [`editEdgeType_${id}`]: error });
        return;
      }
    }

    setEdgeTypes(edgeTypes.map(type => 
      type.id === id ? { ...type, ...updates } : type
    ));
    setEditingEdgeType(null);
    setErrors({ ...errors, [`editEdgeType_${id}`]: null });
  };

  const handleDeleteNodeType = (id) => {
    setNodeTypes(nodeTypes.filter(type => type.id !== id));
  };

  const handleDeleteEdgeType = (id) => {
    setEdgeTypes(edgeTypes.filter(type => type.id !== id));
  };

  const handleSave = () => {
    onSave({
      nodeTypes,
      edgeTypes
    });
    onClose();
  };

  const handleKeyDown = (e) => {
    if (e.key === 'Escape') {
      onClose();
    }
  };

  if (!isOpen) return null;

  return (
    <div className="type-settings-modal-overlay" onClick={onClose}>
      <div 
        className="type-settings-modal" 
        onClick={(e) => e.stopPropagation()}
        onKeyDown={handleKeyDown}
      >
        <div className="modal-header">
          <h2>
            <Settings size={24} strokeWidth={2} />
            Type Settings
          </h2>
          <button 
            className="modal-close-btn"
            onClick={onClose}
            type="button"
          >
            <X size={20} strokeWidth={2} />
          </button>
        </div>
        
        <div className="modal-body">
          {/* Node types section */}
          <div className="type-section">
            <h3>Node Types</h3>
            <div className="add-type-form">
              <input
                type="text"
                value={newNodeType}
                onChange={(e) => {
                  setNewNodeType(e.target.value);
                  if (errors.newNodeType) {
                    setErrors({ ...errors, newNodeType: null });
                  }
                }}
                placeholder="New node type ID (e.g. organization)"
                className={`add-type-input ${errors.newNodeType ? 'error' : ''}`}
                onKeyDown={(e) => e.key === 'Enter' && handleAddNodeType()}
              />
              <button 
                onClick={handleAddNodeType}
                className="add-type-btn"
                type="button"
              >
                <Plus size={16} strokeWidth={2} />
                Add
              </button>
            </div>
            {errors.newNodeType && (
              <div className="error-message">{errors.newNodeType}</div>
            )}
            
            <div className="type-list">
              {nodeTypes.map((type) => (
                <div key={type.id} className="type-item">
                  <div 
                    className="color-indicator"
                    style={{ backgroundColor: type.color }}
                  ></div>
                  
                  {editingNodeType === type.id ? (
                    <EditNodeTypeForm
                      type={type}
                      onSave={(updates) => handleUpdateNodeType(type.id, updates)}
                      onCancel={() => setEditingNodeType(null)}
                      error={errors[`editNodeType_${type.id}`]}
                    />
                  ) : (
                    <>
                      <div className="type-info">
                        <span className="type-id">{type.id}</span>
                        <span className="type-label">{type.label}</span>
                      </div>
                      
                      <div className="type-actions">
                        <button 
                          onClick={() => setEditingNodeType(type.id)}
                          className="edit-btn node-edit-btn"
                          title="Edit"
                        >
                          ✎
                        </button>
                        <button 
                          onClick={() => handleDeleteNodeType(type.id)}
                          className="delete-btn node-delete-btn"
                          title="Delete"
                        >
                          ✕
                        </button>
                      </div>
                    </>
                  )}
                </div>
              ))}
            </div>
          </div>

          {/* Edge types section */}
          <div className="type-section">
            <h3>Edge Types</h3>
            <div className="add-type-form">
              <input
                type="text"
                value={newEdgeType}
                onChange={(e) => {
                  setNewEdgeType(e.target.value);
                  if (errors.newEdgeType) {
                    setErrors({ ...errors, newEdgeType: null });
                  }
                }}
                placeholder="New edge type ID (e.g. manages)"
                className={`add-type-input ${errors.newEdgeType ? 'error' : ''}`}
                onKeyDown={(e) => e.key === 'Enter' && handleAddEdgeType()}
              />
              <button 
                onClick={handleAddEdgeType}
                className="add-type-btn"
                type="button"
              >
                <Plus size={16} strokeWidth={2} />
                Add
              </button>
            </div>
            {errors.newEdgeType && (
              <div className="error-message">{errors.newEdgeType}</div>
            )}
            
            <div className="type-list">
              {edgeTypes.map((type) => (
                <div key={type.id} className="type-item edge-type">
                  {editingEdgeType === type.id ? (
                    <EditEdgeTypeForm
                      type={type}
                      onSave={(updates) => handleUpdateEdgeType(type.id, updates)}
                      onCancel={() => setEditingEdgeType(null)}
                      error={errors[`editEdgeType_${type.id}`]}
                    />
                  ) : (
                    <>
                      <div className="type-info">
                        <span className="type-id">{type.id}</span>
                        <span className="type-label">{type.label}</span>
                      </div>
                      
                      <div className="type-actions">
                        <button 
                          onClick={() => setEditingEdgeType(type.id)}
                          className="edit-btn edge-edit-btn"
                          title="Edit"
                        >
                          ✎
                        </button>
                        <button 
                          onClick={() => handleDeleteEdgeType(type.id)}
                          className="delete-btn edge-delete-btn"
                          title="Delete"
                        >
                          ✕
                        </button>
                      </div>
                    </>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>

        <div className="modal-footer">
          <button 
            type="button" 
            className="btn-cancel"
            onClick={onClose}
          >
            Cancel
          </button>
          <button 
            type="button" 
            className="btn-save"
            onClick={handleSave}
          >
            Save
          </button>
        </div>
      </div>
    </div>
  );
};

// Node type edit form component
const EditNodeTypeForm = ({ type, onSave, onCancel, error }) => {
  const [editData, setEditData] = useState({
    id: type.id,
    label: type.label,
    color: type.color
  });

  const handleSave = () => {
    onSave(editData);
  };

  return (
    <div className="edit-form">
      <div className="edit-inputs">
        <input
          type="text"
          value={editData.id}
          onChange={(e) => setEditData({ ...editData, id: e.target.value })}
          placeholder="ID"
          className={`edit-input ${error ? 'error' : ''}`}
        />
        <input
          type="text"
          value={editData.label}
          onChange={(e) => setEditData({ ...editData, label: e.target.value })}
          placeholder="Label"
          className="edit-input"
        />
        <input
          type="color"
          value={editData.color}
          onChange={(e) => setEditData({ ...editData, color: e.target.value })}
          className="edit-color-input"
        />
      </div>
      {error && <div className="error-message">{error}</div>}
      <div className="edit-actions">
        <button onClick={handleSave} className="save-btn">
          <Save size={14} strokeWidth={2.5} />
        </button>
        <button onClick={onCancel} className="cancel-btn">
          <X size={14} strokeWidth={2.5} />
        </button>
      </div>
    </div>
  );
};

// Edge type edit form component
const EditEdgeTypeForm = ({ type, onSave, onCancel, error }) => {
  const [editData, setEditData] = useState({
    id: type.id,
    label: type.label
  });

  const handleSave = () => {
    onSave(editData);
  };

  return (
    <div className="edit-form">
      <div className="edit-inputs">
        <input
          type="text"
          value={editData.id}
          onChange={(e) => setEditData({ ...editData, id: e.target.value })}
          placeholder="ID"
          className={`edit-input ${error ? 'error' : ''}`}
        />
        <input
          type="text"
          value={editData.label}
          onChange={(e) => setEditData({ ...editData, label: e.target.value })}
          placeholder="Label"
          className="edit-input"
        />
      </div>
      {error && <div className="error-message">{error}</div>}
      <div className="edit-actions">
        <button onClick={handleSave} className="save-btn">
          <Save size={14} strokeWidth={2.5} />
        </button>
        <button onClick={onCancel} className="cancel-btn">
          <X size={14} strokeWidth={2.5} />
        </button>
      </div>
    </div>
  );
};

export default TypeSettingsModal;
