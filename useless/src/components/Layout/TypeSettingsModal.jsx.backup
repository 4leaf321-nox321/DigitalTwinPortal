import React, { useState, useEffect } from 'react';\nimport { X, Plus, Trash2, Edit2, Save, Settings } from 'lucide-react';\nimport './TypeSettingsModal.css';\n\nconst TypeSettingsModal = ({ \n  isOpen, \n  onClose,\n  initialNodeTypes = [],\n  initialEdgeTypes = [],\n  onSave\n}) => {\n  const [nodeTypes, setNodeTypes] = useState([]);\n  const [edgeTypes, setEdgeTypes] = useState([]);\n  const [newNodeType, setNewNodeType] = useState('');\n  const [newEdgeType, setNewEdgeType] = useState('');\n  const [editingNodeType, setEditingNodeType] = useState(null);\n  const [editingEdgeType, setEditingEdgeType] = useState(null);\n  const [errors, setErrors] = useState({});\n\n  // Default node types\n  const defaultNodeTypes = [\n    { id: 'person', label: '사람', color: '#3498db' },\n    { id: 'company', label: '회사', color: '#e74c3c' },\n    { id: 'project', label: '프로젝트', color: '#2ecc71' },\n    { id: 'skill', label: '기술', color: '#f39c12' },\n    { id: 'department', label: '부서', color: '#9b59b6' },\n    { id: 'technology', label: '기술', color: '#f39c12' },\n    { id: 'team', label: '팀', color: '#1abc9c' },\n    { id: 'product', label: '제품', color: '#34495e' },\n    { id: 'service', label: '서비스', color: '#95a5a6' },\n    { id: 'location', label: '위치', color: '#e67e22' }\n  ];\n\n  // Default edge types\n  const defaultEdgeTypes = [\n    { id: 'works_for', label: '근무' },\n    { id: 'participates_in', label: '참여' },\n    { id: 'has_skill', label: '보유' },\n    { id: 'belongs_to', label: '소속' },\n    { id: 'uses_technology', label: '사용' },\n    { id: 'utilizes', label: '활용' },\n    { id: 'part_of', label: '부분' },\n    { id: 'collaborates_with', label: '협업' }\n  ];\n\n  useEffect(() => {\n    if (isOpen) {\n      setNodeTypes(initialNodeTypes.length > 0 ? initialNodeTypes : defaultNodeTypes);\n      setEdgeTypes(initialEdgeTypes.length > 0 ? initialEdgeTypes : defaultEdgeTypes);\n      setNewNodeType('');\n      setNewEdgeType('');\n      setEditingNodeType(null);\n      setEditingEdgeType(null);\n      setErrors({});\n    }\n  }, [isOpen, initialNodeTypes, initialEdgeTypes]);\n\n  const validateId = (id, existingTypes, editingId = null) => {\n    if (!id.trim()) {\n      return 'ID를 입력해주세요.';\n    }\n    if (!/^[a-zA-Z_][a-zA-Z0-9_]*$/.test(id)) {\n      return 'ID는 영문자나 언더스코어로 시작하고, 영문자, 숫자, 언더스코어만 사용할 수 있습니다.';\n    }\n    if (existingTypes.some(type => type.id === id && type.id !== editingId)) {\n      return '이미 존재하는 ID입니다.';\n    }\n    return null;\n  };\n\n  const handleAddNodeType = () => {\n    const error = validateId(newNodeType, nodeTypes);\n    if (error) {\n      setErrors({ ...errors, newNodeType: error });\n      return;\n    }\n\n    const newType = {\n      id: newNodeType.trim(),\n      label: newNodeType.trim(),\n      color: '#' + Math.floor(Math.random()*16777215).toString(16)\n    };\n\n    setNodeTypes([...nodeTypes, newType]);\n    setNewNodeType('');\n    setErrors({ ...errors, newNodeType: null });\n  };\n\n  const handleAddEdgeType = () => {\n    const error = validateId(newEdgeType, edgeTypes);\n    if (error) {\n      setErrors({ ...errors, newEdgeType: error });\n      return;\n    }\n\n    const newType = {\n      id: newEdgeType.trim(),\n      label: newEdgeType.trim()\n    };\n\n    setEdgeTypes([...edgeTypes, newType]);\n    setNewEdgeType('');\n    setErrors({ ...errors, newEdgeType: null });\n  };\n\n  const handleUpdateNodeType = (id, updates) => {\n    if (updates.id && updates.id !== id) {\n      const error = validateId(updates.id, nodeTypes, id);\n      if (error) {\n        setErrors({ ...errors, [`editNodeType_${id}`]: error });\n        return;\n      }\n    }\n\n    setNodeTypes(nodeTypes.map(type => \n      type.id === id ? { ...type, ...updates } : type\n    ));\n    setEditingNodeType(null);\n    setErrors({ ...errors, [`editNodeType_${id}`]: null });\n  };\n\n  const handleUpdateEdgeType = (id, updates) => {\n    if (updates.id && updates.id !== id) {\n      const error = validateId(updates.id, edgeTypes, id);\n      if (error) {\n        setErrors({ ...errors, [`editEdgeType_${id}`]: error });\n        return;\n      }\n    }\n\n    setEdgeTypes(edgeTypes.map(type => \n      type.id === id ? { ...type, ...updates } : type\n    ));\n    setEditingEdgeType(null);\n    setErrors({ ...errors, [`editEdgeType_${id}`]: null });\n  };\n\n  const handleDeleteNodeType = (id) => {\n    setNodeTypes(nodeTypes.filter(type => type.id !== id));\n  };\n\n  const handleDeleteEdgeType = (id) => {\n    setEdgeTypes(edgeTypes.filter(type => type.id !== id));\n  };\n\n  const handleSave = () => {\n    onSave({\n      nodeTypes,\n      edgeTypes\n    });\n    onClose();\n  };\n\n  const handleKeyDown = (e) => {\n    if (e.key === 'Escape') {\n      onClose();\n    }\n  };\n\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"type-settings-modal-overlay\" onClick={onClose}>\n      <div \n        className=\"type-settings-modal\" \n        onClick={(e) => e.stopPropagation()}\n        onKeyDown={handleKeyDown}\n      >\n        <div className=\"modal-header\">\n          <h2>\n            <Settings size={24} strokeWidth={2} />\n            타입 설정\n          </h2>\n          <button \n            className=\"modal-close-btn\"\n            onClick={onClose}\n            type=\"button\"\n          >\n            <X size={20} strokeWidth={2} />\n          </button>\n        </div>\n        \n        <div className=\"modal-body\">\n          {/* Node types section */}\n          <div className=\"type-section\">\n            <h3>노드 타입</h3>\n            <div className=\"add-type-form\">\n              <input\n                type=\"text\"\n                value={newNodeType}\n                onChange={(e) => {\n                  setNewNodeType(e.target.value);\n                  if (errors.newNodeType) {\n                    setErrors({ ...errors, newNodeType: null });\n                  }\n                }}\n                placeholder=\"새 노드 타입 ID (예: organization)\"\n                className={`add-type-input ${errors.newNodeType ? 'error' : ''}`}\n                onKeyDown={(e) => e.key === 'Enter' && handleAddNodeType()}\n              />\n              <button \n                onClick={handleAddNodeType}\n                className=\"add-type-btn\"\n                type=\"button\"\n              >\n                <Plus size={16} strokeWidth={2} />\n                추가\n              </button>\n            </div>\n            {errors.newNodeType && (\n              <div className=\"error-message\">{errors.newNodeType}</div>\n            )}\n            \n            <div className=\"type-list\">\n              {nodeTypes.map((type) => (\n                <div key={type.id} className=\"type-item\">\n                  <div \n                    className=\"color-indicator\"\n                    style={{ backgroundColor: type.color }}\n                  ></div>\n                  \n                  {editingNodeType === type.id ? (\n                    <EditNodeTypeForm\n                      type={type}\n                      onSave={(updates) => handleUpdateNodeType(type.id, updates)}\n                      onCancel={() => setEditingNodeType(null)}\n                      error={errors[`editNodeType_${type.id}`]}\n                    />\n                  ) : (\n                    <>\n                      <div className=\"type-info\">\n                        <span className=\"type-id\">{type.id}</span>\n                        <span className=\"type-label\">{type.label}</span>\n                      </div>\n                      \n                      <div className=\"type-actions\">\n                        <button \n                          onClick={() => setEditingNodeType(type.id)}\n                          className=\"edit-btn\"\n                          title=\"편집\"\n                        >\n                          <Edit2 size={14} strokeWidth={2} />\n                        </button>\n                        <button \n                          onClick={() => handleDeleteNodeType(type.id)}\n                          className=\"delete-btn\"\n                          title=\"삭제\"\n                        >\n                          <Trash2 size={14} strokeWidth={2} />\n                        </button>\n                      </div>\n                    </>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Edge types section */}\n          <div className=\"type-section\">\n            <h3>엣지 타입</h3>\n            <div className=\"add-type-form\">\n              <input\n                type=\"text\"\n                value={newEdgeType}\n                onChange={(e) => {\n                  setNewEdgeType(e.target.value);\n                  if (errors.newEdgeType) {\n                    setErrors({ ...errors, newEdgeType: null });\n                  }\n                }}\n                placeholder=\"새 엣지 타입 ID (예: manages)\"\n                className={`add-type-input ${errors.newEdgeType ? 'error' : ''}`}\n                onKeyDown={(e) => e.key === 'Enter' && handleAddEdgeType()}\n              />\n              <button \n                onClick={handleAddEdgeType}\n                className=\"add-type-btn\"\n                type=\"button\"\n              >\n                <Plus size={16} strokeWidth={2} />\n                추가\n              </button>\n            </div>\n            {errors.newEdgeType && (\n              <div className=\"error-message\">{errors.newEdgeType}</div>\n            )}\n            \n            <div className=\"type-list\">\n              {edgeTypes.map((type) => (\n                <div key={type.id} className=\"type-item edge-type\">\n                  {editingEdgeType === type.id ? (\n                    <EditEdgeTypeForm\n                      type={type}\n                      onSave={(updates) => handleUpdateEdgeType(type.id, updates)}\n                      onCancel={() => setEditingEdgeType(null)}\n                      error={errors[`editEdgeType_${type.id}`]}\n                    />\n                  ) : (\n                    <>\n                      <div className=\"type-info\">\n                        <span className=\"type-id\">{type.id}</span>\n                        <span className=\"type-label\">{type.label}</span>\n                      </div>\n                      \n                      <div className=\"type-actions\">\n                        <button \n                          onClick={() => setEditingEdgeType(type.id)}\n                          className=\"edit-btn\"\n                          title=\"편집\"\n                        >\n                          <Edit2 size={14} strokeWidth={2} />\n                        </button>\n                        <button \n                          onClick={() => handleDeleteEdgeType(type.id)}\n                          className=\"delete-btn\"\n                          title=\"삭제\"\n                        >\n                          <Trash2 size={14} strokeWidth={2} />\n                        </button>\n                      </div>\n                    </>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        <div className=\"modal-footer\">\n          <button \n            type=\"button\" \n            className=\"btn-cancel\"\n            onClick={onClose}\n          >\n            취소\n          </button>\n          <button \n            type=\"button\" \n            className=\"btn-save\"\n            onClick={handleSave}\n          >\n            저장\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n\n// Node type edit form component\nconst EditNodeTypeForm = ({ type, onSave, onCancel, error }) => {\n  const [editData, setEditData] = useState({\n    id: type.id,\n    label: type.label,\n    color: type.color\n  });\n\n  const handleSave = () => {\n    onSave(editData);\n  };\n\n  return (\n    <div className=\"edit-form\">\n      <div className=\"edit-inputs\">\n        <input\n          type=\"text\"\n          value={editData.id}\n          onChange={(e) => setEditData({ ...editData, id: e.target.value })}\n          placeholder=\"ID\"\n          className={`edit-input ${error ? 'error' : ''}`}\n        />\n        <input\n          type=\"text\"\n          value={editData.label}\n          onChange={(e) => setEditData({ ...editData, label: e.target.value })}\n          placeholder=\"라벨\"\n          className=\"edit-input\"\n        />\n        <input\n          type=\"color\"\n          value={editData.color}\n          onChange={(e) => setEditData({ ...editData, color: e.target.value })}\n          className=\"edit-color-input\"\n        />\n      </div>\n      {error && <div className=\"error-message\">{error}</div>}\n      <div className=\"edit-actions\">\n        <button onClick={handleSave} className=\"save-btn\">\n          <Save size={12} strokeWidth={2} />\n        </button>\n        <button onClick={onCancel} className=\"cancel-btn\">\n          <X size={12} strokeWidth={2} />\n        </button>\n      </div>\n    </div>\n  );\n};\n\n// Edge type edit form component\nconst EditEdgeTypeForm = ({ type, onSave, onCancel, error }) => {\n  const [editData, setEditData] = useState({\n    id: type.id,\n    label: type.label\n  });\n\n  const handleSave = () => {\n    onSave(editData);\n  };\n\n  return (\n    <div className=\"edit-form\">\n      <div className=\"edit-inputs\">\n        <input\n          type=\"text\"\n          value={editData.id}\n          onChange={(e) => setEditData({ ...editData, id: e.target.value })}\n          placeholder=\"ID\"\n          className={`edit-input ${error ? 'error' : ''}`}\n        />\n        <input\n          type=\"text\"\n          value={editData.label}\n          onChange={(e) => setEditData({ ...editData, label: e.target.value })}\n          placeholder=\"라벨\"\n          className=\"edit-input\"\n        />\n      </div>\n      {error && <div className=\"error-message\">{error}</div>}\n      <div className=\"edit-actions\">\n        <button onClick={handleSave} className=\"save-btn\">\n          <Save size={12} strokeWidth={2} />\n        </button>\n        <button onClick={onCancel} className=\"cancel-btn\">\n          <X size={12} strokeWidth={2} />\n        </button>\n      </div>\n    </div>\n  );\n};\n\nexport default TypeSettingsModal;