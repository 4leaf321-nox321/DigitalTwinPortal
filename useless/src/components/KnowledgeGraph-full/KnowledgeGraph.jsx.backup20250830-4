import React, { useEffect, useRef, useState } from 'react';
import { Network } from 'vis-network/standalone/esm/vis-network';
import { DataSet } from 'vis-data/esnext';
import Controls from './Controls';
import { getNodeColorByType, getNodeStyle, getEdgeColorByType } from '../../utils/colorUtils';
import { useKnowledgeGraphEvents, setupNetworkEventListeners } from './hooks/useKnowledgeGraphEvents';
import { useMultiSelection } from './hooks/useMultiSelection';
import { useBoxSelection } from './hooks/useBoxSelection';
import { getNetworkOptions } from './utils/networkOptions';
import { applyGridLayout, applyCircularLayout, updateCursor, updateHighlights } from './utils/layoutUtils';
import './KnowledgeGraph.css';

const KnowledgeGraph = ({
  data,
  selectedNode,
  selectedEdge,
  highlightedNodes,
  highlightedEdges,
  layoutType,
  onNodeClick,
  onEdgeClick,
  onNodeAdd,
  onEdgeAdd,
  onNodeDelete,
  onMultipleNodesDelete,
  onEdgeDelete,
  nodeTypes = [],
  edgeTypes = [],
  // 모달 함수들 추가
  askWarningConfirm
}) => {
  const containerRef = useRef(null);
  const networkRef = useRef(null);
  const nodesRef = useRef(null);
  const edgesRef = useRef(null);
  
  // 상태를 ref로도 관리하여 이벤트 리스너에서 최신 값 참조
  const isAddingNodeRef = useRef(false);
  const isAddingEdgeRef = useRef(false);
  const sourceNodeForEdgeRef = useRef(null);
  
  const [isAddingNode, setIsAddingNode] = useState(false);
  const [isAddingEdge, setIsAddingEdge] = useState(false);
  const [tempNode, setTempNode] = useState(null);
  const [sourceNodeForEdge, setSourceNodeForEdge] = useState(null);
  const [isFitActive, setIsFitActive] = useState(false);

  // 다중 선택 기능 훅
  const {
    selectedNodes,
    selectedNodesRef,
    toggleNodeSelection,
    clearNodeSelection,
    deleteSelectedNodes,
    updateSelectedNodes
  } = useMultiSelection({ 
    data, 
    onNodeClick, 
    onNodeDelete, 
    onMultipleNodesDelete,
    askWarningConfirm 
  });

  // 박스 선택 기능 훅
  const {
    isBoxSelecting,
    boxStart,
    boxEnd,
    isCtrlPressed
  } = useBoxSelection({ 
    containerRef, 
    networkRef, 
    updateSelectedNodes, 
    onNodeClick 
  });

  // 상태 업데이트 함수들 - ref와 동기화
  const updateIsAddingNode = (value) => {
    setIsAddingNode(value);
    isAddingNodeRef.current = value;
  };

  const updateIsAddingEdge = (value) => {
    setIsAddingEdge(value);
    isAddingEdgeRef.current = value;
  };

  const updateSourceNodeForEdge = (value) => {
    setSourceNodeForEdge(value);
    sourceNodeForEdgeRef.current = value;
  };

  // 컨트롤 함수들
  const handleFitToView = () => {
    if (networkRef.current) {
      setIsFitActive(true);
      networkRef.current.fit({
        animation: {
          duration: 1000,
          easingFunction: 'easeInOutQuart'
        }
      });
      setTimeout(() => setIsFitActive(false), 1000);
    }
  };

  const handleZoomIn = () => {
    if (networkRef.current) {
      const scale = networkRef.current.getScale();
      networkRef.current.moveTo({ scale: scale * 1.2 });
    }
  };

  const handleZoomOut = () => {
    if (networkRef.current) {
      const scale = networkRef.current.getScale();
      networkRef.current.moveTo({ scale: scale * 0.8 });
    }
  };

  const togglePhysics = () => {
    if (networkRef.current) {
      const options = networkRef.current.physics.options;
      const newPhysicsState = !options.enabled;
      
      if (layoutType === 'force-directed') {
        networkRef.current.setOptions({
          physics: { 
            enabled: newPhysicsState,
            stabilization: { 
              enabled: newPhysicsState,
              iterations: newPhysicsState ? 100 : 0
            }
          }
        });
        
        if (newPhysicsState) {
          networkRef.current.physics.startSimulation();
          setTimeout(() => {
            if (networkRef.current && networkRef.current.physics) {
              networkRef.current.setOptions({
                physics: { enabled: false }
              });
            }
          }, 3000);
        }
      } else {
        networkRef.current.setOptions({
          physics: { enabled: newPhysicsState }
        });

        if (newPhysicsState) {
          networkRef.current.physics.startSimulation();
        } else {
          networkRef.current.physics.stopSimulation();
        }
      }
    }
  };

  const reapplyLayout = () => {
    if (!networkRef.current) return;
    
    const resetNodes = data.nodes.map(node => {
      const style = getNodeStyle(node.type, nodeTypes);
      return {
        ...node,
        ...style,
        physics: true,
        fixed: false,
        x: undefined,
        y: undefined
      };
    });
    
    nodesRef.current.update(resetNodes);
    networkRef.current.physics.startSimulation();
  };

  // 노드/엣지 추가 핸들러
  const handleAddNodeClick = (params) => {
    const nodeStyle = getNodeStyle('default', nodeTypes);
    const newNode = {
      id: `node_${Date.now()}`,
      label: '새 노드',
      type: 'default',
      properties: {},
      ...nodeStyle,
      size: 25,
      x: params.pointer.canvas.x,
      y: params.pointer.canvas.y,
      physics: false
    };

    onNodeAdd(newNode);
    // 노드 추가 모드를 지속 - ESC나 Enter로만 종료
    // updateIsAddingNode(false); 제거
    setTempNode(null);
  };

  const handleAddEdgeClick = (params) => {
    if (params.nodes.length > 0) {
      const clickedNode = params.nodes[0];
      
      if (!sourceNodeForEdgeRef.current) {
        updateSourceNodeForEdge(clickedNode);
      } else if (sourceNodeForEdgeRef.current !== clickedNode) {
        // 기본 엣지 타입과 레이블 설정
        const defaultEdgeType = edgeTypes.length > 0 
          ? edgeTypes.find(t => t.id === 'unknown') || edgeTypes[0]
          : { id: 'unknown', label: '알 수 없음' };
        
        const newEdge = {
          id: `edge_${Date.now()}`,
          from: sourceNodeForEdgeRef.current,
          to: clickedNode,
          label: defaultEdgeType.label,
          type: defaultEdgeType.id,
          properties: {},
          color: getEdgeColorByType(defaultEdgeType.id, edgeTypes),
          width: 2
        };

        onEdgeAdd(newEdge);
        updateIsAddingEdge(false);
        updateSourceNodeForEdge(null);
      }
    }
  };

  // 키보드 이벤트 훅 사용 (다중 선택 기능 포함)
  useKnowledgeGraphEvents({
    selectedNode,
    selectedEdge,
    selectedNodes,
    data,
    onNodeDelete,
    onEdgeDelete,
    deleteSelectedNodes,
    clearNodeSelection,
    isAddingNodeRef,
    isAddingEdgeRef,
    updateIsAddingNode,
    updateIsAddingEdge,
    updateSourceNodeForEdge,
    setTempNode,
    handleFitToView,
    askWarningConfirm
  });

  // 다중 선택 시각적 업데이트
  useEffect(() => {
    if (!nodesRef.current) return;
    
    // 모든 노드의 선택 상태 업데이트
    const updatedNodes = data.nodes.map(node => {
      const style = getNodeStyle(node.type, nodeTypes);
      const isSelected = selectedNodes.has(node.id);
      
      return {
        ...node,
        ...style,
        size: node.size || 25,
        borderWidth: isSelected ? 6 : (style.borderWidth || 2), // 더 두꺼운 테두리
        borderColor: isSelected ? '#e74c3c' : style.borderColor, // 더 진한 빨간색
        shadow: isSelected ? {
          enabled: true,
          color: '#e74c3c',
          size: 15, // 더 큰 그림자
          x: 0,
          y: 0
        } : style.shadow,
        // 추가 시각적 효과
        font: isSelected ? {
          ...style.font,
          color: '#ffffff', // 선택된 노드의 텍스트를 흰색으로
          strokeWidth: 2,
          strokeColor: '#e74c3c'
        } : style.font
      };
    });
    
    nodesRef.current.update(updatedNodes);
  }, [selectedNodes, data, nodeTypes]);

  // 네트워크 초기화
  useEffect(() => {
    if (!containerRef.current || !data) return;

    // 노드에 스타일 적용
    const styledNodes = data.nodes.map(node => {
      const style = getNodeStyle(node.type, nodeTypes);
      return {
        ...node,
        ...style,
        size: node.size || 25
      };
    });

    // 데이터셋 생성
    nodesRef.current = new DataSet(styledNodes);
    edgesRef.current = new DataSet(data.edges);

    // 네트워크 옵션 설정
    const options = getNetworkOptions(layoutType);

    // 네트워크 생성
    networkRef.current = new Network(
      containerRef.current,
      {
        nodes: nodesRef.current,
        edges: edgesRef.current
      },
      options
    );

    // 이벤트 리스너 등록
    setupNetworkEventListeners({
      networkRef,
      nodesRef, // nodesRef 추가
      isAddingNodeRef,
      isAddingEdgeRef,
      handleAddNodeClick,
      handleAddEdgeClick,
      onNodeClick: (nodeId, event) => {
        if (nodeId) {
          toggleNodeSelection(nodeId, event?.ctrlKey || event?.metaKey);
        } else {
          clearNodeSelection();
        }
      },
      onEdgeClick,
      updateIsAddingNode,
      updateCursor: () => updateCursor(networkRef, isAddingNode, isAddingEdge),
      layoutType
    });

    return () => {
      if (networkRef.current) {
        networkRef.current.destroy();
        networkRef.current = null;
      }
    };
  }, []);

  // 이벤트 리스너 설정 (상태변화에 따른 업데이트)
  useEffect(() => {
    if (!networkRef.current) return;
    
    // 기존 리스너 제거 후 재등록
    networkRef.current.off('click');
    networkRef.current.off('doubleClick');
    
    setupNetworkEventListeners({
      networkRef,
      nodesRef, // nodesRef 추가
      isAddingNodeRef,
      isAddingEdgeRef,
      handleAddNodeClick,
      handleAddEdgeClick,
      onNodeClick: (nodeId, event) => {
        if (nodeId) {
          toggleNodeSelection(nodeId, event?.ctrlKey || event?.metaKey);
        } else {
          clearNodeSelection();
        }
      },
      onEdgeClick,
      updateIsAddingNode,
      updateCursor: () => updateCursor(networkRef, isAddingNode, isAddingEdge),
      layoutType
    });
  }, [isAddingNode, isAddingEdge, selectedNodes]);

  // 데이터 업데이트
  useEffect(() => {
    if (!nodesRef.current || !edgesRef.current || !data) return;

    // 노드에 스타일 적용
    const styledNodes = data.nodes.map(node => {
      const style = getNodeStyle(node.type, nodeTypes);
      return {
        ...node,
        ...style,
        size: node.size || 25
      };
    });

    nodesRef.current.clear();
    edgesRef.current.clear();
    nodesRef.current.add(styledNodes);
    edgesRef.current.add(data.edges);
  }, [data, nodeTypes]);

  // 레이아웃 변경
  useEffect(() => {
    if (!networkRef.current || !nodesRef.current) return;

    // 노드의 physics 속성을 초기화
    const resetNodes = data.nodes.map(node => {
      const style = getNodeStyle(node.type, nodeTypes);
      return {
        ...node,
        ...style,
        size: node.size || 25,
        physics: true,
        fixed: false,
        x: undefined,
        y: undefined
      };
    });
    
    nodesRef.current.update(resetNodes);

    // 레이아웃 옵션 설정
    const options = getNetworkOptions(layoutType);
    networkRef.current.setOptions(options);

    // 물리 시뮬레이션 재시작
    networkRef.current.physics.startSimulation();

    // 레이아웃별 추가 처리
    setTimeout(() => {
      if (layoutType === 'grid') {
        applyGridLayout(networkRef, nodesRef);
      } else if (layoutType === 'circular') {
        applyCircularLayout(networkRef, nodesRef);
      }
    }, 100);

  }, [layoutType, data, nodeTypes]);

  // 하이라이트 노드/엣지 업데이트
  useEffect(() => {
    updateHighlights({
      data,
      nodesRef,
      edgesRef,
      networkRef,
      highlightedNodes,
      highlightedEdges,
      selectedNode,
      selectedEdge,
      nodeTypes
    });
  }, [highlightedNodes, highlightedEdges, selectedNode, selectedEdge]);

  // 노드/엣지 추가 모드에서 커서 스타일 업데이트
  useEffect(() => {
    updateCursor(networkRef, isAddingNode, isAddingEdge);
  }, [isAddingNode, isAddingEdge]);

  return (
    <div className="knowledge-graph">
      <div 
        className={`graph-container ${
          isAddingNode ? 'node-add-mode' : ''
        } ${
          isCtrlPressed ? 'ctrl-pressed' : ''
        } ${
          isBoxSelecting ? 'box-selecting' : ''
        }`} 
        ref={containerRef}
        style={{ position: 'relative' }}
      />
      
      {/* 박스 선택 시각화 */}
      {isBoxSelecting && boxStart && boxEnd && (
        <div
          className="selection-box"
          style={{
            position: 'absolute',
            left: Math.min(boxStart.x, boxEnd.x),
            top: Math.min(boxStart.y, boxEnd.y),
            width: Math.abs(boxEnd.x - boxStart.x),
            height: Math.abs(boxEnd.y - boxStart.y),
            border: '3px dashed #e74c3c',
            backgroundColor: 'rgba(231, 76, 60, 0.15)',
            pointerEvents: 'none',
            zIndex: 1000
          }}
        />
      )}
      
      {/* 박스 선택 상태 표시 */}
      {isCtrlPressed && !isBoxSelecting && (
        <div className="box-select-ready-indicator">
          드래그하여 여러 노드를 선택하세요
        </div>
      )}
      
      {/* 박스 선택 진행 중 표시 */}
      {isBoxSelecting && (
        <div className="box-select-progress-indicator">
          마우스를 떼어 선택을 완료하세요
        </div>
      )}
      
      <Controls
        onFitToView={handleFitToView}
        onZoomIn={handleZoomIn}
        onZoomOut={handleZoomOut}
        onTogglePhysics={togglePhysics}
        onReapplyLayout={reapplyLayout}
        isAddingNode={isAddingNode}
        isAddingEdge={isAddingEdge}
        onToggleAddNode={() => {
          updateIsAddingNode(!isAddingNode);
          updateIsAddingEdge(false);
          updateSourceNodeForEdge(null);
        }}
        onToggleAddEdge={() => {
          updateIsAddingEdge(!isAddingEdge);
          updateIsAddingNode(false);
          updateSourceNodeForEdge(null);
        }}
        sourceNodeForEdge={sourceNodeForEdge}
        currentLayout={layoutType}
        isFitActive={isFitActive}
      />

      {/* 다중 선택 상태 표시 */}
      {selectedNodes.size > 1 && (
        <div className="multi-select-status">
          <div className="status-message">
            <strong>{selectedNodes.size}개 노드 선택됨</strong>
          </div>
          <button 
          className="delete-selected-btn"
          onClick={deleteSelectedNodes}
          title="선택된 노드들 삭제"
          >
          🗑️ 선택 삭제 ({selectedNodes.size}개)
          </button>
        </div>
      )}

      {/* 상태 표시 */}
      {isAddingNode && (
        <div className="status-indicator node-add-mode">
          <div className="status-message">
            <strong>노드 추가 모드</strong><br/>
            그래프의 빈 공간을 더블클릭하여 노드를 추가하세요<br/>
            <em>클릭할 때마다 노드가 계속 추가됩니다</em>
          </div>
          <div className="status-hint">
            (<kbd>ESC</kbd> 또는 <kbd>Enter</kbd> 키를 눌러 종료할 수 있습니다)
          </div>
        </div>
      )}
      
      {isAddingEdge && (
        <div className="status-indicator">
          {!sourceNodeForEdge 
            ? '시작 노드를 클릭하세요' 
            : '끝 노드를 클릭하여 연결하세요'
          }
        </div>
      )}
      
      {/* 삭제 및 다중 선택 힌트 */}
      {!isAddingNode && !isAddingEdge && (
        <div className="control-hints">
          {selectedNodes.size > 0 ? (
            <div className="delete-hint selected-nodes">
              <kbd>Delete</kbd> 키를 눌러 선택된 <strong>{selectedNodes.size}개 노드</strong>를 삭제할 수 있습니다
            </div>
          ) : (selectedNode || selectedEdge) ? (
            <div className="delete-hint">
              <kbd>Delete</kbd> 키를 눌러 {selectedNode ? '노드' : '관계'}를 삭제할 수 있습니다
            </div>
          ) : null}
          
          <div className="multi-select-hint">
            <kbd>Ctrl</kbd> + 클릭으로 여러 노드 선택 | <kbd>Ctrl</kbd> + 드래그로 박스 선택
          </div>
        </div>
      )}
    </div>
  );
};

export default KnowledgeGraph;