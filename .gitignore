# Python
venv/
env/
.venv/
backend/venv/
mcp_server/venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
cover/
coverage.xml
.cache
pip-wheel-metadata/

# Node
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json is intentionally tracked: CI uses `npm ci`, which
# requires a committed lockfile for reproducible installs.
pnpm-lock.yaml

# Vite / build outputs
frontend/dist/
frontend/build/
dist/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDEs / 도구
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
# 에이전트 설정. 사람마다 다르고, 지금 들어 있는 것은 이 PC 의 절대경로와
# 일회성 명령뿐이라 공유할 값이 없다. 팀 공용으로 둘 것이 생기면 그때 푼다.
.claude/

# Env
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary
*.tmp
*.swp
# 압축·배포 작업 중에 손으로 만든 목록. 남길 이유가 없다.
zip_paths*.txt

# Archives (do not commit ZIP archives or deploy packages)
*.zip
# 확장자가 한 글자 어긋난 것까지. deploy.zip1 이 *.zip 을 그냥 빠져나갔다.
*.zip[0-9]
# Anchored to the repo root: the build output is /deploy, and an unanchored
# "deploy/" also swallowed the scripts/deploy source directory.
/deploy/
/deploy/*.zip
deploy_package.zip

# Runtime data written by the running app on the server. Deploys run
# `git reset --hard`, which force-overwrites tracked files, so uploads must
# stay untracked to survive a deploy.
backend/uploads/

# End of .gitignore
