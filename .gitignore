## Project ignore

# Python
venv/
env/
.venv/
backend/venv/
mcp_server/venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
cover/
coverage.xml
.cache
pip-wheel-metadata/

# Node
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json is intentionally tracked: CI uses `npm ci`, which
# requires a committed lockfile for reproducible installs.
pnpm-lock.yaml

# Vite / build outputs
frontend/dist/
frontend/build/
dist/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Env
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary
*.tmp
*.swp

# Archives (do not commit ZIP archives or deploy packages)
*.zip
# Anchored to the repo root: the build output is /deploy, and an unanchored
# "deploy/" also swallowed the scripts/deploy source directory.
/deploy/
/deploy/*.zip
deploy_package.zip

# Runtime data written by the running app on the server. Deploys run
# `git reset --hard`, which force-overwrites tracked files, so uploads must
# stay untracked to survive a deploy.
backend/uploads/

# End of .gitignore
